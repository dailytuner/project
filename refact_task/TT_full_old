# builders/psych_profile_builder.py

class PsychProfileBuilder:
    """
    Строит психологический профиль из MMPI и IAT.
    """
    
    async def build_profile(
        self,
        user_id: int,
        date: date
    ) -> PsychProfile:
        """
        Загружает психологический профиль из БД.
        """
        async with async_session() as session:
            # 1. Загружаем MMPI на дату
            mmpi = await self._get_mmpi_at_date(session, user_id, date)
            
            # 2. Загружаем IAT на дату
            iat = await self._get_iat_at_date(session, user_id, date)
            
            # 3. Формируем профиль
            return PsychProfile(
                user_id=user_id,
                date=date,
                mmpi={
                    'd_score': mmpi.d_score if mmpi else None,
                    'pt_score': mmpi.pt_score if mmpi else None,
                    'pa_score': mmpi.pa_score if mmpi else None,
                    'sc_score': mmpi.sc_score if mmpi else None,
                    'pd_score': mmpi.pd_score if mmpi else None,
                    'ma_score': mmpi.ma_score if mmpi else None,
                    'hs_score': mmpi.hs_score if mmpi else None,
                    'hy_score': mmpi.hy_score if mmpi else None,
                    'si_score': mmpi.si_score if mmpi else None,
                    'mf_score': mmpi.mf_score if mmpi else None,
                },
                iat={
                    'd_score': iat.d_score if iat else None,
                    'mean_rt_ms': iat.mean_rt_ms if iat else None,
                }
            )
    
    async def _get_mmpi_at_date(self, session, user_id: int, date: date):
        """Получает MMPI на указанную дату."""
        stmt = select(MMPIResult).where(
            MMPIResult.user_id == user_id,
            func.date(MMPIResult.taken_at) == date
        ).order_by(MMPIResult.taken_at.desc()).limit(1)
        result = await session.execute(stmt)
        return result.scalar_one_or_none()
