        7: 'decreasing',   # отношения → спад
        8: 'increasing',   # трансформация → рост
        9: 'increasing',   # вера → рост
        12: 'increasing',  # изоляция → рост
    }
    
    # Ожидаемый эффект Юпитера в доме
    JUPITER_EFFECT = {
        1: 'increasing',
        4: 'increasing',
        5: 'increasing',
        6: 'decreasing',
        7: 'increasing',
        8: 'increasing',
        9: 'increasing',
        12: 'decreasing',
    }
    
    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}
        self.house_psych_map = self.config.get('house_psych_map', self.HOUSE_PSYCH_MAP)
        self.saturn_effect = self.config.get('saturn_effect', self.SATURN_EFFECT)
        self.jupiter_effect = self.config.get('jupiter_effect', self.JUPITER_EFFECT)
    
    def align(
        self,
        saturn_house: int,
        jupiter_house: int,
        psych_scores: Dict[str, float]
    ) -> List[Dict]:
        """
        Сопоставляет дома Сатурна и Юпитера с психологией.
        """
        alignments = []
        
        # 1. Сатурн
        if saturn_house in self.house_psych_map:
            mapping = self.house_psych_map[saturn_house]
            psych_value = psych_scores.get(mapping['scale'], 50)
            
            expected = self.saturn_effect.get(saturn_house, 'neutral')
            alignment_score = self._score_alignment(psych_value, expected)
            
            alignments.append({
                'type': 'saturn_house',
                'house': saturn_house,
                'psych_scale': mapping['scale'],
                'psych_value': round(psych_value, 1),
                'trait': mapping['trait'],
                'expected_direction': expected,
                'alignment_score': round(alignment_score, 3),
                'interpretation': self._interpret_house(
                    'saturn', saturn_house, psych_value, expected
                )
            })
        
        # 2. Юпитер
        if jupiter_house in self.house_psych_map:
            mapping = self.house_psych_map[jupiter_house]
            psych_value = psych_scores.get(mapping['scale'], 50)
            
            expected = self.jupiter_effect.get(jupiter_house, 'neutral')
            alignment_score = self._score_alignment(psych_value, expected)
            
            alignments.append({
                'type': 'jupiter_house',
                'house': jupiter_house,
                'psych_scale': mapping['scale'],
                'psych_value': round(psych_value, 1),
                'trait': mapping['trait'],
                'expected_direction': expected,
                'alignment_score': round(alignment_score, 3),
                'interpretation': self._interpret_house(
                    'jupiter', jupiter_house, psych_value, expected
                )
            })
        
        return alignments
    
    def _score_alignment(self, psych_value: float, expected: str) -> float:
        """
        Оценивает, насколько психологическое значение соответствует ожидаемому.
        """
        # T-scores: 50 - среднее, >65 - высокое, <35 - низкое
        if psych_value > 65:
            actual = 'high'
        elif psych_value < 35:
            actual = 'low'
        else:
            actual = 'normal'
        
        if expected == 'increasing':
            if actual == 'high':
                return 0.9
            elif actual == 'normal':
                return 0.6
            else:
                return 0.2
        elif expected == 'decreasing':
            if actual == 'low':
                return 0.9
            elif actual == 'normal':
                return 0.6
            else:
                return 0.2
        else:
            return 0.5  # нейтрально
    
    def _interpret_house(
        self,
        planet: str,
        house: int,
        psych_value: float,
        expected: str
    ) -> str:
        """
        Генерирует интерпретацию для дома.
