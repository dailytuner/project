# profile/priorities.py
def calculate_priorities(horizon_days: int) -> Dict[str, Any]:
    """
    Вычисляет веса систем на основе горизонта прогноза.
    Использует взвешивание, а не жесткое переключение.
    
    Args:
        horizon_days: Горизонт прогноза в днях
    
    Returns:
        dict: Веса и приоритеты систем
    """
    # Базовые веса (экспертные)
    system_weights = {
        "western": 1.0,
        "vedic": 1.0,
        "arabic": 1.0,
        "chinese": 0.7,
        "maya": 0.6,
        "mesopotamian": 0.7,
        "transits": 1.0
    }
    
    # Временные множители (зависят от горизонта)
    time_multipliers = {
        "western": 1.0 / (1 + horizon_days / 30),
        "vedic": 1.0 / (1 + 30 / horizon_days) if horizon_days > 0 else 0.5,
        "arabic": 1.0 / (1 + abs(horizon_days - 90) / 90),
        "chinese": 0.5 + 0.5 / (1 + horizon_days / 365),
        "maya": 0.5 + 0.5 / (1 + horizon_days / 260),
        "mesopotamian": 0.5 + 0.5 / (1 + horizon_days / 30),
        "transits": 1.0 / (1 + horizon_days / 14)
    }
    
    # Итоговые веса
    final_weights = {}
    for system in system_weights:
        final_weights[system] = system_weights[system] * time_multipliers[system]
    
    # Нормализация
    total = sum(final_weights.values())
    for system in final_weights:
        final_weights[system] /= total
    
    # Сортировка
    sorted_systems = sorted(final_weights.items(), key=lambda x: -x[1])
    
    return {
        "weights": final_weights,
        "primary": sorted_systems[0][0],
        "secondary": sorted_systems[1][0] if len(sorted_systems) > 1 else None,
        "all": sorted_systems
    }
