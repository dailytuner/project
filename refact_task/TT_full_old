class HouseAligner(BaseAligner):
    """
    Сопоставляет Сатурн/Юпитер в домах с психологическими шкалами.
    """
    
    @property
    def type_name(self) -> str:
        return 'house'
    
    # Карта: дом → (шкала MMPI, название, тип ожидания)
    HOUSE_MAPPING = {
        1: {'scale': 'pd_score', 'name': 'self_identity', 'expected': 'high'},
        4: {'scale': 'd_score', 'name': 'emotional_base', 'expected': 'high'},
        5: {'scale': 'ma_score', 'name': 'creativity', 'expected': 'high'},
        6: {'scale': 'pt_score', 'name': 'anxiety', 'expected': 'high'},
        7: {'scale': 'mf_score', 'name': 'relationships', 'expected': 'variable'},
        8: {'scale': 'sc_score', 'name': 'transformation', 'expected': 'high'},
        9: {'scale': 'pa_score', 'name': 'belief', 'expected': 'high'},
        12: {'scale': 'si_score', 'name': 'isolation', 'expected': 'high'},
    }
    
    async def align(
        self,
        astro: 'AstroProfile',
        psych: 'PsychProfile',
        knowledge_base: List['KnowledgeBaseEntry']
    ) -> List[Alignment]:
        """
        Сопоставляет дома Сатурна и Юпитера с психологией.
        """
        alignments = []
        
        # 1. Сатурн в доме
        saturn_house = astro.transits.get('saturn_house')
        if saturn_house and saturn_house in self.HOUSE_MAPPING:
            mapping = self.HOUSE_MAPPING[saturn_house]
            alignment = await self._align_single(
                factor=f'saturn_house_{saturn_house}',
                psych_scale=mapping['scale'],
                expected=mapping['expected'],
                psych_value=psych.mmpi.get(mapping['scale']),
                knowledge_base=knowledge_base
            )
            alignments.append(alignment)
        
        # 2. Юпитер в доме
        jupiter_house = astro.transits.get('jupiter_house')
        if jupiter_house and jupiter_house in self.HOUSE_MAPPING:
            mapping = self.HOUSE_MAPPING[jupiter_house]
            alignment = await self._align_single(
                factor=f'jupiter_house_{jupiter_house}',
                psych_scale=mapping['scale'],
                expected=mapping['expected'],
                psych_value=psych.mmpi.get(mapping['scale']),
                knowledge_base=knowledge_base
            )
            alignments.append(alignment)
        
        return alignments
    
    def _align_single(
        self,
        factor: str,
        psych_scale: str,
        expected: str,
        psych_value: Optional[float],
        knowledge_base: List['KnowledgeBaseEntry']
    ) -> Alignment:
        """
        Сопоставляет один фактор с психологической шкалой.
        """
        # 1. Нормализуем психологическое значение
        # T-score: 35-65 = норма, >65 = высокий, <35 = низкий
        if psych_value is None:
            actual = None
            alignment_score = 0.5
        elif psych_value > 65:
            actual = 'high'
        elif psych_value < 35:
            actual = 'low'
        else:
            actual = 'normal'
        
        # 2. Находим запись в базе знаний
        kb_entry = next(
            (k for k in knowledge_base if k.factor_name == factor),
            None
        )
        
        # 3. Оцениваем когерентность
        if actual and expected == actual:
            alignment_score = 0.8 + 0.2 * (kb_entry.confidence if kb_entry else 0.5)
        elif actual == 'normal':
            alignment_score = 0.5
        else:
            alignment_score = 0.2 + 0.2 * (kb_entry.confidence if kb_entry else 0.5)
        
        # 4. Формируем результат
        return Alignment(
            type='house',
            factor=factor,
            psych_scale=psych_scale,
            psych_value=psych_value,
            expected=expected,
            actual=actual,
            alignment_score=min(1.0, alignment_score),
            confidence=kb_entry.confidence if kb_entry else 0.5,
            knowledge_base_id=kb_entry.id if kb_entry else None
        )
