    async def calculate(
        self,
        user_id: UUID,
        state: Dict,
        mmpi_scores: Dict[str, float],
        biorhythms: Dict[str, float],
        date: datetime
    ) -> Dict[str, Dict]:
        """
        Рассчитывает индексы по всем категориям.
        """
        indices = {}
        
        for category_id, config in self.categories.items():
            index = self._calculate_category(
                category_id,
                config,
                mmpi_scores,
                biorhythms,
                date
            )
            indices[category_id] = index
        
        return indices
    
    def _calculate_category(
        self,
        category_id: str,
        config: Dict,
        mmpi_scores: Dict[str, float],
        biorhythms: Dict[str, float],
        date: datetime
    ) -> Dict:
        """
        Рассчитывает индекс для одной категории.
        """
        # 1. Ясность
        clarity = self._calculate_clarity(mmpi_scores, config)
        
        # 2. Синхронность
        synchronicity = self._calculate_synchronicity(
            biorhythms, config, date
        )
        
        # 3. Ресурс
        resource = self._calculate_resource(biorhythms, config)
        
        # 4. Инерция
        inertia = self._calculate_inertia(mmpi_scores, config)
        
        # 5. Индекс
        raw_index = (
            clarity * 0.3 +
            synchronicity * 0.3 +
            resource * 0.3 -
            inertia * 0.1
        )
        
        # 6. Сезонный буст
        month = date.month
        seasonal_boost = config.get('seasonal_boost', {}).get(month, 0)
        
        index_value = max(0, min(1, raw_index + seasonal_boost * 0.2))
        
        # 7. Уровень
        if index_value >= 0.75:
            level = 'HIGH'
            recommendation = self._get_recommendation(category_id, 'high')
        elif index_value >= 0.50:
            level = 'MEDIUM'
            recommendation = self._get_recommendation(category_id, 'medium')
        elif index_value >= 0.25:
            level = 'LOW'
            recommendation = self._get_recommendation(category_id, 'low')
        else:
            level = 'CRITICAL'
            recommendation = self._get_recommendation(category_id, 'critical')
        
        return {
            'value': round(index_value, 3),
            'level': level,
            'clarity': round(clarity, 3),
            'synchronicity': round(synchronicity, 3),
            'resource': round(resource, 3),
            'inertia': round(inertia, 3),
            'recommendation': recommendation,
            'seasonal_boost': round(seasonal_boost, 3)
        }
    
    def _calculate_clarity(
        self,
        mmpi_scores: Dict[str, float],
        config: Dict
    ) -> float:
        """Рассчитывает ясность желания."""
        scales = config.get('psych_scales', [])
        if not scales:
            return 0.5
        
        # Нормализуем шкалы
        values = []
        for scale in scales:
            t = mmpi_scores.get(scale, 50)
            # Чем ниже шкала, тем выше ясность (для большинства шкал)
            normalized = 1 - ((t - 30) / 70)
            values.append(max(0, min(1, normalized)))
        
        return sum(values) / len(values)
    
    def _calculate_synchronicity(
        self,
        biorhythms: Dict[str, float],
        config: Dict,
        date: datetime
    ) -> float:
        """Рассчитывает синхронность с Фоном."""
        cycle = config.get('biorhythm', 'emotional')
        bio_value = biorhythms.get(cycle, 0)
        
        # Преобразуем -1..1 в 0..1
        synchronicity = (bio_value + 1) / 2
        
        # Добавляем сезонную составляющую
        month = date.month
        # Сезонная поддержка (упрощённо)
        if month in [3, 4, 5]:  # весна
            synchronicity += 0.05
        elif month in [10, 11, 12]:  # осень-зима
            synchronicity -= 0.05
        
        return max(0, min(1, synchronicity))
    
    def _calculate_resource(
        self,
        biorhythms: Dict[str, float],
        config: Dict
    ) -> float:
        """Рассчитывает ресурсное состояние."""
        cycle = config.get('biorhythm', 'emotional')
        bio_value = biorhythms.get(cycle, 0)
        
        # Ресурс = среднее всех биоритмов с весом целевого
        all_bio = [
            (biorhythms.get('physical', 0) + 1) / 2,
            (biorhythms.get('emotional', 0) + 1) / 2,
            (biorhythms.get('intellectual', 0) + 1) / 2,
        ]
        avg_resource = sum(all_bio) / len(all_bio)
        
        # Усиливаем целевой цикл
        target = (bio_value + 1) / 2
        resource = avg_resource * 0.5 + target * 0.5
        
        return max(0, min(1, resource))
    
    def _calculate_inertia(
        self,
        mmpi_scores: Dict[str, float],
        config: Dict
    ) -> float:
        """Рассчитывает инерцию препятствий."""
        scales = config.get('psych_scales', [])
        if not scales:
            return 0.2
        
        # Чем выше шкалы, тем больше инерция
        values = []
        for scale in scales:
            t = mmpi_scores.get(scale, 50)
            normalized = (t - 30) / 70
            values.append(max(0, min(1, normalized)))
        
        return sum(values) / len(values)
    
    def _get_recommendation(self, category_id: str, level: str) -> str:
