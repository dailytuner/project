class BiorhythmService:
    """
    Сервис для работы с биоритмами.
    """
    
    def __init__(self):
        self.core = BiorhythmCore
    
    async def calculate(
        self,
        user_id: UUID,
        target_date: Optional[date] = None
    ) -> BiorhythmResult:
        """
        Рассчитывает биоритмы для пользователя.
        """
        if target_date is None:
            target_date = date.today()
        
        # 1. Получаем дату рождения пользователя
        birth_date = await self._get_birth_date(user_id)
        
        if not birth_date:
            # Если дата рождения неизвестна — возвращаем нейтральные значения
            return self._neutral_biorhythms(user_id)
        
        # 2. Рассчитываем биоритмы
        biorhythms = self.core.calculate(birth_date, target_date)
        
        # 3. Генерируем интерпретацию
        interpretation = self.core.get_interpretation(biorhythms)
        
        # 4. Сохраняем в БД
        result = await self._save_biorhythms(
            user_id=user_id,
            biorhythms=biorhythms,
            interpretation=interpretation
        )
        
        return result
    
    def _neutral_biorhythms(self, user_id: UUID) -> Dict:
        """
        Возвращает нейтральные биоритмы (когда нет даты рождения).
        """
        return {
            'user_id': user_id,
            'calculated_at': datetime.now(),
            'physical': 0.0,
            'emotional': 0.0,
            'intellectual': 0.0,
