## 6. Бизнес-логика

### 6.1. PsychometryService

```python
class PsychometryService:
    def __init__(self, mmpi_scorer, iat_scorer, astro_client, lake_client,
                 scheduler, outbox_publisher, metrics, audit):
        ...

    async def save_mmpi(self, user_id: int, answers: dict[int, bool]) -> MMPIResult:
        """
        1. Проверка графика (90 дней)
        2. Валидация L/F/K
        3. Расчет T-scores с K-коррекцией
        4. Idempotency Key (детерминированный)
        5. Астро-контекст (fallback)
        6. Сохранение в БД (raw_data_uri = NULL initially)
        7. Загрузка в Data Lake (best effort)
        8. Обновление URI в БД (если успех)
        9. Обновление графика
        10. Outbox
        11. Метрики и аудит (fire-and-forget)
        """
        # 1. График
        if not await self.scheduler.can_take_mmpi(user_id):
            raise TestNotAvailableError("MMPI доступен не раньше следующей даты")

        # 2-3. Расчет
        raw = self.mmpi_scorer.calculate_raw_scores(answers)
        t_scores = self.mmpi_scorer.calculate_t_scores(raw)
        validity = self.mmpi_scorer.validate_response(answers)

        # 4. Idempotency Key (детерминированный, sort_keys)
        idempotency_key = hashlib.sha256(
            json.dumps({"u": user_id, "a": answers}, sort_keys=True).encode()
        ).hexdigest()[:32]

        # 5. Астро
        astro = await self.astro_client.get_context(user_id, datetime.now())

        # 6. Сохранение в БД (uri пока NULL)
        result = await self._save_mmpi_to_db(
            user_id=user_id, t_scores=t_scores, validity=validity,
            astro_context=astro, idempotency_key=idempotency_key
        )

        # 7-8. Data Lake (best effort, не блокируем пользователя)
        taken = result.taken_at
        lake_key = f"psych/mmpi/year={taken.year}/month={taken.month}/user_{user_id}_{taken:%Y%m%d}.parquet"
        try:
            uri = await self.lake_client.upload(lake_key, self._serialize(answers, result.id))
            await self._update_lake_uri(result.id, uri)
        except Exception as e:
            logger.warning("lake_upload_failed", user_id=user_id, error=str(e))
            # uri остается NULL, данные не потеряны (есть в payload outbox)

        # 9. График
        await self.scheduler.update_schedule(user_id, 'mmpi')

        # 10. Outbox
        await self.outbox_publisher.publish(
            event_type='test.completed',
            payload={
                'test_type': 'mmpi', 'user_id': user_id,
                'result_id': result.id, 'taken_at': taken.isoformat(),
                't_scores': t_scores, 'validity': validity,
                'astro_context': astro
            },
            idempotency_key=idempotency_key
        )

        # 11. Метрики и аудит — fire-and-forget, не блокируем ответ
        asyncio.create_task(self.metrics.record_mmpi_taken(user_id, validity['is_valid']))
        asyncio.create_task(self.audit.log_mmpi_completed(user_id, result.id))

        return result
```

### 6.2. OutboxWorker (batch + stale recovery)

```python
class OutboxWorker:
    POLL_INTERVAL = 30
    MAX_RETRY = 5
    STALE_MINUTES = 5

    async def run(self):
        while True:
            try:
                await self._process_batch()
            except Exception as e:
                logger.error(f"Outbox Worker error: {e}")
            await asyncio.sleep(self.POLL_INTERVAL)

    async def _process_batch(self):
        async with async_session() as session:
            # Выбираем pending ИЛИ processing, зависшие более 5 минут
            pending = await session.execute(
                select(Outbox)
                .where(
                    (Outbox.status == 'pending')
                    | (
                        (Outbox.status == 'processing')
                        & (Outbox.processing_started_at < datetime.now() - timedelta(minutes=self.STALE_MINUTES))
                    )
                )
                .order_by(Outbox.created_at)
                .limit(100)
                .with_for_update(skip_locked=True)  # конкурентная безопасность
            )

            events = pending.scalars().all()
            if not events:
                return

            for event in events:
                try:
                    event.status = 'processing'
                    event.processing_started_at = datetime.now()
                except Exception as e:
                    event.retry_count += 1
                    event.last_error = str(e)

                    if event.retry_count >= self.MAX_RETRY:
                        event.status = 'dead_letter'
                        logger.critical("outbox_dead_letter", event_id=event.id, error=str(e))
                    else:
                        event.status = 'pending'
                        event.processing_started_at = None

            await session.commit()  # один commit на батч
```

### 6.3. AstroContextClient (fallback)

```python
class AstroContextClient:
    def __init__(self, base_url: str | None = None, fallback_mode: bool = True):
        self.base_url = base_url
        self.fallback_mode = fallback_mode

    async def get_context(self, user_id: int, at: datetime) -> AstroContext:
        if self.fallback_mode:
            return AstroContext.empty()

        try:
            async with httpx.AsyncClient(timeout=5.0) as client:
                r = await client.get(
                    f"{self.base_url}/internal/v1/users/{user_id}/astro-context",
                    params={"at": at.isoformat()}
                )
                r.raise_for_status()
                return AstroContext(**r.json())
        except Exception as e:
            logger.warning("astro_fallback", error=str(e))
            return AstroContext.empty()
```

