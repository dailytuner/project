    for transit_planet, transit_data in current_core["planets"].items():
        for natal_planet, natal_data in birth_core["planets"].items():
            angle = (transit_data["longitude"] - natal_data["longitude"]) % 360
            for aspect_type, orb in ASPECT_ORBS.items():
                if abs(angle - aspect_type) <= orb:
                    transit_aspects.append({
                        "transit_planet": transit_planet,
                        "natal_planet": natal_planet,
                        "aspect": aspect_type,
                        "orb": abs(angle - aspect_type),
                        "date": current_date,
                        "strength": 1 - (abs(angle - aspect_type) / orb)
                    })
    
    transit_theses = []
    for aspect in transit_aspects:
        sphere = get_planet_sphere(aspect["natal_planet"])
        
        thesis = {
            "id": f"T_{aspect['transit_planet']}_{aspect['natal_planet']}",
            "system": "transits",
            "sphere_vector": sphere["vector"],
            "sign": get_transit_direction(aspect),
            "claim": f"Транзит {aspect['transit_planet']} {aspect['aspect']} натального {aspect['natal_planet']}",
            "window": calculate_window("transit", 
                                      birth_core["planets"][aspect["transit_planet"]]["speed"]),
            "base_confidence": aspect["strength"],
            "level": 2,
            "anchors": [f"Transit_{aspect['transit_planet']}_{aspect['natal_planet']}"]
        }
        transit_theses.append(thesis)
    
    # НЕТ ГЛОБАЛЬНОЙ НОРМАЛИЗАЦИИ
    return transit_theses
