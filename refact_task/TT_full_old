class OutboxPublisher:
    """
    Запись событий в outbox для гарантированной доставки.
    """
    
    async def publish(
        self,
        event_type: str,
        payload: Dict,
        idempotency_key: Optional[str] = None
    ):
        """
        Записывает событие в outbox.
        Не отправляет — это делает Outbox Worker.
        """
        async with async_session() as session:
            outbox = Outbox(
                event_type=event_type,
                payload=payload,
                idempotency_key=idempotency_key
            )
            session.add(outbox)
            await session.commit()
            logger.debug(f"Event {event_type} written to outbox")
```

### 6.5. OutboxWorker

```python
class OutboxWorker:
    """
    Отдельный процесс, который читает outbox и отправляет события.
    Запускается как отдельный контейнер.
    """
    
    POLL_INTERVAL = 30  # секунд
    MAX_RETRY = 5
    
    async def run(self):
        """Бесконечный цикл обработки outbox."""
        while True:
            try:
                await self._process_pending()
            except Exception as e:
                logger.error(f"Outbox Worker error: {e}")
            await asyncio.sleep(self.POLL_INTERVAL)
    
    async def _process_pending(self):
        """
        Читает необработанные события и отправляет их.
        """
        async with async_session() as session:
            pending = await session.execute(
                select(Outbox)
                .where(Outbox.processed_at.is_(None))
                .order_by(Outbox.created_at)
                .limit(100)
            )
            
            for event in pending.scalars():
                try:
                    await self._send_event(event)
                    event.processed_at = datetime.now()
                    event.retry_count = 0
                except Exception as e:
                    event.retry_count += 1
                    event.last_error = str(e)
                    if event.retry_count >= self.MAX_RETRY:
                        event.processed_at = datetime.now()
                        logger.error(f"Event {event.id} permanently failed")
                await session.commit()
    
    async def _send_event(self, event: Outbox):
        """
        Отправляет событие в Astro Service.
        """
        async with httpx.AsyncClient() as client:
            response = await client.post(
                f"{self.astro_url}/internal/v1/psych/event",
                json=event.payload,
                headers={"X-Internal-API-Key": self.api_key}
            )
            response.raise_for_status()
