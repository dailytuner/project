# src/services/alignment_service.py

from datetime import datetime
from typing import Dict, List, Optional
from uuid import UUID

from ..core.house_aligner import HouseAligner
from ..core.dasha_aligner import DashaAligner
from ..core.resonance_calculator import ResonanceCalculator
from ..core.coherence_score import CoherenceScore

from ..clients.forecast_client import ForecastClient
from ..clients.astro_client import AstroClient
from ..clients.psychometry_client import PsychometryClient
from ..clients.lake_client import LakeClient

class AlignmentService:
    """
    Главный сервис сопоставления профилей.
    """
    
    def __init__(
        self,
        forecast_client: ForecastClient,
        astro_client: AstroClient,
        psychometry_client: PsychometryClient,
        lake_client: LakeClient,
        config: Optional[Dict] = None
    ):
        self.forecast_client = forecast_client
        self.astro_client = astro_client
        self.psychometry_client = psychometry_client
        self.lake_client = lake_client
        
        self.house_aligner = HouseAligner(config)
        self.dasha_aligner = DashaAligner(config)
        self.resonance_calculator = ResonanceCalculator()
        self.coherence_score = CoherenceScore(config)
    
    async def calculate_alignment(
        self,
        user_id: UUID,
        date: Optional[datetime] = None
    ) -> Dict:
        """
        Рассчитывает когерентность профилей.
        """
        if date is None:
            date = datetime.now()
        
        # 1. Получаем прогноз (9 осей)
        forecast = await self.forecast_client.get_forecast(user_id, date)
        
        # 2. Получаем биоритмы
        biorhythms = await self.astro_client.get_biorhythms(user_id, date)
        
        # 3. Получаем транзиты
        transits = await self.astro_client.get_transits(user_id, date)
        
        # 4. Получаем психологические шкалы (из Psychometry)
        psych_scores = await self.psychometry_client.get_psych_scores(user_id, date)
        
        # 5. Получаем дашу
        dasha = await self.astro_client.get_dasha(user_id, date)
        
        # 6. Сопоставляем дома
        house_alignments = self.house_aligner.align(
            saturn_house=transits.get('Saturn', {}).get('house', 0),
            jupiter_house=transits.get('Jupiter', {}).get('house', 0),
            psych_scores=psych_scores
        )
        
        # 7. Сопоставляем даши
        dasha_alignments = self.dasha_aligner.align(
            dasha_planet=dasha.get('maha', 'Saturn'),
            psych_scores=psych_scores
        )
        
        # 8. Ретро (упрощённо)
        retro_alignments = self._align_retro(transits, psych_scores)
        
        # 9. Резонанс
        resonance = self.resonance_calculator.calculate(
            biorhythms=biorhythms,
            transits=transits,
            psych_scores=psych_scores,
            coherence_score=0.5  # начальное значение
        )
        
        # 10. Когерентность
        coherence = self.coherence_score.calculate(
            house_alignments=house_alignments,
            dasha_alignments=dasha_alignments,
            retro_alignments=retro_alignments,
            resonance=resonance
        )
        
        # 11. Сохраняем результат
        result = {
            'user_id': user_id,
            'calculated_at': date,
            'coherence_score': coherence['score'],
            'coherence_level': coherence['level'],
            'house_alignments': house_alignments,
            'dasha_alignments': dasha_alignments,
            'retro_alignments': retro_alignments,
            'resonance': resonance,
            'dissonances': coherence['dissonances']
        }
        
        await self._save_result(user_id, date, result)
        
        return result
    
    async def _save_result(
        self,
        user_id: UUID,
        date: datetime,
        result: Dict
    ):
        """
        Сохраняет результат в БД и озеро.
        """
        # 1. Сохраняем в PostgreSQL
        # ... реализация
        
        # 2. Сохраняем в MinIO
        await self.lake_client.upload(
            key=f"alignment/year={date.year}/month={date.month:02d}/user_{user_id}_{date.strftime('%Y%m%d')}.parquet",
            data=result
        )
