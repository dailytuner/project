            'Sun': {'pa_score': 'high', 'ma_score': 'high'},
        }
        
        expected = expectations.get(planet, {}).get(scale, 'moderate')
        
        if expected == 'high' and psych_value > 60:
            return 0.9
        elif expected == 'high' and psych_value > 50:
            return 0.6
        elif expected == 'moderate' and 40 <= psych_value <= 60:
            return 0.9
        elif expected == 'moderate' and 35 <= psych_value <= 65:
            return 0.6
        else:
            return 0.3
    
    def _interpret_dasha(
        self,
        planet: str,
        scale: str,
        psych_value: float,
        effect: str
    ) -> str:
