class LoadTester:
    """
    Тестирует производительность под нагрузкой.
    """
    
    async def test_alignment_throughput(self, concurrent: int = 50):  # НОВЫЙ!
        """
        Тестирует throughput Alignment Engine.
        """
        async with httpx.AsyncClient() as client:
            tasks = []
            for i in range(concurrent):
                tasks.append(
                    client.get(
                        f"http://localhost:8000/api/v1/psych/alignment",
                        params={"user_id": i % 10 + 1, "date": "2026-08-04"}
                    )
                )
            
            start = time.time()
            responses = await asyncio.gather(*tasks)
            elapsed = time.time() - start
            
            success = sum(1 for r in responses if r.status_code == 200)
            
            return {
                'total': len(responses),
                'success': success,
                'failed': len(responses) - success,
                'elapsed_seconds': elapsed,
                'rps': len(responses) / elapsed
            }
