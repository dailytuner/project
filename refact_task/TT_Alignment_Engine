### 3.3. Resonance Calculator

```python
# src/core/resonance_calculator.py

from typing import Dict, List, Optional
from datetime import datetime
from uuid import UUID
import numpy as np

class ResonanceCalculator:
    """
    Расчёт скрытого резонанса между Субъектом и Фоном.
    Не показывается пользователю, используется внутри.
    """
    
    def calculate(
        self,
        biorhythms: Dict[str, float],
        transits: Dict[str, Dict],
        psych_scores: Dict[str, float],
        coherence_score: float
    ) -> Dict:
        """
        Рассчитывает скрытый резонанс.
        """
        # 1. Биоритмический резонанс
        bio_resonance = self._bio_resonance(biorhythms, psych_scores)
        
        # 2. Астрологический резонанс
        astro_resonance = self._astro_resonance(transits, psych_scores)
        
        # 3. Исторический резонанс (из когерентности)
        history_resonance = coherence_score
        
        # 4. Итоговый резонанс
        resonance = (
            bio_resonance * 0.4 +
            astro_resonance * 0.35 +
            history_resonance * 0.25
        )
        
        return {
            'value': round(min(max(resonance, 0), 1), 3),
            'bio_component': round(bio_resonance, 3),
            'astro_component': round(astro_resonance, 3),
            'history_component': round(history_resonance, 3)
        }
    
    def _bio_resonance(
        self,
        biorhythms: Dict[str, float],
        psych_scores: Dict[str, float]
    ) -> float:
        """
        Резонанс биоритмов с психологией.
        """
        # Эмоциональный биоритм ↔ D-шкала (депрессия)
        emotional = biorhythms.get('emotional', 0)  # -1..1
        d_score = psych_scores.get('d_score', 50)  # T-score
        
        # Нормализуем
        emotional_norm = (emotional + 1) / 2  # 0..1
        d_norm = 1 - (d_score - 30) / 70  # 0..1 (высокая D = низкий резонанс)
        
        # Энергетический биоритм ↔ MA-шкала (энергия)
        physical = biorhythms.get('physical', 0)
        ma_score = psych_scores.get('ma_score', 50)
        
        physical_norm = (physical + 1) / 2
        ma_norm = (ma_score - 30) / 70  # 0..1
        
        # Интеллектуальный биоритм ↔ PT-шкала (тревога)
        intellectual = biorhythms.get('intellectual', 0)
        pt_score = psych_scores.get('pt_score', 50)
        
        intellectual_norm = (intellectual + 1) / 2
        pt_norm = 1 - (pt_score - 30) / 70  # 0..1 (высокая PT = низкий резонанс)
        
        # Средний резонанс
        return (
            (1 - abs(emotional_norm - d_norm)) * 0.4 +
            (1 - abs(physical_norm - ma_norm)) * 0.3 +
            (1 - abs(intellectual_norm - pt_norm)) * 0.3
        )
    
    def _astro_resonance(
        self,
        transits: Dict[str, Dict],
        psych_scores: Dict[str, float]
    ) -> float:
        """
        Резонанс транзитов с психологией.
        """
        # Сила ключевых планет
        saturn_strength = transits.get('Saturn', {}).get('strength', 0.5)
        jupiter_strength = transits.get('Jupiter', {}).get('strength', 0.5)
        moon_strength = transits.get('Moon', {}).get('strength', 0.5)
        
        # Психологические корреляты
        d_score = psych_scores.get('d_score', 50)  # депрессия
        ma_score = psych_scores.get('ma_score', 50)  # энергия
        pt_score = psych_scores.get('pt_score', 50)  # тревога
        
        # Нормализуем
        d_norm = (d_score - 30) / 70  # 0..1
        ma_norm = (ma_score - 30) / 70
        pt_norm = (pt_score - 30) / 70
        
        # Сатурн ↔ депрессия (сильный Сатурн → высокая D)
        saturn_match = 1 - abs(saturn_strength - d_norm)
        
        # Юпитер ↔ энергия (сильный Юпитер → высокая MA)
        jupiter_match = 1 - abs(jupiter_strength - ma_norm)
        
        # Луна ↔ тревога (сильная Луна → низкая PT)
        moon_match = 1 - abs(moon_strength - (1 - pt_norm))
        
        return (saturn_match * 0.4 + jupiter_match * 0.35 + moon_match * 0.25)
