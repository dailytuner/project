def normalize_speed(planet_name: str, speed: float) -> float:
    """
    Нормализует скорость планеты в диапазон 0-1.
    
    Для ретроградных планет (speed < 0) возвращает 0.
    Для стационарных (speed = 0) возвращает 0.5.
    """
    if planet_name not in SPEED_RANGES:
        return 0.5
    
    min_s, max_s = SPEED_RANGES[planet_name]
    
    if max_s == min_s:
        return 0.5
    
    if speed < 0:
        return 0.0
    
    normalized = (speed - min_s) / (max_s - min_s)
    return max(0.0, min(1.0, normalized))


