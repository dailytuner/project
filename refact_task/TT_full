# src/core/feedback_processor.py

from typing import Dict, List, Optional
from datetime import datetime, timedelta
from uuid import UUID
import numpy as np
from collections import defaultdict

class FeedbackProcessor:
    """
    Обработка и агрегация обратной связи.
    """
    
    async def process_feedback(
        self,
        user_id: UUID,
        category_id: str,
        forecast_date: datetime,
        actual_outcome: float,
        rating: Optional[int] = None,
        comment: Optional[str] = None
    ) -> Dict:
        """
        Обрабатывает одну запись обратной связи.
        """
        # 1. Сохраняем в БД
        feedback_id = await self._save_feedback(
            user_id, category_id, forecast_date,
            actual_outcome, rating, comment
        )
        
        # 2. Обновляем агрегаты
        await self._update_aggregates(user_id, category_id)
        
        # 3. Проверяем необходимость калибровки
        if await self._needs_calibration(category_id):
            await self._trigger_calibration(category_id)
        
        return {
            'feedback_id': feedback_id,
            'processed': True,
            'needs_calibration': await self._needs_calibration(category_id)
        }
    
    async def _update_aggregates(
        self,
        user_id: UUID,
        category_id: str
    ):
        """
        Обновляет агрегированную статистику для категории.
        """
        # 1. Получаем все feedback для пользователя по категории
        feedbacks = await self._get_user_feedback(user_id, category_id)
        
        if not feedbacks:
            return
        
        # 2. Вычисляем статистику
        outcomes = [f['actual_outcome'] for f in feedbacks]
        ratings = [f['rating'] for f in feedbacks if f.get('rating')]
        
        # Accuracy: доля исходов > 0.5
        accuracy = sum(1 for o in outcomes if o > 0.5) / len(outcomes) if outcomes else 0
        
        # Распределение исходов
        outcome_dist = self._distribution(outcomes, bins=[0, 0.33, 0.66, 1])
        rating_dist = self._distribution(ratings, bins=[1, 2, 3, 4, 5])
        
        # Тренд
        trend = self._calculate_trend(outcomes)
        
        # 3. Сохраняем агрегаты
        await self._save_aggregates(
            user_id=user_id,
            category_id=category_id,
            total_feedback=len(feedbacks),
            avg_outcome=np.mean(outcomes) if outcomes else 0,
            avg_rating=np.mean(ratings) if ratings else 0,
            accuracy=accuracy,
            outcome_distribution=outcome_dist,
            rating_distribution=rating_dist,
            trend_direction=trend['direction'],
            trend_slope=trend['slope']
        )
    
    def _distribution(self, values: List[float], bins: List[float]) -> Dict:
        """
        Вычисляет распределение значений по корзинам.
        """
        dist = {}
        for i in range(len(bins) - 1):
            key = f"{bins[i]}-{bins[i+1]}"
            count = sum(1 for v in values if bins[i] <= v < bins[i+1])
            dist[key] = count
        return dist
    
    def _calculate_trend(self, values: List[float]) -> Dict:
        """
        Вычисляет тренд на основе скользящего среднего.
        """
        if len(values) < 3:
            return {'direction': 'stable', 'slope': 0.0}
        
        # Простая линейная регрессия
        x = np.arange(len(values))
        y = np.array(values)
        slope = np.polyfit(x, y, 1)[0]
        
        if slope > 0.05:
            direction = 'improving'
        elif slope < -0.05:
            direction = 'declining'
        else:
            direction = 'stable'
        
        return {
            'direction': direction,
            'slope': round(float(slope), 4)
        }
    
    async def _needs_calibration(self, category_id: str) -> bool:
        """
        Проверяет, нужно ли калибровать категорию.
        """
        # Минимум 30 наблюдений для калибровки
        count = await self._get_feedback_count(category_id)
        return count >= 30
