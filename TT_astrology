```python
# src/core/biorhythm_core.py

import math
from datetime import date, datetime, timedelta
from typing import Dict, Optional
from uuid import UUID

class BiorhythmCore:
    """
    Расчёт биоритмов (23/28/33 дня).
    """
    
    # Длительность циклов в днях
    CYCLES = {
        'physical': 23,
        'emotional': 28,
        'intellectual': 33
    }
    
    # Названия фаз
    PHASE_NAMES = {
        'rising': 'подъём',
        'falling': 'спад',
        'critical': 'критическая',
        'peak': 'пик',
        'trough': 'низшая точка'
    }
    
    @classmethod
    def calculate(
        cls,
        birth_date: date,
        target_date: date
    ) -> Dict[str, Dict]:
        """
        Рассчитывает значения биоритмов для target_date.
        
        Returns:
            {
                "physical": {"value": 0.32, "phase": "rising"},
                "emotional": {"value": -0.45, "phase": "falling"},
                "intellectual": {"value": 0.78, "phase": "peak"}
            }
        """
        days_alive = (target_date - birth_date).days
        
        result = {}
        for name, cycle_days in cls.CYCLES.items():
            angle = 2 * math.pi * (days_alive % cycle_days) / cycle_days
            value = math.sin(angle)
            
            phase = cls._get_phase(value)
            
            result[name] = {
                'value': round(value, 3),
                'phase': phase,
                'phase_name': cls.PHASE_NAMES.get(phase, 'неизвестно'),
                'cycle_day': (days_alive % cycle_days) + 1,
                'total_days': cycle_days
            }
        
        return result
    
    @classmethod
    def _get_phase(cls, value: float) -> str:
        """Определяет фазу цикла."""
        if value > 0.85:
            return 'peak'
        elif value < -0.85:
            return 'trough'
        elif value > 0:
            return 'rising'
        elif value < 0:
            return 'falling'
        return 'critical'
    
    @classmethod
    def get_interpretation(cls, biorhythms: Dict) -> str:
        """
        Генерирует текстовую интерпретацию биоритмов.
        """
        parts = []
        
        for name, data in biorhythms.items():
            value = data['value']
            phase_name = data['phase_name']
            
            if value > 0.5:
                parts.append(f"{name} на {phase_name} ({value:.0%})")
            elif value < -0.5:
                parts.append(f"{name} на {phase_name} ({value:.0%})")
            else:
                parts.append(f"{name} в нейтральной фазе")
        
        interpretation = f"Биоритмы: {', '.join(parts)}."
        
        # Добавляем совет
        if biorhythms['physical']['value'] > 0.5:
            interpretation += " Хорошее время для физической активности."
        if biorhythms['emotional']['value'] < -0.5:
            interpretation += " Эмоциональный спад — будьте внимательны."
        if biorhythms['intellectual']['value'] > 0.5:
            interpretation += " Отличное время для интеллектуальной работы."
        
        return interpretation
