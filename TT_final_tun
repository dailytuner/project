# alertmanager.yml

groups:
  - name: service_alerts
    rules:
      # Существующие алерты
      - alert: ServiceDown
        expr: up{job=~".*"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.job }} is down"
      
      - alert: HighLatency
        expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job)) > 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High latency on {{ $labels.job }}"
      
      # НОВЫЕ алерты для Alignment Engine
      - alert: LowCoherenceScore
        expr: avg(coherence_score) < 0.4
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Average coherence score below threshold"
      
      - alert: HighDissonanceRate
        expr: rate(dissonance_count[1h]) > 10
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "High dissonance rate detected"
      
      - alert: AlignmentCacheLowHitRate
        expr: rate(alignment_cache_hit_total[1h]) / (rate(alignment_cache_hit_total[1h]) + rate(alignment_cache_miss_total[1h])) < 0.5
        for: 1h
        labels:
          severity: warning
          annotations:
            summary: "Alignment cache hit rate below 50%"
      
      # Существующие алерты
      - alert: AnalyticsFailed
        expr: analytics_update_failure_count > 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Analytics update failed"
      
      - alert: LakeUploadFailed
