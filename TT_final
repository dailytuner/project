# integration/normalization.py
from typing import List
from core.models import Thesis


def normalize_cluster(cluster: List[Thesis], N_max: int = None) -> List[Thesis]:
    """
    Оставляет не более N_max тезисов от одной системы.
    
    Обоснование N_max=5:
        - В западной астрологии типично 5 планет в одном доме (максимум)
        - В ведической — 5 тезисов (накшатра + 4 даши)
        - 5 — максимальное осмысленное количество для пользователя
    
    Args:
        cluster: Кластер тезисов
        N_max: Максимальное количество тезисов от одной системы
               (по умолчанию из SettingsManager)
    """
    if N_max is None:
        from config.settings_manager import get_settings
        N_max = get_settings().get("n_max", 5)
    
    by_system: dict = {}
    for thesis in cluster:
        by_system.setdefault(thesis.system, []).append(thesis)
    
    normalized = []
    for system, system_theses in by_system.items():
        sorted_theses = sorted(system_theses, key=lambda t: t.confidence, reverse=True)
        normalized.extend(sorted_theses[:N_max])
    return normalized
