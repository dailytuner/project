        """Возвращает позицию планеты из кэша или рассчитывает."""
        cached = await self._get_from_cache(date, planet)
        if cached:
            return cached
        
        jd = swe.julday(date.year, date.month, date.day, 12.0)
        pos, speed = swe.calc_ut(jd, planet)
        
        await self._save_to_cache(date, planet, pos, speed)
        
        return PlanetPosition(
            longitude=pos[0],
            latitude=pos[1],
            distance=pos[2],
            longitude_speed=speed[0],
            latitude_speed=speed[1],
            distance_speed=speed[2]
        )
    
