        self,
        house: House,
        planets: Dict,
        aspects: List[Aspect]
    ) -> float:
        """Сила дома = управитель + планеты в доме + аспекты"""
        # 1. Управитель дома (по знаку куспида)
        ruler = self._get_house_ruler(house.sign)
        ruler_strength = planets.get(ruler, {}).get('strength', 0.5)
        
