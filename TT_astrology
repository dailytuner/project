    @classmethod
    def get_boost(cls, category: str, date: datetime) -> float:
        """
        Возвращает сезонный буст для категории в указанную дату.
        """
        month = date.month
        category_boosts = cls.SEASONAL_BOOSTS.get(category, {})
        return category_boosts.get(month, 0.0)
    
    @classmethod
    def get_all_boosts(cls, date: datetime) -> Dict[str, float]:
        """
        Возвращает бусты для всех категорий.
        """
        month = date.month
        boosts = {}
        for category, category_boosts in cls.SEASONAL_BOOSTS.items():
            boosts[category] = category_boosts.get(month, 0.0)
        return boosts
    
    @classmethod
    def get_season_name(cls, date: datetime) -> str:
        """
        Возвращает название сезона для даты.
        """
        month = date.month
        if month in [12, 1, 2]:
            return 'зима'
        elif month in [3, 4, 5]:
            return 'весна'
        elif month in [6, 7, 8]:
            return 'лето'
        else:
            return 'осень'
