### 3.1. Weight Optimizer

```python
# src/core/weight_optimizer.py

from typing import Dict, List, Optional
from datetime import datetime
from uuid import UUID
import numpy as np
from scipy.optimize import minimize, differential_evolution

class WeightOptimizer:
    """
    Оптимизация весов индексов достижения.
    """
    
    # Компоненты индекса
    COMPONENTS = ['clarity', 'synchronicity', 'resource', 'inertia']
    
    # Границы для каждого компонента
    BOUNDS = {
        'clarity': (0.1, 0.6),
        'synchronicity': (0.1, 0.6),
        'resource': (0.1, 0.6),
        'inertia': (0.0, 0.3)
    }
    
    async def optimize(
        self,
        category_id: str,
        data: List[Dict],
        method: str = 'differential_evolution'
    ) -> Dict:
        """
        Находит оптимальные веса для категории.
        """
        if len(data) < 30:
            return {
                'status': 'insufficient_data',
                'n_observations': len(data),
                'message': f'Need at least 30 observations, got {len(data)}'
            }
        
        # 1. Целевая функция
        def objective(weights):
            total_error = 0
            for record in data:
                predicted = (
                    record['clarity'] * weights[0] +
                    record['synchronicity'] * weights[1] +
                    record['resource'] * weights[2] -
                    record['inertia'] * weights[3]
                )
                predicted = max(0, min(1, predicted))
                actual = record['actual_outcome']
                total_error += (predicted - actual) ** 2
            return total_error / len(data)
        
        # 2. Начальные значения
        initial_weights = [0.3, 0.3, 0.3, 0.1]
        
        # 3. Ограничения
        bounds = [
            (0.1, 0.6),  # clarity
            (0.1, 0.6),  # synchronicity
            (0.1, 0.6),  # resource
            (0.0, 0.3)   # inertia
        ]
        
        constraints = [
            {'type': 'eq', 'fun': lambda w: sum(w) - 1}
        ]
        
        # 4. Оптимизация
        if method == 'differential_evolution':
            result = differential_evolution(
                objective,
                bounds,
                strategy='best1bin',
                maxiter=1000,
                popsize=15
            )
        else:
            result = minimize(
                objective,
                initial_weights,
                method='SLSQP',
                bounds=bounds,
                constraints=constraints
            )
        
        # 5. Обработка результата
        if result.success:
            optimal_weights = {
                'clarity': round(float(result.x[0]), 3),
                'synchronicity': round(float(result.x[1]), 3),
                'resource': round(float(result.x[2]), 3),
                'inertia': round(float(result.x[3]), 3)
            }
            
            # Валидация
            validation_score = self._validate(optimal_weights, data)
            
            # Сравнение с текущими весами
            current_weights = await self._get_current_weights(category_id)
            improvement = self._calculate_improvement(
                optimal_weights, current_weights, data
            )
            
            return {
                'status': 'success',
                'weights': optimal_weights,
                'validation_score': round(validation_score, 3),
                'n_observations': len(data),
                'improvement': round(improvement, 3),
                'iterations': result.nit if hasattr(result, 'nit') else 0
            }
        else:
            return {
                'status': 'failed',
                'message': result.message,
                'n_observations': len(data)
            }
    
    def _validate(self, weights: Dict, data: List[Dict]) -> float:
        """
        Валидирует веса на исторических данных.
        """
        predictions = []
        actuals = []
        
        for record in data:
            predicted = (
                record['clarity'] * weights['clarity'] +
                record['synchronicity'] * weights['synchronicity'] +
                record['resource'] * weights['resource'] -
                record['inertia'] * weights['inertia']
            )
            predicted = max(0, min(1, predicted))
            predictions.append(predicted)
            actuals.append(record['actual_outcome'])
        
        # R^2
        predictions = np.array(predictions)
        actuals = np.array(actuals)
        
        ss_res = np.sum((predictions - actuals) ** 2)
        ss_tot = np.sum((actuals - np.mean(actuals)) ** 2)
        
        return 1 - (ss_res / ss_tot) if ss_tot > 0 else 0
    
    def _calculate_improvement(
        self,
        new_weights: Dict,
        old_weights: Dict,
        data: List[Dict]
    ) -> float:
        """
        Вычисляет улучшение относительно текущих весов.
        """
        # Текущая ошибка
        old_error = 0
        new_error = 0
        
        for record in data:
            # Старые веса
            old_pred = (
                record['clarity'] * old_weights.get('clarity', 0.3) +
                record['synchronicity'] * old_weights.get('synchronicity', 0.3) +
                record['resource'] * old_weights.get('resource', 0.3) -
                record['inertia'] * old_weights.get('inertia', 0.1)
            )
            old_pred = max(0, min(1, old_pred))
            old_error += (old_pred - record['actual_outcome']) ** 2
            
            # Новые веса
            new_pred = (
                record['clarity'] * new_weights['clarity'] +
                record['synchronicity'] * new_weights['synchronicity'] +
                record['resource'] * new_weights['resource'] -
                record['inertia'] * new_weights['inertia']
            )
            new_pred = max(0, min(1, new_pred))
            new_error += (new_pred - record['actual_outcome']) ** 2
        
        if old_error == 0:
            return 0
        
        return (old_error - new_error) / old_error
