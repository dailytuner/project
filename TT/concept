### 5.6. Динамическая интеграция (2Б)

```python
# integration/dynamic.py
from typing import List, Dict, Any
from datetime import datetime
from core.models import Thesis

def integrate_dynamic(
    dynamic_theses: List[Thesis],
    static_clusters: Dict[str, Any],
    current_date: datetime,
    horizon_days: int
) -> List[Dict[str, Any]]:
    """
    Интеграция динамических тезисов с наложением на статические кластеры.
    
    Args:
        dynamic_theses: Список динамических тезисов
        static_clusters: Результат статической интеграции
        current_date: Текущая дата
        horizon_days: Горизонт прогноза
    
    Returns:
        List[dict]: Интегрированные динамические сигналы
    """
    # Минимальный порог уверенности
    MIN_CONFIDENCE = 0.15
    
    # Фильтрация слабых сигналов
    filtered = [t for t in dynamic_theses if t.confidence >= MIN_CONFIDENCE]
    
    if not filtered:
        return []
    
    # Кластеризация динамических тезисов
    dyn_clusters = cluster_theses(filtered)
    
    integrated = []
    for dyn_cluster in dyn_clusters:
        # Вычисляем центроид динамического кластера
        dyn_centroid = compute_centroid(dyn_cluster)
        
        # Находим ближайший статический кластер
        best_match = None
        best_similarity = 0
        
        for static_cluster in static_clusters["clusters"]:
            static_centroid = compute_centroid(static_cluster)
            similarity = cosine_similarity(dyn_centroid, static_centroid)
            
            if similarity > best_similarity:
                best_similarity = similarity
                best_match = static_cluster
        
        if best_match and best_similarity > 0.3:
            # Проверка конфликта направлений
            static_sign = get_cluster_sign(best_match)
            dynamic_sign = get_cluster_sign(dyn_cluster)
            
            if static_sign != dynamic_sign:
                intersection_type = "tension"
                tension_index = calculate_tension_index(dyn_cluster + best_match)
            else:
                intersection_type = "amplification"
                tension_index = 0
            
            integrated.append({
                "static_cluster": best_match,
                "dynamic_cluster": dyn_cluster,
                "similarity": best_similarity,
                "type": intersection_type,
                "tension_index": tension_index,
                "time_window": get_intersection_window(dyn_cluster),
                "temporal_confidence": sum(t.confidence for t in dyn_cluster) / len(dyn_cluster)
            })
        else:
            integrated.append({
                "static_cluster": None,
                "dynamic_cluster": dyn_cluster,
                "similarity": 0,
                "type": "new_signal",
                "tension_index": 0,
                "time_window": get_intersection_window(dyn_cluster),
                "temporal_confidence": sum(t.confidence for t in dyn_cluster) / len(dyn_cluster)
            })
    
    return integrated

def compute_centroid(cluster: List[Thesis]) -> List[float]:
    """
    Вычисляет центроид кластера (среднее векторов).
    """
    n = len(cluster)
    if n == 0:
        return [0.0] * 12
    
    centroid = [0.0] * 12
    for thesis in cluster:
        for i, val in enumerate(thesis.sphere_vector):
            centroid[i] += val
    
    return [v / n for v in centroid]

def get_cluster_sign(cluster: List[Thesis]) -> int:
    """
    Определяет доминирующий знак в кластере.
    """
    pos = sum(1 for t in cluster if t.sign == 1)
    neg = sum(1 for t in cluster if t.sign == -1)
    
    if pos > neg:
        return 1
    elif neg > pos:
        return -1
    else:
        return 0

def get_intersection_window(dyn_cluster: List[Thesis]) -> Dict[str, float]:
    """
    Вычисляет общее временное окно для динамических тезисов.
    
    Окно определяется как [пик - 2σ, пик + 2σ] для каждого тезиса.
    Тезисы на границе имеют confidence = exp(-2) ≈ 0.135.
    """
    if not dyn_cluster:
        return {"start": 0, "end": 0, "center": 0}
    
    peaks = [t.days_to_peak for t in dyn_cluster]
    sigmas = [t.time_horizon.sigma_days or 30 for t in dyn_cluster]
    
    # Используем >= для математической строгости
    starts = [p - 2 * s for p, s in zip(peaks, sigmas)]
    ends = [p + 2 * s for p, s in zip(peaks, sigmas)]
    
    return {
        "start": min(starts) if starts else 0,
        "end": max(ends) if ends else 0,
        "center": sum(peaks) / len(peaks) if peaks else 0
    }
