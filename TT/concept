### 4.1. Структура тезиса (Pydantic модель)

```python
# core/models.py
from pydantic import BaseModel, Field
from typing import List, Optional, Dict, Any
from datetime import datetime

class TimeHorizon(BaseModel):
    """Модель временного горизонта."""
    decay: str = Field(..., pattern=r'^(constant|gaussian)$')
    sigma_days: Optional[float] = Field(None, ge=0)

class Thesis(BaseModel):
    """Модель тезиса."""
    id: str = Field(..., description="Уникальный ID, формат: {system}_{name}")
    system: str = Field(..., pattern=r'^(western|vedic|arabic|chinese|maya|mesopotamian|transits)$')
    sphere_vector: List[float] = Field(..., min_length=12, max_length=12)
    sign: int = Field(..., ge=-1, le=1, description="+1 | -1 | 0")
    claim: str = Field(..., max_length=200, description="Человекочитаемое описание")
    base_confidence: float = Field(..., ge=0.0, le=1.0)
    confidence: float = Field(..., ge=0.0, le=1.0)
    level: int = Field(..., ge=1, le=4)
    anchors: List[str] = Field(..., min_length=1)
    time_horizon: TimeHorizon
    days_to_peak: int = 0
    peak_date: Optional[datetime] = None
    metadata: Dict[str, Any] = Field(default_factory=dict)
```

**ВАЖНО:** `base_confidence` и `confidence` — разные поля:
- `base_confidence` — рассчитывается при генерации тезиса
- `confidence` — рассчитывается после генерации (base × K-факторы × временная модуляция)

### 4.2. Статическая интерпретация (1А) с graceful degradation

```python
# interpretation/generator.py
import logging
from typing import List, Dict, Any
from core.models import Thesis

logger = logging.getLogger(__name__)

def generate_static_theses(static_core: Dict[str, Any]) -> List[Thesis]:
    """
    Генерирует все статические тезисы с graceful degradation.
    
    Если одна система падает — логируем ошибку и продолжаем.
    Если все системы падают — выбрасываем исключение.
    
    Returns:
        List[Thesis]: Список тезисов
    
    Raises:
        ValueError: Если не сгенерировано ни одного тезиса
    """
    all_theses = []
    systems = [
        ("western", generate_western_theses),
        ("vedic", generate_vedic_theses),
        ("arabic", generate_arabic_theses),
        ("chinese", generate_chinese_theses),
        ("maya", generate_maya_theses),
        ("mesopotamian", generate_mesopotamian_theses),
    ]
    
    failed_systems = []
    
    for system_name, generator_func in systems:
        try:
            theses = generator_func(static_core)
            if theses:
                all_theses.extend(theses)
                logger.info(
                    "system_generated",
                    system=system_name,
                    count=len(theses)
                )
            else:
                logger.warning(
                    "system_empty",
                    system=system_name,
                    message="System returned empty list"
                )
        except Exception as e:
            logger.error(
                "system_failed",
                system=system_name,
                error=str(e),
                error_type=type(e).__name__
            )
            failed_systems.append(system_name)
    
    # Если все системы упали — критическая ошибка
    if not all_theses:
        raise ValueError(
            f"All interpretation systems failed. Failed: {failed_systems}. "
            "Check ephemeris data and system integrity."
        )
    
    # Если часть систем упала — логируем предупреждение
    if failed_systems:
        logger.warning(
            "partial_failure",
            failed_systems=failed_systems,
            total_systems=len(systems),
            theses_count=len(all_theses)
        )
    
    # Расчет Confidence для всех тезисов
    for thesis in all_theses:
        thesis.confidence = calculate_astronomical_confidence(thesis, static_core)
        thesis.time_horizon = TimeHorizon(decay="constant")
        thesis.days_to_peak = 0
        thesis.peak_date = None
    
    return all_theses
```

