### 3.1. Входные данные (BirthData) — Pydantic модель

```python
# core/models.py
from pydantic import BaseModel, Field, field_validator
from datetime import datetime
import pytz
from calendar import monthrange

class BirthData(BaseModel):
    """
    Модель входных данных рождения.
    
    Валидация выполняется автоматически при создании объекта.
    """
    user_id: str = Field(..., max_length=50, description="Уникальный идентификатор")
    year: int = Field(..., ge=1900, le=2100, description="Год рождения")
    month: int = Field(..., ge=1, le=12, description="Месяц рождения")
    day: int = Field(..., ge=1, le=31, description="День рождения")
    hour: int = Field(..., ge=0, le=23, description="Час рождения")
    minute: int = Field(..., ge=0, le=59, description="Минута рождения")
    second: int = Field(..., ge=0, le=59, description="Секунда рождения")
    timezone: str = Field(..., description="IANA часовой пояс")
    lat: float = Field(..., ge=-90.0, le=90.0, description="Широта")
    lng: float = Field(..., ge=-180.0, le=180.0, description="Долгота")
    altitude: float = Field(0.0, ge=-1000, le=10000, description="Высота над уровнем моря")
    
    @field_validator('timezone')
    @classmethod
    def validate_timezone(cls, v: str) -> str:
        """Проверяет, что часовой пояс существует в IANA базе."""
        try:
            pytz.timezone(v)
        except pytz.exceptions.UnknownTimeZoneError:
            raise ValueError(f"Unknown timezone: {v}")
        return v
    
    @field_validator('day')
    @classmethod
    def validate_day(cls, v: int, info) -> int:
        """Проверяет, что день существует в указанном месяце."""
        month = info.data.get('month')
        year = info.data.get('year')
        if month and year:
            max_day = monthrange(year, month)[1]
            if v > max_day:
                raise ValueError(f"Day {v} is invalid for month {month}")
        return v
    
    def to_utc_datetime(self) -> datetime:
        """Преобразует локальное время рождения в UTC."""
        from utils.time_module import TimeModule
        local_dt = datetime(
            year=self.year,
            month=self.month,
            day=self.day,
            hour=self.hour,
            minute=self.minute,
            second=self.second
        )
        return TimeModule.local_to_utc(local_dt, self.timezone)
```

### 3.2. Статическое ядро (0А)

**Что:** Натальные координаты планет, домов, аспектов.

**Когда:** При инициализации профиля (вызов `/init`).

**Как часто:** 1 раз (пока не изменится BirthData).

**Кеширование:** Постоянно (TTL = ∞).

```python
# core/calculations.py
import swisseph as swe
from typing import Dict, Any
from datetime import datetime
from utils.time_module import TimeModule

def calculate_static_core(birth_data: BirthData) -> Dict[str, Any]:
    """
    Рассчитывает статическое астрономическое ядро.
    
    Args:
        birth_data: Данные рождения (Pydantic модель)
    
    Returns:
        dict: StaticCore
    
    Raises:
        RuntimeError: Если Swiss Ephemeris вернул ошибку
    """
    # 1. Конвертация в UTC и расчет JD
    utc_dt = birth_data.to_utc_datetime()
    jd = TimeModule.to_julian_day(utc_dt)
    
    # 2. Solar Time (для всех систем)
    solar_time = calculate_solar_time(jd, birth_data.lng, birth_data.timezone)
    
    # 3. Натальные планеты (ОПТИМИЗИРОВАННО: calc_ut)
    # ВНИМАНИЕ: Используйте calc_ut для расчета всех планет за один вызов
    # Это ускоряет работу в 5-10 раз по сравнению с поштучным расчетом
    try:
        all_coords = swe.calc_ut(jd=jd)
    except Exception as e:
        raise RuntimeError(f"Swiss Ephemeris error: {e}")
    
    # Проверка наличия данных
    if not all_coords:
        raise RuntimeError("No ephemeris data returned")
    
    # Формат данных Swiss Ephemeris:
    # all_coords = {
    #   "Sun": {"longitude": 202.84, "latitude": 0.0, "speed": 0.98},
    #   ...
    # }
    
    planets = {}
    for planet_name, coords in all_coords.items():
        planets[planet_name] = {
            "longitude": coords["longitude"],          # 0-360°
            "latitude": coords["latitude"],            # -90-90°
            "speed": coords["speed"],                  # °/день
            "speed_normalized": normalize_speed(planet_name, coords["speed"]),  # 0-1
            "retrograde": coords["speed"] < 0,         # bool
            "sign": get_sign(coords["longitude"]),     # "Libra"
            "sign_longitude": coords["longitude"] % 30,  # 0-30°
            "dignity": calculate_dignity(planet_name, coords["longitude"])
        }
    
    # 4. Натальные дома (Placidus)
    sidereal_time = calculate_sidereal_time(jd, birth_data.lng)
    houses = calculate_houses_placidus(
        sidereal_time=sidereal_time,
        lat=birth_data.lat
    )
    
    # 5. Привязка планет к домам
    for planet_name, planet_data in planets.items():
        planet_data["house"] = get_house(planet_data["longitude"], houses)
    
    # 6. Натальные аспекты
    aspects = calculate_aspects(planets, ORBS_DEFAULT)
    
    # 7. Айанамша (Lahiri — для Vedic)
    ayanamsa = swe.ayanamsa(jd)
    
    # 8. День/ночь (для Arabic Parts)
    is_daytime = check_daytime(planets["Sun"]["longitude"], houses[1]["cusp"])
    
    # 9. Создание хэша для кеширования
    core_hash = hashlib.md5(str(birth_data.model_dump()).encode()).hexdigest()[:8]
    
    return {
        "jd": jd,
        "utc_datetime": utc_dt.isoformat(),
        "solar_time": solar_time,
        "ayanamsa": ayanamsa,
        "ayanamsa_type": "lahiri",
        "planets": planets,
        "houses": houses,
        "aspects": aspects,
        "is_daytime": is_daytime,
        "birth_data": birth_data.model_dump(),
        "birth_data_hash": core_hash,
        "metadata": {
            "calculated_at": TimeModule.utc_now().isoformat(),
            "rules_version": VERSION_MANAGER.get_api_version()
        }
    }
```

### 3.3. Динамическое ядро (0Б)

**Что:** Транзитные координаты планет, аспекты к натальным.

**Когда:** При запросе daily профиля.

**Как часто:** На каждый запрос (с кешированием на 7 дней).

**Кеширование:** 7 дней (TTL = 604800 секунд).

```python
# core/calculations.py
def calculate_dynamic_core(static_core: dict, current_date: datetime, horizon_days: int = 90) -> dict:
    """
    Рассчитывает динамическое астрономическое ядро.
    
    Args:
        static_core: Статическое ядро (для натальных позиций)
        current_date: Дата запроса (должна быть в UTC)
        horizon_days: Горизонт прогноза в днях
    
    Returns:
        dict: DynamicCore
    
    Raises:
        RuntimeError: Если Swiss Ephemeris вернул ошибку
    """
    from utils.time_module import TimeModule
    
    # 1. Убеждаемся, что дата в UTC
    if current_date.tzinfo is None:
        current_date = TimeModule.localize_utc(current_date)
    
    # 2. JD для текущей даты (полдень UTC)
    transit_jd = TimeModule.to_julian_day(current_date.replace(hour=12, minute=0, second=0))
    
    # 3. Транзитные планеты (ОПТИМИЗИРОВАННО: calc_ut)
    try:
        all_coords = swe.calc_ut(jd=transit_jd)
    except Exception as e:
        raise RuntimeError(f"Swiss Ephemeris error: {e}")
    
    if not all_coords:
        raise RuntimeError("No ephemeris data returned")
    
    transit_planets = {}
    for planet_name, coords in all_coords.items():
        transit_planets[planet_name] = {
            "longitude": coords["longitude"],
            "speed": coords["speed"],
            "retrograde": coords["speed"] < 0
        }
    
    # 4. Транзитные аспекты к натальным
    transit_aspects = []
    for tp_name, tp_data in transit_planets.items():
        for np_name, np_data in static_core["planets"].items():
            angle = (tp_data["longitude"] - np_data["longitude"]) % 360
            
            for aspect_type, orb in ASPECT_ORBS.items():
                if abs(angle - aspect_type) <= orb:
                    peak_date = calculate_peak_date(
                        transit_planet=tp_name,
                        natal_planet=np_name,
                        aspect_type=aspect_type,
                        current_date=current_date,
                        speed=tp_data["speed"]
                    )
                    
                    transit_aspects.append({
                        "transit_planet": tp_name,
                        "natal_planet": np_name,
                        "aspect_type": aspect_type,
                        "angle": angle,
                        "orb": abs(angle - aspect_type),
                        "strength": 1 - (abs(angle - aspect_type) / orb),
                        "peak_date": peak_date.isoformat(),
                        "days_to_peak": (peak_date - current_date).days,
                        "speed": abs(tp_data["speed"])
                    })
    
    return {
        "date": current_date.isoformat(),
        "jd": transit_jd,
        "planets": transit_planets,
        "aspects": transit_aspects,
        "horizon_days": horizon_days,
        "metadata": {
            "calculated_at": TimeModule.utc_now().isoformat()
        }
    }
```

### 3.4. Расчет даты точного аспекта

```python
# core/calculations.py
def calculate_peak_date(transit_planet: str, natal_planet: str, aspect_type: float, 
                        current_date: datetime, speed: float) -> datetime:
    """
    Вычисляет дату, когда транзитный аспект будет точным.
    
    Args:
        transit_planet: Имя транзитной планеты
        natal_planet: Имя натальной планеты
        aspect_type: Тип аспекта (в градусах)
        current_date: Текущая дата (UTC)
        speed: Скорость транзитной планеты (°/день)
    
    Returns:
        datetime: Дата точного аспекта (UTC)
    
    Raises:
        ValueError: Если speed = 0
    """
    transit_long = get_transit_longitude(transit_planet, current_date)
    natal_long = get_natal_longitude(natal_planet)
    
    current_diff = (transit_long - natal_long) % 360
    target_angle = ASPECT_ANGLES[aspect_type]
    delta = (target_angle - current_diff) % 360
    
    # Поправка на направление движения
    if delta > 180:
        delta -= 360
    
    # Защита от деления на ноль
    if speed == 0:
        # Если планета стационарна — возвращаем текущую дату + 30 дней
        return current_date + timedelta(days=30)
    
    days_to_peak = delta / speed
    return current_date + timedelta(days=days_to_peak)
```

### 3.5. Solar Time (для разных систем)

```python
# core/solar_time.py
from datetime import datetime, timedelta
from typing import Dict, Any

def calculate_solar_time(jd: float, lng: float, timezone: str) -> Dict[str, Any]:
    """
    Рассчитывает местное истинное солнечное время для всех систем.
    
    Args:
        jd: Юлианский день
        lng: Долгота
        timezone: IANA timezone
    
    Returns:
        dict: Solar Time для каждой системы
    """
    from utils.time_module import TimeModule
    import swisseph as swe
    
    # Преобразуем JD в datetime
    utc_dt = TimeModule.from_julian_day(jd)
    
    # LMT (Local Mean Time)
    lmt = utc_dt + timedelta(hours=lng / 15)
    
    # EOT (Equation of Time)
    eot = swe.equation_of_time(jd)
    last = lmt + timedelta(minutes=eot)
    
    systems = {}
    for system, offset_func in T_OFFSET_FUNCTIONS.items():
        if callable(offset_func):
            offset = offset_func(last, lng)
        else:
            offset = offset_func
        
        final_time = last + timedelta(hours=offset)
        
        if final_time.hour < 0:
            final_date = final_time - timedelta(days=1)
        elif final_time.hour >= 24:
            final_date = final_time + timedelta(days=1)
        else:
            final_date = final_time
        
        systems[system] = {
            "datetime": final_date.isoformat(),
            "jd": TimeModule.to_julian_day(final_date),
            "offset": offset
        }
    
    return {
        "lmt": lmt.isoformat(),
        "eot": eot,
        "last": last.isoformat(),
        "systems": systems
    }

T_OFFSET_FUNCTIONS = {
    "western": lambda dt, lng: 0,
    "vedic": lambda dt, lng: -get_sunrise(dt, lng),
    "chinese": lambda dt, lng: -1,
    "maya": lambda dt, lng: -get_sunset(dt - timedelta(days=1), lng),
    "arabic": lambda dt, lng: 0,
    "mesopotamian": lambda dt, lng: 0,
    "transits": lambda dt, lng: 0
}
