### 3.2. Threshold Tuner

```python
# src/core/threshold_tuner.py

from typing import Dict, List, Optional
import numpy as np

class ThresholdTuner:
    """
    Настройка порогов окон возможностей.
    """
    
    async def tune(
        self,
        data: List[Dict],
        current_thresholds: Optional[Dict] = None
    ) -> Dict:
        """
        Находит оптимальные пороги для окон.
        """
        if len(data) < 100:
            return {
                'status': 'insufficient_data',
                'n_observations': len(data),
                'message': f'Need at least 100 observations, got {len(data)}'
            }
        
        # 1. Извлекаем данные
        window_values = [d['window_value'] for d in data]
        outcomes = [d['actual_outcome'] for d in data]
        
        # 2. Поиск оптимальных порогов (сеточный поиск)
        best_accuracy = 0
        best_thresholds = None
        best_confusion = None
        
        for open_th in np.arange(0.5, 0.9, 0.02):
            for partial_th in np.arange(0.2, 0.6, 0.02):
                if partial_th >= open_th:
                    continue
                
                # Классификация
                predictions = []
                for wv in window_values:
                    if wv >= open_th:
                        predictions.append('open')
                    elif wv >= partial_th:
                        predictions.append('partial')
                    else:
                        predictions.append('closed')
                
                # Точность
                accuracy, confusion = self._calculate_metrics(
                    predictions, outcomes, open_th, partial_th
                )
                
                if accuracy > best_accuracy:
                    best_accuracy = accuracy
                    best_thresholds = {
                        'open': round(open_th, 2),
                        'partial': round(partial_th, 2),
                        'closed': round(partial_th - 0.1, 2)
                    }
                    best_confusion = confusion
        
        # 3. Валидация
        if best_thresholds:
            validation_score = self._validate_thresholds(best_thresholds, data)
            
            # Сравнение с текущими порогами
            improvement = 0
            if current_thresholds:
                improvement = self._calculate_improvement(
                    best_thresholds, current_thresholds, data
                )
            
            return {
                'status': 'success',
                'thresholds': best_thresholds,
                'accuracy': round(best_accuracy, 3),
                'validation_score': round(validation_score, 3),
                'n_observations': len(data),
                'improvement': round(improvement, 3),
                'confusion_matrix': best_confusion
            }
        else:
            return {
                'status': 'failed',
                'message': 'No optimal thresholds found',
                'n_observations': len(data)
            }
    
    def _calculate_metrics(
        self,
        predictions: List[str],
        outcomes: List[float],
        open_th: float,
        partial_th: float
    ) -> tuple:
        """
        Вычисляет точность и матрицу ошибок.
        """
        # Ожидаемые классы на основе исходов
        expected = []
        for outcome in outcomes:
            if outcome >= open_th:
                expected.append('open')
            elif outcome >= partial_th:
                expected.append('partial')
            else:
                expected.append('closed')
        
        # Матрица ошибок
        confusion = {
            'open': {'correct': 0, 'wrong': 0, 'total': 0},
            'partial': {'correct': 0, 'wrong': 0, 'total': 0},
            'closed': {'correct': 0, 'wrong': 0, 'total': 0}
        }
        
        correct = 0
        for pred, exp in zip(predictions, expected):
            if pred == exp:
                correct += 1
                confusion[pred]['correct'] += 1
            else:
                confusion[pred]['wrong'] += 1
            confusion[pred]['total'] += 1
        
        accuracy = correct / len(predictions) if predictions else 0
        
        return accuracy, confusion
    
    def _validate_thresholds(self, thresholds: Dict, data: List[Dict]) -> float:
        """
        Валидирует пороги на исторических данных.
        """
        window_values = [d['window_value'] for d in data]
        outcomes = [d['actual_outcome'] for d in data]
        
        open_th = thresholds['open']
        partial_th = thresholds['partial']
        
        predictions = []
        for wv in window_values:
            if wv >= open_th:
                predictions.append('open')
            elif wv >= partial_th:
                predictions.append('partial')
            else:
                predictions.append('closed')
        
        # Ожидаемые классы
        expected = []
        for outcome in outcomes:
            if outcome >= open_th:
                expected.append('open')
            elif outcome >= partial_th:
                expected.append('partial')
            else:
                expected.append('closed')
        
        correct = sum(1 for p, e in zip(predictions, expected) if p == e)
        return correct / len(predictions) if predictions else 0
    
    def _calculate_improvement(
        self,
        new_thresholds: Dict,
        old_thresholds: Dict,
        data: List[Dict]
    ) -> float:
        """
        Вычисляет улучшение относительно текущих порогов.
        """
        old_accuracy = self._validate_thresholds(old_thresholds, data)
        new_accuracy = self._validate_thresholds(new_thresholds, data)
        
        if old_accuracy == 0:
            return 0
        
        return (new_accuracy - old_accuracy) / old_accuracy
