            house.strength = self._calculate_house_strength(
                house, chart.planets, chart.aspects
            )
        
        return WesternChart.from_raw(chart)
    
    def _calculate_essential_dignity(self, planet: PlanetPosition) -> float:
        """Реальная астрологическая сила — сумма достоинств"""
        # Используем уже рассчитанные dignity_score
        # Нормализуем от -5..+5 до 0..1 с сигмоидой
        score = planet.dignity_score  # уже рассчитан в ephemeris_base.py
        return self._sigmoid((score + 5) / 10)
    
