### 3.3. Window Optimizer

```python
# src/core/window_optimizer.py

from typing import Dict, List, Optional
from datetime import datetime
import numpy as np

class WindowOptimizer:
    """
    Оптимизация порогов окон возможностей.
    """
    
    async def optimize(
        self,
        version: str = 'v1.0'
    ) -> Dict:
        """
        Оптимизирует пороги окон на основе обратной связи.
        """
        # 1. Получаем исторические данные
        data = await self._get_window_data()
        
        if len(data) < 100:
            return {
                'status': 'insufficient_data',
                'n_observations': len(data)
            }
        
        # 2. Поиск оптимальных порогов
        optimal_thresholds = self._find_optimal_thresholds(data)
        
        # 3. Валидация
        validation_score = self._validate_thresholds(optimal_thresholds, data)
        
        # 4. Сохраняем
        optimization_id = await self._save_optimization(
            version=version,
            thresholds=optimal_thresholds,
            validation_score=validation_score,
            n_observations=len(data)
        )
        
        return {
            'optimization_id': optimization_id,
            'thresholds': optimal_thresholds,
            'validation_score': validation_score
        }
    
    def _find_optimal_thresholds(self, data: List[Dict]) -> Dict:
        """
        Находит оптимальные пороги для окон.
        """
        # Значения окон и исходы
        window_values = [d['window_value'] for d in data]
        outcomes = [d['actual_outcome'] for d in data]
        
        # Перебор порогов
        best_accuracy = 0
        best_thresholds = {'open': 0.7, 'partial': 0.4, 'closed': 0.2}
        
        for open_th in np.arange(0.5, 0.9, 0.05):
            for partial_th in np.arange(0.2, 0.6, 0.05):
                if partial_th >= open_th:
                    continue
                
                # Классификация по порогам
                predictions = []
                for wv in window_values:
                    if wv >= open_th:
                        predictions.append('open')
                    elif wv >= partial_th:
                        predictions.append('partial')
                    else:
                        predictions.append('closed')
                
                # Сопоставление с исходами
                accuracy = self._calculate_accuracy(predictions, outcomes)
                
                if accuracy > best_accuracy:
                    best_accuracy = accuracy
                    best_thresholds = {
                        'open': round(open_th, 2),
                        'partial': round(partial_th, 2),
                        'closed': round(partial_th - 0.1, 2)
                    }
        
        return best_thresholds
    
    def _calculate_accuracy(
        self,
        predictions: List[str],
        outcomes: List[float]
    ) -> float:
        """
        Вычисляет точность классификации.
        """
        correct = 0
        for pred, outcome in zip(predictions, outcomes):
            if pred == 'open' and outcome > 0.6:
                correct += 1
            elif pred == 'partial' and 0.3 < outcome <= 0.6:
                correct += 1
            elif pred == 'closed' and outcome <= 0.3:
                correct += 1
        
        return correct / len(predictions) if predictions else 0
    
    def _validate_thresholds(
        self,
        thresholds: Dict,
        data: List[Dict]
    ) -> float:
        """
        Валидирует пороги на данных.
        """
        window_values = [d['window_value'] for d in data]
        outcomes = [d['actual_outcome'] for d in data]
        
        predictions = []
        for wv in window_values:
            if wv >= thresholds['open']:
                predictions.append('open')
            elif wv >= thresholds['partial']:
                predictions.append('partial')
            else:
                predictions.append('closed')
        
        return self._calculate_accuracy(predictions, outcomes)
