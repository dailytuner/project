	@echo "${YELLOW}🔍 Verifying latest backup...${RESET}"
	@LATEST=$$(ls -t backups/*.sql.gz | head -1); \
	echo "Checking: $$LATEST"; \
	gunzip -c $$LATEST | head -20 | grep -q "CREATE TABLE" && echo "${GREEN}✅ Backup valid${RESET}" || echo "${RED}❌ Backup corrupt${RESET}"
```

