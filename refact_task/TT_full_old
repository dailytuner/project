### 6.2. SchedulerService

```python
class SchedulerService:
    """
    Планировщик психометрического тестирования.
    """
    
    MMPI_INTERVAL_DAYS = 90  # 3 месяца
    IAT_INTERVAL_DAYS = 30   # 1 месяц
    
    async def get_schedule(self, user_id: int) -> TestSchedule:
        """
        Возвращает график тестирования пользователя.
        """
        schedule = await self._get_or_create_schedule(user_id)
        return schedule
    
    async def update_schedule(self, user_id: int, test_type: str):
        """
        Обновляет график после прохождения теста.
        """
        schedule = await self._get_or_create_schedule(user_id)
        
        if test_type == 'mmpi':
            schedule.last_mmpi_at = datetime.now()
            schedule.next_mmpi_due = schedule.last_mmpi_at + timedelta(days=self.MMPI_INTERVAL_DAYS)
        elif test_type == 'iat':
            schedule.last_iat_at = datetime.now()
            schedule.next_iat_due = schedule.last_iat_at + timedelta(days=self.IAT_INTERVAL_DAYS)
        
        await self._save_schedule(schedule)
    
    async def get_pending_tests(self, user_id: int) -> List[str]:
        """
        Возвращает список тестов, которые пора пройти.
        """
        schedule = await self._get_or_create_schedule(user_id)
        pending = []
        today = date.today()
        
        if schedule.last_mmpi_at is None or schedule.next_mmpi_due <= today:
            pending.append('mmpi')
        
        if schedule.last_iat_at is None or schedule.next_iat_due <= today:
            pending.append('iat')
        
        return pending
```

### 6.3. AstroContextClient (fallback-режим)

```python
class AstroContextClient:
    """
    HTTP-клиент к Astro Service.
    В фазах 1-3 работает в fallback-режиме (возвращает NULL).
    """
    
    def __init__(
        self,
        base_url: Optional[str] = None,
        api_key: Optional[str] = None,
        fallback_mode: bool = True,
        cache_ttl: int = 3600
    ):
        self.base_url = base_url
        self.api_key = api_key
        self.fallback_mode = fallback_mode
        self.cache = {}
        self.cache_ttl = cache_ttl
    
    async def get_context(self, user_id: int, at: datetime) -> AstroContext:
        """
        Возвращает астро-контекст.
        В fallback-режиме возвращает пустой контекст (все поля NULL).
        """
        if self.fallback_mode:
            logger.info(f"Fallback mode: returning empty context for user {user_id}")
            return AstroContext.empty()
        
        cache_key = f"{user_id}_{at.date()}"
        if cache_key in self.cache:
            return self.cache[cache_key]
        
        try:
            async with httpx.AsyncClient(timeout=5.0) as client:
                response = await client.get(
                    f"{self.base_url}/internal/v1/users/{user_id}/astro-context",
                    params={"at": at.isoformat()},
                    headers={"X-Internal-API-Key": self.api_key}
                )
                response.raise_for_status()
                context = AstroContext(**response.json())
                self.cache[cache_key] = context
                return context
        except Exception as e:
            logger.warning(f"Astro Service unavailable: {e}, returning empty context")
            return AstroContext.empty()
```

