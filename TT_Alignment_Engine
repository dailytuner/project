# core/template_renderer.py

class TemplateRenderer:
    """
    Рендерит объяснения из YAML-шаблонов.
    """
    
    def __init__(self, templates_path: str):
        self.templates_path = templates_path
        self.templates = self._load_all_templates()
    
    def _load_all_templates(self) -> Dict:
        """Загружает все YAML-шаблоны."""
        templates = {}
        for file in Path(self.templates_path).glob('*.yaml'):
            with open(file) as f:
                data = yaml.safe_load(f)
                templates[file.stem] = data
        return templates
    
    def render_all(
        self,
        coherence_level: str,
        house_alignments: List[Alignment],
        dasha_alignments: List[Alignment],
        retro_alignments: List[Alignment],
        element_alignments: List[Alignment],
        dissonances: List[Dissonance]
    ) -> str:
        """
        Генерирует полное объяснение.
        """
        parts = []
        
        # 1. Вступление
        parts.append(self._render_intro(coherence_level))
        
        # 2. Основные сопоставления
        if house_alignments:
            parts.append(self._render_alignments(house_alignments, 'house'))
        
        if dasha_alignments:
            parts.append(self._render_alignments(dasha_alignments, 'dasha'))
        
        if retro_alignments:
            parts.append(self._render_alignments(retro_alignments, 'retro'))
        
        if element_alignments:
            parts.append(self._render_alignments(element_alignments, 'element'))
        
        # 3. Диссонансы
        if dissonances:
            parts.append(self._render_dissonances(dissonances))
        
        return "\n\n".join(parts)
    
    def _render_intro(self, coherence_level: str) -> str:
        """Рендерит вступление."""
        messages = {
            'high': "Ваш астрологический и психологический профили хорошо согласованы.",
            'medium': "Ваши профили частично согласованы, есть интересные нюансы.",
            'low': "Ваши профили расходятся. Это может указывать на точки роста."
        }
        return messages.get(coherence_level, "Профили сопоставлены.")
    
    def _render_alignments(self, alignments: List[Alignment], type_name: str) -> str:
        """Рендерит сопоставления одного типа."""
        texts = []
        for a in alignments:
            template = self._get_template(type_name, a.factor, a.alignment_score)
            if template:
                text = self._render_template(template, a)
                texts.append(f"- {text}")
        
        type_names = {
            'house': "По домам",
            'dasha': "По дашам",
            'retro': "По ретроградности",
            'element': "По стихиям"
        }
        return f"{type_names.get(type_name, 'Сопоставления')}:\n" + "\n".join(texts)
