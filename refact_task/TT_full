### 4.2. State Management (Zustand/Redux)

```typescript
// store/useAppStore.ts

import { create } from 'zustand';
import {
  UserState,
  Achievements,
  OpportunityWindow,
  Recommendation
} from '../services/api';

interface AppState {
  // State  state: UserState | null;
  achievements: Achievements | null;
  window: OpportunityWindow | null;
  recommendations: Recommendation[];
  
  // Loading
  isLoading: boolean;
  error: string | null;
  
  // Actions
  fetchAll: (userId: string, date?: string) => Promise<void>;
  fetchState: (userId: string, date?: string) => Promise<void>;
  fetchAchievements: (userId: string, date?: string) => Promise<void>;
  fetchWindow: (userId: string, date?: string) => Promise<void>;
  fetchRecommendations: (userId: string, date?: string) => Promise<void>;
  submitFeedback: (feedback: FeedbackRequest) => Promise<void>;
  toggleRecommendation: (index: number) => void;
}

export const useAppStore = create<AppState>((set, get) => ({
  state: null,
  achievements: null,
  window: null,
  recommendations: [],
  isLoading: false,
  error: null,
  
  fetchAll: async (userId, date) => {
    set({ isLoading: true, error: null });
    try {
      const [state, achievements, window, recommendations] = await Promise.all([
        getState(userId, date),
        getAchievements(userId, date),
        getWindow(userId, date),
        getRecommendations(userId, date)
      ]);
      set({
        state,
        achievements,
        window,
        recommendations,
        isLoading: false
      });
    } catch (error) {
      set({ error: error.message, isLoading: false });
    }
  },
  
  fetchState: async (userId, date) => {
    const state = await getState(userId, date);
    set({ state });
  },
  
  // ... другие actions
  
  toggleRecommendation: (index) => {
    set((state) => ({
      recommendations: state.recommendations.map((rec, i) =>
        i === index ? { ...rec, completed: !rec.completed } : rec
      )
    }));
  },
  
  submitFeedback: async (feedback) => {
    await submitFeedback(feedback);
    // Обработка успеха
  }
}));
```

