# core/models.py
from pydantic import BaseModel, Field, field_validator, model_validator
from typing import Optional, List, Dict, Any
from datetime import datetime
import pytz
from calendar import monthrange


class LocationInput(BaseModel):
    """Модель ввода местоположения."""
    country: str = Field(..., min_length=1, max_length=100)
    region: Optional[str] = Field(None, min_length=1, max_length=200)
    city: str = Field(..., min_length=1, max_length=200)


class BirthData(BaseModel):
    """Модель входных данных рождения."""
    user_id: str = Field(..., max_length=50)
    
    # Вариант 1: Геокодинг
    location: Optional[LocationInput] = None
    
    # Вариант 2: Ручной ввод
    lat: Optional[float] = Field(None, ge=-90.0, le=90.0)
    lng: Optional[float] = Field(None, ge=-180.0, le=180.0)
    timezone: Optional[str] = None
    
    # Обязательные поля
    year: int = Field(..., ge=1900, le=2100)
    month: int = Field(..., ge=1, le=12)
    day: int = Field(..., ge=1, le=31)
    hour: int = Field(..., ge=0, le=23)
    minute: int = Field(..., ge=0, le=59)
    second: int = Field(0, ge=0, le=59)
    altitude: float = Field(0.0, ge=-1000, le=10000)
    
    @field_validator('timezone')
    @classmethod
    def validate_timezone(cls, v: Optional[str]) -> Optional[str]:
        if v is None:
            return None
        try:
            pytz.timezone(v)
        except pytz.exceptions.UnknownTimeZoneError:
            raise ValueError(f"Unknown timezone: {v}")
        return v
    
    @field_validator('day')
    @classmethod
    def validate_day(cls, v: int, info) -> int:
        month = info.data.get('month')
        year = info.data.get('year')
        if month and year:
            max_day = monthrange(year, month)[1]
            if v > max_day:
                raise ValueError(f"Day {v} is invalid for month {month}")
        return v
    
    @model_validator(mode='after')
    def validate_location(self) -> 'BirthData':
        has_location = self.location is not None
        has_coords = self.lat is not None and self.lng is not None
        if not has_location and not has_coords:
            raise ValueError("Either 'location' or 'lat/lng' must be provided")
        return self
    
    async def resolve_location(self) -> 'BirthData':
        """Геокодирует location, если координаты не указаны."""
        if self.lat is not None and self.lng is not None:
            return self
        if self.location is None:
            raise ValueError("No location provided")
        
        from services.geocoding import geocode_city
        result = await geocode_city(
            city=self.location.city,
            country=self.location.country,
            region=self.location.region
        )
        if result is None:
            raise ValueError(
                f"Город '{self.location.city}' не найден. "
                f"Уточните название или введите координаты вручную."
            )
        self.lat = result.lat
        self.lng = result.lng
        if self.timezone is None:
            self.timezone = result.timezone
        return self
    
    def to_utc_datetime(self) -> datetime:
        """Преобразует локальное время рождения в UTC."""
        from utils.time_module import TimeModule
        local_dt = datetime(
            year=self.year, month=self.month, day=self.day,
            hour=self.hour, minute=self.minute, second=self.second
        )
        return TimeModule.local_to_utc(local_dt, self.timezone)
