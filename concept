### 7.4. ШАГ 1: Кластеризация ВСЕХ тезисов

```python
def cluster_theses(theses):
    """
    Кластеризация ВСЕХ тезисов (без нормализации)
    """
    threshold = adaptive_threshold(theses)
    clusters = []
    used = set()
    
    for i, thesis1 in enumerate(theses):
        if i in used:
            continue
        
        cluster = [thesis1]
        used.add(i)
        
        for j, thesis2 in enumerate(theses[i+1:], start=i+1):
            if j in used:
                continue
            
            similarity = cosine_similarity(thesis1["sphere_vector"], thesis2["sphere_vector"])
            if similarity >= threshold:
                cluster.append(thesis2)
                used.add(j)
        
        if cluster:
            clusters.append(cluster)
    
    return clusters
```

### 7.5. ШАГ 2: Нормализация внутри каждого кластера

```python
def normalize_cluster(cluster, N_max=5):
    """
    Нормализация плотности внутри одного кластера
    """
    # Группировка по системам
    by_system = {}
    for thesis in cluster:
        system = thesis["system"]
        if system not in by_system:
            by_system[system] = []
        by_system[system].append(thesis)
    
    # Сортировка и обрезка по каждой системе
    normalized = []
    for system, system_theses in by_system.items():
        sorted_theses = sorted(system_theses, 
                             key=lambda t: t["confidence_final"]["value"], 
                             reverse=True)
        normalized.extend(sorted_theses[:N_max])
    
    return normalized
```

### 7.6. ШАГ 3: Расчет пересечений внутри кластеров

```python
def classify_intersection(cluster):
    """
    Классификация пересечения внутри кластера
    """
    n_systems = len(set(t["system"] for t in cluster))
    directions = [t["sign"] for t in cluster]
    strengths = [t["confidence_final"]["value"] for t in cluster]
    
    avg_strength = sum(strengths) / len(strengths)
    
    # 1. Vector Tension (конфликт)
    if any(d == 1 for d in directions) and any(d == -1 for d in directions):
        return {
            "type": "tension",
            "tension_index": calculate_tension_index(cluster),
            "strength": avg_strength,
            "sources": list(set(t["system"] for t in cluster))
        }
    
    # 2. Полное пересечение
    if n_systems >= 3 and avg_strength >= 0.8:
        return {
            "type": "full",
            "strength": 1 - (1 - strengths[0]) * (1 - strengths[1]) * (1 - strengths[2]),
            "tension_index": 0,
            "sources": list(set(t["system"] for t in cluster))
        }
    
    # 3. Частичное пересечение
    if n_systems >= 2 and avg_strength >= 0.5:
        return {
            "type": "partial",
            "strength": sum(s * s for s in strengths) / sum(strengths),
            "tension_index": 0,
            "sources": list(set(t["system"] for t in cluster))
        }
    
    # 4. Слабое пересечение
    return {
        "type": "weak",
        "strength": avg_strength,
        "tension_index": 0,
        "sources": list(set(t["system"] for t in cluster))
    }
```

### 7.7. Vector Tension

```python
def calculate_tension_index(cluster):
    positives = [t for t in cluster if t["sign"] == 1]
    negatives = [t for t in cluster if t["sign"] == -1]
    
    if not positives or not negatives:
        return 0
    
    strength_pos = sum(t["confidence_final"]["value"] for t in positives) / len(positives)
    strength_neg = sum(t["confidence_final"]["value"] for t in negatives) / len(negatives)
    
    tension_index = ((strength_pos + strength_neg) / 2) * 2
    
    return tension_index
```

### 7.8. Полный алгоритм интеграции

```python
def integrate_theses(all_theses):
    """
    Полный алгоритм: кластеризация → нормализация → пересечения
    """
    # ШАГ 1: Кластеризация ВСЕХ тезисов
    raw_clusters = cluster_theses(all_theses)
    
    # ШАГ 2: Нормализация внутри каждого кластера
    balanced_clusters = []
    for cluster in raw_clusters:
        normalized_cluster = normalize_cluster(cluster, N_max=5)
        balanced_clusters.append(normalized_cluster)
    
    # ШАГ 3: Расчет пересечений внутри каждого кластера
    intersections = []
    for cluster in balanced_clusters:
        intersection = classify_intersection(cluster)
        intersections.append(intersection)
    
    return intersections
```

