## 4. СЛОЙ 0: АСТРОНОМИЧЕСКОЕ ЯДРО

### 4.1. Враппер Swiss Ephemeris (ОБЯЗАТЕЛЬНО)

**Проблема:** `pyswisseph` возвращает кортежи, а не словари. Прямое использование невозможно.

**Решение:** Создать `EphemerisWrapper` в `core/ephemeris_wrapper.py`.

```python
# core/ephemeris_wrapper.py
import swisseph as swe
from typing import Dict, List, Optional
from dataclasses import dataclass
import structlog

logger = structlog.get_logger()

PLANET_IDS = {
    "Sun": swe.SUN, "Moon": swe.MOON, "Mercury": swe.MERCURY,
    "Venus": swe.VENUS, "Mars": swe.MARS, "Jupiter": swe.JUPITER,
    "Saturn": swe.SATURN, "Uranus": swe.URANUS, "Neptune": swe.NEPTUNE,
    "Pluto": swe.PLUTO, "NorthNode": swe.MEAN_NODE,
}

FLAGS = swe.FLG_SWIEPH | swe.FLG_SPEED


@dataclass
class PlanetPosition:
    """Модель позиции планеты."""
    longitude: float      # 0-360°
    latitude: float       # -90-90°
    distance: float       # AU
    speed_long: float     # °/день
    speed_lat: float      # °/день
    speed_dist: float     # AU/день
    
    @property
    def retrograde(self) -> bool:
        """True, если планета ретроградна."""
        return self.speed_long < 0


class EphemerisWrapper:
    """Враппер над Swiss Ephemeris с проверкой форматов."""
    
    @staticmethod
    def calc_ut(jd: float, planets: Optional[List[str]] = None) -> Dict[str, PlanetPosition]:
        """
        Рассчитывает позиции планет (UT).
        
        ВАЖНО: swe.calc_ut возвращает кортеж:
        - 3 элемента (без FLG_SPEED): (lon, lat, dist)
        - 6 элементов (с FLG_SPEED): (lon, lat, dist, speed_lon, speed_lat, speed_dist)
        
        Мы всегда используем FLG_SPEED, поэтому ожидаем 6 элементов.
        
        Args:
            jd: Юлианский день (UT)
            planets: Список имён планет (если None — все)
        
        Returns:
            Dict[str, PlanetPosition]: Словарь {имя_планеты: позиция}
        
        Raises:
            RuntimeError: Если Swiss Ephemeris вернул ошибку
        """
        if planets is None:
            planets = list(PLANET_IDS.keys())
        
        result = {}
        for name in planets:
            if name not in PLANET_IDS:
                continue
            
            try:
                pos = swe.calc_ut(jd, PLANET_IDS[name], FLAGS)
            except Exception as e:
                raise RuntimeError(f"Swiss Ephemeris error for {name}: {e}")
            
            if not isinstance(pos, (tuple, list)):
                raise RuntimeError(f"Unexpected return type for {name}: {type(pos)}")
            
            if len(pos) < 6:
                raise RuntimeError(
                    f"Expected 6 elements for {name}, got {len(pos)}. "
                    f"Check that FLG_SPEED flag is set."
                )
            
            result[name] = PlanetPosition(
                longitude=pos[0] % 360,
                latitude=pos[1],
                distance=pos[2],
                speed_long=pos[3],
                speed_lat=pos[4],
                speed_dist=pos[5]
            )
        
        # Южный узел = Северный + 180°
        if "NorthNode" in result:
            nn = result["NorthNode"]
            result["SouthNode"] = PlanetPosition(
                longitude=(nn.longitude + 180) % 360,
                latitude=-nn.latitude,
                distance=nn.distance,
                speed_long=nn.speed_long,
                speed_lat=-nn.speed_lat,
                speed_dist=nn.speed_dist
            )
        
        return result
    
    @staticmethod
    def get_sunrise(jd: float, lat: float, lng: float, altitude: float = 0) -> float:
        """
        Возвращает время восхода в часах после полуночи UT.
        
        ВАЖНО: swe.rise_transit принимает geopos как КОРТЕЖ:
        geopos = (longitude, latitude, altitude)
        """
        geopos = (lng, lat, altitude)
        rsmi = swe.CALC_RISE
        
        try:
            result = swe.rise_transit(jd, swe.SUN, rsmi, geopos, 0, 0, 0)
            if result[0] != 0:
                return 6.0  # Fallback
            return result[1][0]
        except Exception as e:
            logger.warning("sunrise_failed", error=str(e))
            return 6.0
    
    @staticmethod
    def get_sunset(jd: float, lat: float, lng: float, altitude: float = 0) -> float:
        """Возвращает время заката."""
        geopos = (lng, lat, altitude)
        rsmi = swe.CALC_SET
        
        try:
            result = swe.rise_transit(jd, swe.SUN, rsmi, geopos, 0, 0, 0)
            if result[0] != 0:
                return 18.0
            return result[1][0]
        except Exception as e:
            logger.warning("sunset_failed", error=str(e))
            return 18.0
    
    @staticmethod
    def get_ayanamsa(jd: float) -> float:
        """Возвращает айанамшу Lahiri."""
        return swe.ayanamsa(jd)
    
    @staticmethod
    def get_equation_of_time(jd: float) -> float:
        """Возвращает уравнение времени в минутах."""
        return swe.equation_of_time(jd)


ephemeris = EphemerisWrapper()
