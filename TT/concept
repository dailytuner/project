### 11.1. TimeModule — централизованное управление временем

```python
# utils/time_module.py
import pytz
from datetime import datetime, timedelta
from typing import Optional, Union
import logging

logger = logging.getLogger(__name__)

class TimeModule:
    """
    Централизованный модуль для работы со временем.
    Обеспечивает корректную обработку DST, часовых поясов и UTC.
    
    ВНИМАНИЕ: Все вызовы datetime.now() должны быть заменены на TimeModule.utc_now().
    """
    
    @staticmethod
    def local_to_utc(local_dt: datetime, timezone_str: str) -> datetime:
        """
        Преобразует локальное время в UTC с учетом DST.
        
        Args:
            local_dt: Локальное время (наивное или с TZ)
            timezone_str: IANA часовой пояс (например, "Europe/Kaliningrad")
        
        Returns:
            datetime: Время в UTC (с TZ=UTC)
        
        Raises:
            ValueError: Если часовой пояс не существует
        """
        try:
            tz = pytz.timezone(timezone_str)
        except pytz.exceptions.UnknownTimeZoneError as e:
            raise ValueError(f"Unknown timezone: {timezone_str}") from e
        
        # Если время наивное — локализуем
        if local_dt.tzinfo is None:
            local_dt = tz.localize(local_dt)
        
        # Конвертируем в UTC
        return local_dt.astimezone(pytz.UTC)
    
    @staticmethod
    def utc_now() -> datetime:
        """
        Возвращает текущее время в UTC.
        
        Используется вместо datetime.now() для избежания рассинхронизации.
        """
        return datetime.now(pytz.UTC)
    
    @staticmethod
    def localize_utc(dt: datetime) -> datetime:
        """
        Добавляет UTC временную зону к наивному datetime.
        
        Args:
            dt: Наивный datetime
        
        Returns:
            datetime: С временной зоной UTC
        """
        if dt.tzinfo is None:
            return pytz.UTC.localize(dt)
        return dt.astimezone(pytz.UTC)
    
    @staticmethod
    def to_julian_day(dt: datetime) -> float:
        """
        Преобразует datetime (с TZ) в юлианский день.
        
        Args:
            dt: datetime с временной зоной (предпочтительно UTC)
        
        Returns:
            float: Юлианский день
        
        Raises:
            ValueError: Если datetime не содержит временную зону
        """
        # Убеждаемся, что время в UTC
        if dt.tzinfo is None:
            raise ValueError("datetime must have timezone information")
        
        dt_utc = dt.astimezone(pytz.UTC)
        
        # Расчет JD
        year = dt_utc.year
        month = dt_utc.month
        day = dt_utc.day
        hour = dt_utc.hour
        minute = dt_utc.minute
        second = dt_utc.second + dt_utc.microsecond / 1_000_000
        
        # Алгоритм для григорианского календаря
        if month <= 2:
            year -= 1
            month += 12
        
        A = int(year / 100)
        B = 2 - A + int(A / 4)
        
        jd = int(365.25 * (year + 4716)) + int(30.6001 * (month + 1)) + day + B - 1524.5
        jd += (hour + minute/60 + second/3600) / 24
        
        return jd
    
    @staticmethod
    def from_julian_day(jd: float) -> datetime:
        """
        Преобразует юлианский день в datetime (UTC).
        
        Args:
            jd: Юлианский день
        
        Returns:
            datetime: datetime в UTC с временной зоной
        """
        # Алгоритм перевода JD в дату
        jd += 0.5
        Z = int(jd)
        F = jd - Z
        
        if Z < 2299161:
            A = Z
        else:
            alpha = int((Z - 1867216.25) / 36524.25)
            A = Z + 1 + alpha - int(alpha / 4)
        
        B = A + 1524
        C = int((B - 122.1) / 365.25)
        D = int(365.25 * C)
        E = int((B - D) / 30.6001)
        
        day = B - D - int(30.6001 * E)
        month = E - 1 if E < 14 else E - 13
        year = C - 4716 if month > 2 else C - 4715
        
        # Дробная часть (время)
        total_seconds = F * 86400
        hour = int(total_seconds // 3600)
        minute = int((total_seconds % 3600) // 60)
        second = int(total_seconds % 60)
        microsecond = int((total_seconds % 1) * 1_000_000)
        
        dt = datetime(
            year=year,
            month=month,
            day=day,
            hour=hour,
            minute=minute,
            second=second,
            microsecond=microsecond,
            tzinfo=pytz.UTC
        )
        
        return dt

# Глобальный экземпляр для удобства
time_module = TimeModule()

# Функции-обертки для удобства
def get_current_utc() -> datetime:
    """Возвращает текущее время в UTC."""
    return time_module.utc_now()

def local_to_utc(local_dt: datetime, timezone_str: str) -> datetime:
    """Преобразует локальное время в UTC."""
    return time_module.local_to_utc(local_dt, timezone_str)

def to_julian_day(dt: datetime) -> float:
    """Преобразует datetime в юлианский день."""
    return time_module.to_julian_day(dt)
