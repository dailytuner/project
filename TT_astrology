### 3.2. Simplified Transit Calculator

```python
# src/core/transit_core.py

import math
from datetime import date
from typing import Dict, Optional
from uuid import UUID

class SimplifiedTransitCore:
    """
    Упрощённый расчёт транзитов для Psychometry Service.
    Возвращает только силу планет и их положение.
    """
    
    # Знаки зодиака
    SIGNS = ['Aries', 'Taurus', 'Gemini', 'Cancer', 'Leo', 'Virgo',
             'Libra', 'Scorpio', 'Sagittarius', 'Capricorn', 'Aquarius', 'Pisces']
    
    # Экзальтации
    EXALTATIONS = {
        'Sun': 'Aries',
        'Moon': 'Taurus',
        'Mars': 'Capricorn',
        'Mercury': 'Virgo',
        'Jupiter': 'Cancer',
        'Venus': 'Pisces',
        'Saturn': 'Libra',
    }
    
    # Дебилитации
    DEBILITIES = {
        'Sun': 'Libra',
        'Moon': 'Scorpio',
        'Mars': 'Cancer',
        'Mercury': 'Pisces',
        'Jupiter': 'Capricorn',
        'Venus': 'Virgo',
        'Saturn': 'Aries',
    }
    
    # Сила планет по домам (упрощённо)
    HOUSE_POWER = {
        1: 1.0,  2: 0.7, 3: 0.4, 4: 1.0,
        5: 0.7,  6: 0.4, 7: 1.0, 8: 0.7,
        9: 0.4, 10: 1.0, 11: 0.7, 12: 0.4
    }
    
    def __init__(self, ephemeris_service):
        self.ephemeris_service = ephemeris_service
    
    async def calculate_transits(
        self,
        user_id: UUID,
        target_date: date,
        natal_houses: Optional[Dict] = None
    ) -> Dict:
        """
        Рассчитывает упрощённые транзиты.
        
        Returns:
            {
                "transits": {
                    "Saturn": {"sign": "Pisces", "degree": 12.5, "house": 8, "strength": 0.7},
                    ...
                },
                "planet_strengths": {"sun": 0.75, "moon": 0.62, ...}
            }
        """
        # 1. Получаем позиции планет
        positions = await self._get_planet_positions(target_date)
        
        # 2. Вычисляем дома (если есть натальная карта)
        houses = await self._get_houses(positions, natal_houses)
        
        # 3. Вычисляем силу планет
        strengths = await self._calculate_planet_strengths(positions, houses)
        
        # 4. Формируем ответ
        transits = {}
        for planet, pos in positions.items():
            sign = self.SIGNS[int(pos['longitude'] / 30)]
            degree = pos['longitude'] % 30
            
            transits[planet] = {
                'sign': sign,
                'degree': round(degree, 1),
                'house': houses.get(planet, 0),
                'strength': strengths.get(planet, 0.5),
                'retrograde': pos.get('speed', 0) < 0
            }
        
        return {
            'transits': transits,
            'planet_strengths': strengths
        }
    
    async def _get_planet_positions(self, target_date: date) -> Dict:
        """
        Получает позиции планет из кэша эфемерид.
        """
        planets = ['Sun', 'Moon', 'Mercury', 'Venus', 'Mars',
                   'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto']
        
        positions = {}
        for planet in planets:
            pos = await self.ephemeris_service.get_planet_position(
                planet=planet,
                date=target_date
            )
            positions[planet] = {
                'longitude': pos.longitude,
                'speed': pos.longitude_speed
            }
        
        return positions
    
    async def _get_houses(
        self,
        positions: Dict,
        natal_houses: Optional[Dict]
    ) -> Dict[str, int]:
        """
        Определяет дома для планет.
        Если натальная карта есть — использует её, иначе — эвристика.
        """
        if natal_houses and 'asc' in natal_houses:
            # Используем натальные дома
            asc = natal_houses['asc']
            houses = {}
            for planet, pos in positions.items():
                degree = pos['longitude']
                house = int(((degree - asc) % 360) / 30) + 1
                houses[planet] = house
            return houses
        
        # Упрощённая эвристика (без натальной карты)
        # Используем дома по умолчанию
        default_houses = {
            'Sun': 5, 'Moon': 4, 'Mercury': 3, 'Venus': 7,
            'Mars': 1, 'Jupiter': 9, 'Saturn': 10,
            'Uranus': 11, 'Neptune': 12, 'Pluto': 8
        }
        return default_houses
    
    async def _calculate_planet_strengths(
        self,
        positions: Dict,
        houses: Dict[str, int]
    ) -> Dict[str, float]:
        """
        Вычисляет силу планет (0..1) на основе знака и дома.
        """
        strengths = {}
        
        for planet, pos in positions.items():
            sign = self.SIGNS[int(pos['longitude'] / 30)]
            house = houses.get(planet, 0)
            
            # 1. Влияние экзальтации/дебилитации
            if sign == self.EXALTATIONS.get(planet):
                dignity = 1.0
            elif sign == self.DEBILITIES.get(planet):
                dignity = 0.2
            else:
                dignity = 0.6
            
            # 2. Влияние дома
            house_power = self.HOUSE_POWER.get(house, 0.5)
            
            # 3. Финальная сила
            strength = dignity * 0.6 + house_power * 0.4
            
            # 4. Корректировка на ретроградность
            if pos.get('speed', 0) < 0:
                strength *= 0.8
            
            strengths[planet] = round(max(0.1, min(1.0, strength)), 2)
        
        return strengths
