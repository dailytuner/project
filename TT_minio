### 4.2. LakeClient

```python
# src/clients/lake_client.py

import aioboto3
from typing import Optional, Dict, Any
import pyarrow as pa
import pyarrow.parquet as pq
from io import BytesIO

class LakeClient:
    """
    Клиент для работы с Data Lake (MinIO).
    """
    
    def __init__(
        self,
        endpoint: str,
        access_key: str,
        secret_key: str,
        bucket: str = "personal-assistant-lake",
        region: str = "us-east-1",
        use_ssl: bool = False
    ):
        self.endpoint = endpoint
        self.access_key = access_key
        self.secret_key = secret_key
        self.bucket = bucket
        self.region = region
        self.use_ssl = use_ssl
        self._session = aioboto3.Session()
    
    async def upload_parquet(
        self,
        key: str,
        data: Dict[str, Any],
        schema: Optional[pa.Schema] = None
    ) -> str:
        """
        Загружает данные в Parquet-формате в озеро.
        """
        # 1. Создаём таблицу из данных
        table = pa.Table.from_pydict(data, schema=schema)
        
        # 2. Сериализуем в Parquet (со сжатием Snappy)
        buffer = BytesIO()
        pq.write_table(
            table,
            buffer,
            compression='snappy',
            use_dictionary=True,
            write_statistics=True
        )
        buffer.seek(0)
        
        # 3. Загружаем в MinIO
        async with self._session.client(
            's3',
            endpoint_url=self._get_endpoint_url(),
            aws_access_key_id=self.access_key,
            aws_secret_access_key=self.secret_key,
            region_name=self.region
        ) as s3:
            await s3.put_object(
                Bucket=self.bucket,
                Key=key,
                Body=buffer.getvalue(),
                ContentType='application/octet-stream'
            )
        
        return f"s3://{self.bucket}/{key}"
    
    async def download_parquet(self, uri: str) -> Dict[str, Any]:
        """
        Скачивает данные из озера и возвращает как словарь.
        """
        # 1. Извлекаем ключ из URI
        key = uri.replace(f"s3://{self.bucket}/", "")
        
        # 2. Скачиваем
        async with self._session.client(
            's3',
            endpoint_url=self._get_endpoint_url(),
            aws_access_key_id=self.access_key,
            aws_secret_access_key=self.secret_key,
            region_name=self.region
        ) as s3:
            response = await s3.get_object(Bucket=self.bucket, Key=key)
            data = await response['Body'].read()
        
        # 3. Десериализуем
        buffer = BytesIO(data)
        table = pq.read_table(buffer)
        return table.to_pydict()
    
    async def list_files(
        self,
        prefix: str,
        recursive: bool = True
    ) -> List[str]:
        """
        Возвращает список файлов в префиксе.
        """
        async with self._session.client(
            's3',
            endpoint_url=self._get_endpoint_url(),
            aws_access_key_id=self.access_key,
            aws_secret_access_key=self.secret_key,
            region_name=self.region
        ) as s3:
            paginator = s3.get_paginator('list_objects_v2')
            pages = paginator.paginate(
                Bucket=self.bucket,
                Prefix=prefix,
                Delimiter='' if recursive else '/'
            )
            
            files = []
            async for page in pages:
                if 'Contents' in page:
                    files.extend([obj['Key'] for obj in page['Contents']])
            
            return files
    
    def _get_endpoint_url(self) -> str:
        """
        Возвращает URL эндпоинта.
        """
        protocol = "https" if self.use_ssl else "http"
        return f"{protocol}://{self.endpoint}"
```

### 4.3. DataLakeService

```python
# src/services/datalake_service.py

from datetime import datetime
from typing import Optional, Dict, Any
from uuid import UUID

from ..clients.lake_client import LakeClient

class DataLakeService:
    """
    Сервис для работы с Data Lake.
    """
    
    def __init__(self, lake_client: LakeClient):
        self.lake_client = lake_client
    
    # ============================================================
    # RAW DATA
    # ============================================================
    
    async def save_mmpi_raw(
        self,
        user_id: UUID,
        session_id: UUID,
        taken_at: datetime,
        idempotency_key: str,
        answers: Dict[str, bool],
        scoring_version: str = "v1.0"
    ) -> str:
        """
        Сохраняет сырые ответы MMPI в озеро.
        """
        key = self._get_raw_path('mmpi', user_id, taken_at)
        
        data = {
            'user_id': str(user_id),
            'session_id': str(session_id),
            'taken_at': int(taken_at.timestamp() * 1000),
            'idempotency_key': idempotency_key,
            'answers': answers,
            'scoring_version': scoring_version
        }
        
        return await self.lake_client.upload_parquet(key, data)
    
    async def save_iat_raw(
        self,
        user_id: UUID,
        session_id: UUID,
        taken_at: datetime,
        idempotency_key: str,
        test_type: str,
        blocks: List[Dict],
        session_seed: int,
        scoring_version: str = "v1.0"
    ) -> str:
        """
        Сохраняет сырые данные IAT в озеро.
        """
        key = self._get_raw_path('iat', user_id, taken_at)
        
        data = {
            'user_id': str(user_id),
            'session_id': str(session_id),
            'taken_at': int(taken_at.timestamp() * 1000),
            'idempotency_key': idempotency_key,
            'test_type': test_type,
            'blocks': blocks,
            'session_seed': session_seed,
            'scoring_version': scoring_version
        }
        
        return await self.lake_client.upload_parquet(key, data)
    
    # ============================================================
    # PROCESSED DATA
    # ============================================================
    
    async def save_user_state(
        self,
        user_id: UUID,
        calculated_at: datetime,
        state: Dict[str, Any]
    ) -> str:
        """
        Сохраняет обработанное состояние пользователя.
        """
        key = f"processed/states/year={calculated_at.year}/month={calculated_at.month:02d}/day={calculated_at.day:02d}/user_{user_id}_{calculated_at.strftime('%Y%m%d%H%M%S')}.parquet"
        
        data = {
            'user_id': str(user_id),
            'calculated_at': int(calculated_at.timestamp() * 1000),
            **state
        }
        
        return await self.lake_client.upload_parquet(key, data)
    
    async def save_achievement_indices(
        self,
        user_id: UUID,
        calculated_at: datetime,
        indices: Dict[str, Dict[str, Any]]
    ) -> str:
        """
        Сохраняет индексы достижения.
        """
        key = f"processed/indices/year={calculated_at.year}/month={calculated_at.month:02d}/day={calculated_at.day:02d}/user_{user_id}_{calculated_at.strftime('%Y%m%d%H%M%S')}.parquet"
        
        data = {
            'user_id': str(user_id),
            'calculated_at': int(calculated_at.timestamp() * 1000),
            'indices': indices
        }
        
        return await self.lake_client.upload_parquet(key, data)
    
    # ============================================================
    # ANALYTICS
    # ============================================================
    
    async def save_feedback(
        self,
        user_id: UUID,
        feedback_data: Dict[str, Any]
    ) -> str:
        """
        Сохраняет обратную связь от пользователя.
        """
        now = datetime.now()
        key = f"analytics/feedback/year={now.year}/month={now.month:02d}/day={now.day:02d}/feedback_{now.strftime('%Y%m%d%H%M%S')}.parquet"
        
        data = {
            'user_id': str(user_id),
            'timestamp': int(now.timestamp() * 1000),
            **feedback_data
        }
        
        return await self.lake_client.upload_parquet(key, data)
    
    # ============================================================
    # HELPERS
    # ============================================================
    
    def _get_raw_path(self, data_type: str, user_id: UUID, timestamp: datetime) -> str:
        """
        Возвращает путь для сырых данных.
        """
        return (
            f"raw/{data_type}/"
            f"year={timestamp.year}/"
            f"month={timestamp.month:02d}/"
            f"day={timestamp.day:02d}/"
            f"user_{user_id}_{timestamp.strftime('%Y%m%d%H%M%S')}.parquet"
        )
