const DissonanceItem: FC<{
  dissonance: Dissonance;
  expanded: boolean;
  onToggle: () => void;
}> = ({ dissonance, expanded, onToggle }) => {
  const severityColor =
    dissonance.severity > 0.8 ? 'text-red-600' :
    dissonance.severity > 0.6 ? 'text-orange-500' :
    'text-yellow-600';

  return (
    <div className="border border-gray-200 rounded-lg overflow-hidden">
