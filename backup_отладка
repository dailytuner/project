```

3. **Добавить мониторинг в Grafana:**
```sql
-- Метрика размера бэкапов
CREATE OR REPLACE VIEW backup_metrics AS
SELECT 
    name,
    size,
    modification_time,
    CASE 
        WHEN modification_time > NOW() - INTERVAL '1 day' THEN 'fresh'
        WHEN modification_time > NOW() - INTERVAL '2 days' THEN 'stale'
        ELSE 'critical'
    END as status
FROM pg_ls_dir('/backups') WITH ORDINALITY AS f(name)
WHERE name LIKE '%.sql.gz';
```

