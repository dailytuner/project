# core/calculations.py
def calculate_aspects(planets: dict) -> list:
    """
    Рассчитывает все аспекты между планетами.
    
    Использует орбисы по планетам (ASPECT_ORBS_BY_PLANET).
    """
    aspects = []
    planet_names = list(planets.keys())
    
    for i, p1_name in enumerate(planet_names):
        for p2_name in planet_names[i+1:]:
            p1 = planets[p1_name]
            p2 = planets[p2_name]
            
            angle = abs(p1["longitude"] - p2["longitude"])
            if angle > 180:
                angle = 360 - angle
            
            for aspect_name, aspect_angle in ASPECT_ANGLES.items():
                orb = get_orb(p1_name, aspect_name)
                diff = abs(angle - aspect_angle)
                
                if diff <= orb:
                    aspects.append({
                        "planet1": p1_name,
                        "planet2": p2_name,
                        "aspect_type": aspect_name,
                        "aspect_angle": aspect_angle,
                        "angle": angle,
                        "orb": diff,
                        "strength": 1 - (diff / orb)
                    })
    
    return aspects
