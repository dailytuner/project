# interpretation/arabic.py
from typing import Dict, Any, List, Callable
from core.models import Thesis

def calculate_arabic_part(
    asc: float,
    formula: Callable[[float, Dict[str, Any], Dict[str, Any]], float],
    planets: Dict[str, Any],
    points: Dict[str, Any]
) -> float:
    """
    Вычисляет арабскую часть по формуле.
    
    Args:
        asc: Долгота Асцендента
        formula: Функция, принимающая (asc, planets, points)
        planets: Словарь планет
        points: Словарь дополнительных точек (MC, DSC и т.д.)
    
    Returns:
        float: Долгота арабской части (0-360)
    """
    return formula(asc, planets, points) % 360

# Формулы арабских частей (лямбда-функции)
ARABIC_FORMULAS = {
    "Fortune": {
        "day": lambda asc, planets, points: asc + planets["Moon"]["longitude"] - planets["Sun"]["longitude"],
        "night": lambda asc, planets, points: asc + planets["Sun"]["longitude"] - planets["Moon"]["longitude"]
    },
    "Soul": {
        "day": lambda asc, planets, points: asc + planets["Sun"]["longitude"] - planets["Moon"]["longitude"],
        "night": lambda asc, planets, points: asc + planets["Moon"]["longitude"] - planets["Sun"]["longitude"]
    },
    "Career": {
        "day": lambda asc, planets, points: asc + points["MC"] - planets["Sun"]["longitude"],
        "night": lambda asc, planets, points: asc + points["MC"] - planets["Sun"]["longitude"]
    },
    "Marriage": {
        "day": lambda asc, planets, points: asc + points["DSC"] - planets["Venus"]["longitude"],
        "night": lambda asc, planets, points: asc + points["DSC"] - planets["Venus"]["longitude"]
    },
    "Children": {
        "day": lambda asc, planets, points: asc + planets["Saturn"]["longitude"] - planets["Jupiter"]["longitude"],
        "night": lambda asc, planets, points: asc + planets["Saturn"]["longitude"] - planets["Jupiter"]["longitude"]
    },
    "Death": {
        "day": lambda asc, planets, points: asc + planets["Saturn"]["longitude"] - planets["Mars"]["longitude"],
        "night": lambda asc, planets, points: asc + planets["Mars"]["longitude"] - planets["Saturn"]["longitude"]
    }
}

def generate_arabic_theses(core: Dict[str, Any]) -> List[Thesis]:
    """
    Генерирует тезисы арабских частей (жребиев).
    Максимум: ~10 тезисов.
    """
    theses = []
    
    is_day = core["is_daytime"]
    
    # Подготавливаем точки
    points = {
        "MC": core["houses"][10]["cusp"],
        "DSC": core["houses"][7]["cusp"]
    }
    
    for name, formulas in ARABIC_FORMULAS.items():
        formula = formulas["day"] if is_day else formulas["night"]
        longitude = calculate_arabic_part(
            asc=core["houses"][1]["cusp"],
            formula=formula,
            planets=core["planets"],
