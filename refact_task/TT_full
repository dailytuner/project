```python
# src/core/report_generator.py

from datetime import datetime, timedelta
from typing import Dict, List
from uuid import UUID

class ReportGenerator:
    """
    Генерация отчётов.
    """
    
    async def generate(
        self,
        report_type: str  # weekly, monthly
    ) -> Dict:
        """
        Генерирует отчёт указанного типа.
        """
        if report_type == 'weekly':
            return await self._generate_weekly()
        elif report_type == 'monthly':
            return await self._generate_monthly()
        else:
            return {'error': f'Unknown report type: {report_type}'}
    
    async def _generate_weekly(self) -> Dict:
        """
        Генерирует еженедельный отчёт.
        """
        # 1. Загружаем данные за неделю
        end_date = datetime.now()
        start_date = end_date - timedelta(days=7)
        
        feedback = await self._get_feedback_range(start_date, end_date)
        states = await self._get_states_range(start_date, end_date)
        
        # 2. Вычисляем метрики
        metrics = {
            'total_users': len(set(f['user_id'] for f in feedback)),
            'total_feedback': len(feedback),
            'avg_accuracy': self._avg_accuracy(feedback),
            'avg_rating': self._avg_rating(feedback),
            'coherence_trend': self._coherence_trend(states),
        }
        
        # 3. Формируем контент
        content = {
            'period': {
                'start': start_date.isoformat(),
                'end': end_date.isoformat()
            },
            'metrics': metrics,
            'top_categories': self._top_categories(feedback),
            'recommendations': self._generate_recommendations(metrics)
        }
        
        # 4. Сохраняем
        await self._save_report('weekly', start_date.date(), content, metrics)
        
        return content
    
    def _avg_accuracy(self, feedback: List[Dict]) -> float:
        """Вычисляет среднюю точность."""
        if not feedback:
            return 0.0
        return sum(f.get('accuracy', 0) for f in feedback) / len(feedback)
    
    def _avg_rating(self, feedback: List[Dict]) -> float:
        """Вычисляет средний рейтинг."""
        ratings = [f.get('rating') for f in feedback if f.get('rating')]
        if not ratings:
            return 0.0
        return sum(ratings) / len(ratings)
    
    def _coherence_trend(self, states: List[Dict]) -> str:
        """Определяет тренд когерентности."""
        if len(states) < 2:
            return 'insufficient_data'
        
        # Сравниваем первую и последнюю неделю
        first_week = [s for s in states if s['week'] == 0]
        last_week = [s for s in states if s['week'] == 6]
        
        if not first_week or not last_week:
            return 'insufficient_data'
        
        first_avg = sum(s['coherence'] for s in first_week) / len(first_week)
        last_avg = sum(s['coherence'] for s in last_week) / len(last_week)
        
        if last_avg > first_avg * 1.1:
            return 'improving'
        elif last_avg < first_avg * 0.9:
            return 'declining'
        else:
            return 'stable'
    
    def _top_categories(self, feedback: List[Dict]) -> List[Dict]:
        """Возвращает топ-категории по точности."""
        categories = {}
        for f in feedback:
            cat = f.get('category_id')
            if cat not in categories:
                categories[cat] = []
            categories[cat].append(f.get('accuracy', 0))
        
        sorted_categories = sorted(
            categories.items(),
            key=lambda x: sum(x[1]) / len(x[1]) if x[1] else 0,
            reverse=True
        )
        
        return [
            {
                'category': cat,
                'avg_accuracy': sum(vals) / len(vals) if vals else 0,
                'count': len(vals)
            }
            for cat, vals in sorted_categories[:3]
        ]
