from io import BytesIO
import pyarrow as pa
import pyarrow.parquet as pq

class LakeClient:
    """
    Клиент для взаимодействия с Data Lake (MinIO).
    """
    
    def __init__(
        self,
        endpoint: str,
        access_key: str,
        secret_key: str,
        bucket: str = "personal-assistant-lake"
    ):
        self.endpoint = endpoint
        self.access_key = access_key
        self.secret_key = secret_key
        self.bucket = bucket
        self._session = aioboto3.Session()
    
    async def upload_state(
        self,
        user_id: UUID,
        data: Dict[str, Any],
        timestamp: datetime
    ) -> str:
        """
        Сохраняет состояние пользователя в озеро.
        """
        key = (
            f"processed/states/"
            f"year={timestamp.year}/"
            f"month={timestamp.month:02d}/"
            f"day={timestamp.day:02d}/"
            f"user_{user_id}_{timestamp.strftime('%Y%m%d%H%M%S')}.parquet"
        )
        
        table = pa.Table.from_pydict(data)
        buffer = BytesIO()
        pq.write_table(table, buffer, compression='snappy')
        buffer.seek(0)
        
        async with self._session.client(
            's3',
            endpoint_url=f"http://{self.endpoint}",
            aws_access_key_id=self.access_key,
            aws_secret_access_key=self.secret_key
        ) as s3:
            await s3.put_object(
                Bucket=self.bucket,
                Key=key,
                Body=buffer.getvalue()
            )
        
        return f"s3://{self.bucket}/{key}"
