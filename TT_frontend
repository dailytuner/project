## 5. API интеграция

### 5.1. Psychometry API клиент

```typescript
// api/psychometry.ts

import { apiClient } from './client';
import {
  MMPIRequest,
  MMPIResponse,
  IATRequest,
  IATResponse,
  AlignmentResponse,
  AlignmentHistoryResponse,
} from './types';

export class PsychometryAPI {
  private readonly basePath = '/api/v1/psych';

  // Существующие API
  async submitMMPI(data: MMPIRequest): Promise<MMPIResponse> {
    return apiClient.post(`${this.basePath}/mmpi`, data);
  }

  async submitIAT(data: IATRequest): Promise<IATResponse> {
    return apiClient.post(`${this.basePath}/iat`, data);
  }

  async getStatus(userId: number): Promise<TestStatus> {
    return apiClient.get(`${this.basePath}/status`, { params: { user_id: userId } });
  }

  async getHistory(userId: number): Promise<TestHistory> {
    return apiClient.get(`${this.basePath}/history`, { params: { user_id: userId } });
  }

  // НОВЫЕ API для Alignment Engine
  async getAlignment(userId: number, date?: string): Promise<AlignmentResponse> {
    return apiClient.get(`${this.basePath}/alignment`, {
      params: { user_id: userId, date },
    });
  }

  async getAlignmentHistory(
    userId: number,
    period: '7d' | '30d' | '90d' | '1y' = '90d'
  ): Promise<AlignmentHistoryResponse> {
    return apiClient.get(`${this.basePath}/alignment/history`, {
      params: { user_id: userId, period },
    });
  }
}
