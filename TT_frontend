// pages/Alignment/components/DissonanceList.tsx

import { FC, useState } from 'react';
import { Dissonance } from '../../../types/alignment';

interface Props {
  dissonances: Dissonance[];
}

export const DissonanceList: FC<Props> = ({ dissonances }) => {
  const [expanded, setExpanded] = useState<string | null>(null);

  if (dissonances.length === 0) {
    return null;
  }

  return (
    <Card className="dissonance-list border-yellow-200 border-2">
      <div className="flex items-start gap-3">
        <div className="text-2xl">⚠️</div>
        <div className="flex-1">
          <h3 className="text-lg font-semibold text-yellow-700">
            Обнаружены расхождения
          </h3>
          <p className="text-sm text-gray-600">
            Ваши профили расходятся в {dissonances.length} аспектах.
            Это может указывать на точки роста.
          </p>
        </div>
      </div>

      <div className="mt-4 space-y-3">
        {dissonances.map((dissonance, index) => (
          <DissonanceItem
            key={index}
            dissonance={dissonance}
            expanded={expanded === String(index)}
            onToggle={() => setExpanded(expanded === String(index) ? null : String(index))}
          />
