### 5.4. Fallback стратегии

#### 5.4.1. Astro Client с Circuit Breaker

```python
# src/clients/astro_client.py

import json
import logging
import time
import httpx
from typing import Dict
from datetime import date

logger = logging.getLogger(__name__)


class CircuitBreaker:
    """Circuit Breaker для защиты от каскадных отказов."""
    
    def __init__(self, failure_threshold=3, recovery_timeout=60):
        self.failure_threshold = failure_threshold
        self.recovery_timeout = recovery_timeout
        self.failures = 0
        self.last_failure_time = None
        self.state = 'CLOSED'  # CLOSED, OPEN, HALF_OPEN
    
    def call(self, func, *args, **kwargs):
        if self.state == 'OPEN':
            if time.time() - self.last_failure_time > self.recovery_timeout:
                self.state = 'HALF_OPEN'
            else:
                raise CircuitBreakerOpenError("Circuit breaker is OPEN")
        
        try:
            result = func(*args, **kwargs)
            if self.state == 'HALF_OPEN':
                self.state = 'CLOSED'
                self.failures = 0
            return result
        except Exception as e:
            self.failures += 1
            self.last_failure_time = time.time()
            if self.failures >= self.failure_threshold:
                self.state = 'OPEN'
            raise


class CircuitBreakerOpenError(Exception):
    """Исключение при открытом Circuit Breaker."""
    pass


class AstroClient:
    """
    Клиент для Astro Service с fallback для Redis и Circuit Breaker.
    """
    
    def __init__(self, base_url: str, redis_client, api_key: str):
        self.base_url = base_url
        self.redis = redis_client
        self.api_key = api_key
        self.circuit_breaker = CircuitBreaker()
        self._client = httpx.AsyncClient(timeout=5.0)
    
    async def get_astro_context(self, user_id: int, target_date: date) -> Dict:
        """
        1. Пробует Redis (быстро)
        2. Fallback — прямой запрос к Astro Service с Circuit Breaker
        3. Записывает в Redis для следующих запросов
        """
        key = f"astro:{user_id}:{target_date.isoformat()}"
        
        # 1. Redis
        cached = self.redis.get(key)
        if cached:
            logger.debug(f"Cache hit for {key}")
            return json.loads(cached)
        
        # 2. Fallback через Circuit Breaker
        logger.warning(f"Cache miss for {key}, fetching from Astro Service")
        try:
            result = await self.circuit_breaker.call(
                self._fetch_from_astro, user_id, target_date
            )
            
            # 3. Записываем в Redis
            self.redis.setex(key, 48 * 3600, json.dumps(result))
            return result
            
        except (CircuitBreakerOpenError, Exception) as e:
            logger.error(f"Failed to fetch astro context: {e}")
            return self._get_neutral_context()
    
    async def _fetch_from_astro(self, user_id: int, target_date: date) -> Dict:
        """Прямой запрос к Astro Service."""
        biorhythms = await self._get_biorhythms(user_id, target_date)
        transits = await self._get_transits(user_id, target_date)
        boosts = await self._get_seasonal_boosts(target_date)
        
        return {
            'biorhythms': biorhythms,
            'transits': transits,
            'seasonal_boosts': boosts
        }
    
    async def _get_biorhythms(self, user_id: int, target_date: date) -> Dict:
        response = await self._client.get(
            f"{self.base_url}/internal/v4/users/{user_id}/biorhythms",
            params={"date": target_date.isoformat()},
            headers={"X-Internal-API-Key": self.api_key}
        )
        response.raise_for_status()
        return response.json()
    
    async def _get_transits(self, user_id: int, target_date: date) -> Dict:
        response = await self._client.get(
            f"{self.base_url}/internal/v4/users/{user_id}/transits",
            params={"date": target_date.isoformat()},
            headers={"X-Internal-API-Key": self.api_key}
        )
        response.raise_for_status()
        return response.json()
    
    async def _get_seasonal_boosts(self, target_date: date) -> Dict:
        response = await self._client.get(
            f"{self.base_url}/internal/v4/seasonal-boosts",
            params={"date": target_date.isoformat()},
            headers={"X-Internal-API-Key": self.api_key}
        )
        response.raise_for_status()
        return response.json()
    
    def _get_neutral_context(self) -> Dict:
        """Нейтральный контекст при недоступности Astro Service."""
        return {
            'biorhythms': {'physical': 0, 'emotional': 0, 'intellectual': 0},
            'transits': {},
            'seasonal_boosts': {'family': 0, 'work': 0, 'health': 0, 'self': 0}
        }
    
    async def health_check(self) -> bool:
        """Проверка доступности Astro Service."""
        try:
            response = await self._client.get(f"{self.base_url}/health", timeout=2.0)
            return response.status_code == 200
        except Exception:
            return False
