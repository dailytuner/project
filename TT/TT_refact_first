# src/core/state_synthesizer.py

from typing import Dict, Optional
from datetime import date, timedelta

class StateSynthesizer:
    """
    Синтез состояния из быстрого опросника + астро-контекста.
    """
    
    def synthesize(
        self,
        quick_check: Dict,
        astro_context: Dict,
        full_profile: Optional[Dict] = None
    ) -> Dict:
        """
        Возвращает состояние: 3 метрики + уровень + сводка.
        """
        # 1. Нормализуем быстрый опросник (1-5 → 0-1)
        energy = (quick_check.get('energy', 3) - 1) / 4
        anxiety = (quick_check.get('anxiety', 3) - 1) / 4
        emotional = (quick_check.get('emotional', 3) - 1) / 4
        
        # 2. Корректировка по биоритмам
        if astro_context and 'biorhythms' in astro_context:
            bio = astro_context['biorhythms']
            energy = energy * 0.7 + ((bio.get('physical', 0) + 1) / 2) * 0.3
            emotional = emotional * 0.7 + ((bio.get('emotional', 0) + 1) / 2) * 0.3
        
        # 3. Осознанность
        awareness = self._get_awareness(full_profile, {
            'energy_score': energy,
            'anxiety_score': anxiety,
            'emotional_score': emotional
        })
        
        # 4. Уровень
        avg = (energy + (1 - anxiety) + emotional) / 3
        if avg >= 0.7:
            level = 'HIGH'
        elif avg >= 0.4:
            level = 'MEDIUM'
        else:
            level = 'LOW'
        
        # 5. Сводка
        summary = self._generate_summary(energy, anxiety, emotional, level)
        
        return {
            'energy_score': round(energy, 3),
            'anxiety_score': round(anxiety, 3),
            'emotional_score': round(emotional, 3),
            'state_level': level,
            'state_summary': summary,
            'awareness': awareness
        }
    
    def _get_awareness(self, full_profile, state) -> Dict:
        """Осознанность из полного профиля или эвристика."""
        if full_profile and full_profile.get('taken_at'):
            if (date.today() - full_profile['taken_at'].date()).days <= 30:
                return {
                    'level': full_profile.get('awareness_level', 'MEDIUM'),
                    'tip': full_profile.get('awareness_tip', 'Практика наблюдения'),
                    'practice': full_profile.get('awareness_practice', '5 минут дыхания')
                }
        
        # Fallback
        emotional = state.get('emotional_score', 0.5)
        if emotional > 0.6:
            return {
                'level': 'HIGH',
                'tip': 'Вы хорошо различаете свои чувства',
                'practice': 'Продолжайте наблюдать'
            }
        elif emotional > 0.3:
            return {
                'level': 'MEDIUM',
                'tip': 'Вам помогает практика наблюдения',
                'practice': '5 минут дыхания'
            }
        else:
            return {
                'level': 'LOW',
                'tip': 'Начните с простого наблюдения',
                'practice': 'Упражнение "Здесь и сейчас"'
            }
    
    def _generate_summary(self, energy, anxiety, emotional, level):
        """Генерирует текстовую сводку."""
        parts = []
        if energy >= 0.6:
            parts.append("энергия на подъёме")
        elif energy <= 0.3:
            parts.append("энергия снижена")
        else:
            parts.append("энергия в норме")
        
        if anxiety >= 0.6:
            parts.append("тревожность повышена")
        elif anxiety <= 0.3:
            parts.append("тревожность снижена")
        else:
            parts.append("тревожность умеренная")
        
        if emotional >= 0.6:
            parts.append("эмоциональный фон повышен")
        elif emotional <= 0.3:
            parts.append("эмоциональный фон снижен")
        else:
            parts.append("эмоциональный фон в норме")
        
        return f"Ваше состояние: {', '.join(parts)}. Уровень: {level.lower()}."
