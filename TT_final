# detect_patterns — полная реализация (ИСПРАВЛЕНО)
# ============================================================
def detect_patterns(aspects: list, planets: dict) -> list:
    """Определяет астрологические паттерны."""
    patterns = []
    patterns.extend(_detect_stellium(planets))
    patterns.extend(_detect_grand_trine(aspects, planets))
    patterns.extend(_detect_t_square(aspects))
    patterns.extend(_detect_yod(aspects))
    return patterns


def _detect_stellium(planets: dict) -> list:
    """Stellium: 3+ планет в одном знаке или доме."""
    patterns = []
    
    sign_groups: Dict[str, List[str]] = {}
    for name, data in planets.items():
        sign_groups.setdefault(data["sign"], []).append(name)
    
    for sign, planet_list in sign_groups.items():
        if len(planet_list) >= 3:
            patterns.append({
                "type": "Stellium",
                "apex": None,
                "planets": planet_list,
                "strength": min(1.0, len(planet_list) / 5),
                "details": {"sign": sign, "count": len(planet_list), "by": "sign"}
            })
    
    house_groups: Dict[int, List[str]] = {}
    for name, data in planets.items():
        house_groups.setdefault(data["house"], []).append(name)
    
    for house, planet_list in house_groups.items():
        if len(planet_list) >= 3:
            patterns.append({
                "type": "Stellium",
                "apex": None,
                "planets": planet_list,
                "strength": min(1.0, len(planet_list) / 5),
                "details": {"house": house, "count": len(planet_list), "by": "house"}
            })
    
    return patterns


def _detect_grand_trine(aspects: list, planets: dict = None) -> list:
    """Grand Trine: 3 планеты, соединённые тринами (цикл длины 3)."""
    trine_edges = set()
    for a in aspects:
        if a["aspect_type"] == "trine":
            p1, p2 = a["planet1"], a["planet2"]
            trine_edges.add((min(p1, p2), max(p1, p2)))
    
    patterns = []
    planets_in_trines = set()
    for p1, p2 in trine_edges:
        planets_in_trines.add(p1)
        planets_in_trines.add(p2)
    
    planet_list = sorted(planets_in_trines)
    for i, p1 in enumerate(planet_list):
        for j, p2 in enumerate(planet_list[i+1:], start=i+1):
            edge12 = (min(p1, p2), max(p1, p2))
            if edge12 not in trine_edges:
                continue
            for p3 in planet_list[j+1:]:
                edge13 = (min(p1, p3), max(p1, p3))
                edge23 = (min(p2, p3), max(p2, p3))
                if edge13 in trine_edges and edge23 in trine_edges:
                    element = _get_element_for_trine(p1, p2, p3, planets)
                    patterns.append({
                        "type": "Grand Trine",
                        "apex": None,
                        "planets": [p1, p2, p3],
                        "strength": 0.9,
                        "details": {"element": element}
                    })
    
    return patterns


def _get_element_for_trine(p1: str, p2: str, p3: str, planets: dict = None) -> str:
    """Определяет стихию Grand Trine по знакам планет."""
    if planets is None:
        return "unknown"
    
    SIGNS_TO_ELEMENTS = {
        "Aries": "Fire", "Leo": "Fire", "Sagittarius": "Fire",
        "Taurus": "Earth", "Virgo": "Earth", "Capricorn": "Earth",
        "Gemini": "Air", "Libra": "Air", "Aquarius": "Air",
        "Cancer": "Water", "Scorpio": "Water", "Pisces": "Water",
    }
    
    elements = set()
    for p in (p1, p2, p3):
        if p in planets:
            sign = planets[p].get("sign")
            if sign in SIGNS_TO_ELEMENTS:
                elements.add(SIGNS_TO_ELEMENTS[sign])
    
    return elements.pop() if len(elements) == 1 else "mixed"


def _detect_t_square(aspects: list) -> list:
    """T-Square: 2 оппозиции + 2 квадрата, образующие T."""
    oppositions = [(a["planet1"], a["planet2"]) for a in aspects if a["aspect_type"] == "opposition"]
    squares_set = set()
    for a in aspects:
        if a["aspect_type"] == "square":
            p1, p2 = a["planet1"], a["planet2"]
            squares_set.add((min(p1, p2), max(p1, p2)))
    
    patterns = []
    for opp_p1, opp_p2 in oppositions:
        candidates = set()
        for p1, p2 in squares_set:
            candidates.add(p1)
            candidates.add(p2)
        
        for apex in candidates:
            if apex in (opp_p1, opp_p2):
                continue
            sq1 = (min(apex, opp_p1), max(apex, opp_p1)) in squares_set
            sq2 = (min(apex, opp_p2), max(apex, opp_p2)) in squares_set
            if sq1 and sq2:
                patterns.append({
                    "type": "T-Square",
                    "apex": apex,
                    "planets": [opp_p1, opp_p2, apex],
                    "strength": 0.85,
                    "details": {"opposition": [opp_p1, opp_p2]}
                })
    
    return patterns


def _detect_yod(aspects: list) -> list:
    """Yod (Перст Судьбы): 2 квинконса + 1 секстиль."""
    quincunxes_set = set()
    for a in aspects:
        if a["aspect_type"] == "quincunx":
            p1, p2 = a["planet1"], a["planet2"]
            quincunxes_set.add((min(p1, p2), max(p1, p2)))
    
    sextiles = [(a["planet1"], a["planet2"]) for a in aspects if a["aspect_type"] == "sextile"]
    
    patterns = []
    for p1, p2 in sextiles:
        candidates = set()
        for a, b in quincunxes_set:
            candidates.add(a)
            candidates.add(b)
        
        for apex in candidates:
            if apex in (p1, p2):
                continue
            q1 = (min(apex, p1), max(apex, p1)) in quincunxes_set
            q2 = (min(apex, p2), max(apex, p2)) in quincunxes_set
            if q1 and q2:
                patterns.append({
                    "type": "Yod",
                    "apex": apex,
                    "planets": [p1, p2, apex],
                    "strength": 0.8,
                    "details": {"sextile": [p1, p2]}
                })
    
    return patterns
