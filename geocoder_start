#### 3.4 Добавить поддержку латиницы:

```python
def _normalize_city_name(self, city_name: str) -> str:
    """Нормализация названия с поддержкой кириллицы и латиницы"""
    import transliterate
    
    normalized = city_name.strip().lower().replace('ё', 'е')
    
    # Если все символы латиница - пробуем транслитерировать
    if normalized.isascii() and not normalized.isdigit():
        try:
            # Пробуем транслитерировать с латиницы на кириллицу
            normalized_cyr = transliterate.translit(normalized, 'ru', reversed=True)
            # Сохраняем оба варианта для поиска
            return normalized, normalized_cyr
        except:
            pass
    
    return normalized

# В методе geocode нужно проверять оба варианта
