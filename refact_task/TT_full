        "timestamp": datetime.now().isoformat()
    }


@router.post("/thresholds/tune")
async def tune_thresholds(
    service: TunerService = Depends(get_tuner_service)
):
    """
    Настроить пороги окон.
    """
    result = await service.tune_thresholds()
    
    return {
        "success": True,
        "result": result,
        "timestamp": datetime.now().isoformat()
    }


@router.post("/validate")
async def validate_config(
    config: Dict,
    n_folds: int = 5,
    service: TunerService = Depends(get_tuner_service)
):
    """
    Валидировать конфигурацию.
    """
    result = await service.validate_configuration(config, n_folds)
    
    return {
        "success": True,
        "validation": result,
        "timestamp": datetime.now().isoformat()
    }


@router.post("/simulate")
async def run_simulation(
    config: Dict,
    simulation_type: str = "what_if",
    service: TunerService = Depends(get_tuner_service)
):
    """
    Запустить симуляцию.
    """
    result = await service.run_simulation(config, simulation_type)
    
    return {
        "success": True,
        "simulation": result,
        "timestamp": datetime.now().isoformat()
    }


@router.post("/apply")
async def apply_config(
    config: Dict,
    service: TunerService = Depends(get_tuner_service)
):
    """
    Применить конфигурацию в продакшен.
    """
    result = await service.apply_configuration(config)
    
    return {
        "success": True,
        "result": result,
        "timestamp": datetime.now().isoformat()
