        sign = get_sign(longitude)
        house = get_house(longitude, core["houses"])
        vector = get_arabic_vector(name, sign, house)
        direction = get_arabic_direction(name, longitude, core)
        
        base_conf = 0.5
        if house in [1, 4, 7, 10]:  # угловые дома
            base_conf += 0.2
        if house in [2, 5, 8, 11]:  # последующие дома
            base_conf += 0.1
        
        thesis = Thesis(
            id=f"A_{name}",
            system="arabic",
            sphere_vector=vector,
            sign=direction,
            claim=f"{name} в {sign} в {house} доме",
