    psych_value: Optional[float]
    expected: str  # 'high', 'low', 'variable'
    actual: Optional[str]  # 'high', 'low', 'normal'
    alignment_score: float  # 0-1
    confidence: float  # 0-1
    interpretation: Optional[str]
    knowledge_base_id: Optional[int]

class Dissonance(BaseModel):
    """Диссонанс (расхождение)."""
    type: str
    source: str
    expected_state: str
    actual_state: str
    psych_scale: str
    severity: float  # 0-1
    hypothesis: str
    resolved: bool = False

class BaseAligner(ABC):
    """Базовый класс для всех сопоставителей."""
    
    @abstractmethod
    async def align(
        self,
        astro: 'AstroProfile',
        psych: 'PsychProfile',
        knowledge_base: List['KnowledgeBaseEntry']
    ) -> List[Alignment]:
        """Сопоставляет профили."""
        pass
    
    @property
    @abstractmethod
    def type_name(self) -> str:
        """Тип сопоставителя."""
        pass
