const PracticeModal: React.FC = () => {
  const [isRunning, setIsRunning] = useState(false);
  const [seconds, setSeconds] = useState(15);
  const [thought, setThought] = useState('');
  const [isComplete, setIsComplete] = useState(false);
  
  const { mutate: savePractice, isLoading } = useSavePractice();
  
  const startPractice = () => {
    setIsRunning(true);
    setSeconds(15);
    setIsComplete(false);
  };
  
  useEffect(() => {
    let timer: NodeJS.Timeout;
    if (isRunning && seconds > 0) {
      timer = setInterval(() => {
        setSeconds(prev => prev - 1);
      }, 1000);
    } else if (seconds === 0 && isRunning) {
      setIsRunning(false);
      setIsComplete(true);
    }
    return () => clearInterval(timer);
  }, [isRunning, seconds]);
  
  const handleSave = () => {
    savePractice({
      thought,
      duration: 15 - seconds,
    });
  };
  
  return (
    <Modal isOpen={isOpen} onClose={onClose}>
      <div className="p-6 text-center">
        <h2 className="text-2xl font-bold mb-2">🧘 Практика «Пауза»</h2>
        <p className="text-gray-600 mb-6">
          Сделайте паузу на 15 секунд, чтобы заметить, что происходит в вашем сознании.
        </p>
        
        {/* Таймер */}
        <div className="relative w-32 h-32 mx-auto mb-6">
          <svg className="w-32 h-32 transform -rotate-90">
            <circle
              cx="64" cy="64" r="56"
              className="text-gray-200 stroke-current"
              strokeWidth="8"
              fill="none"
            />
            <circle
              cx="64" cy="64" r="56"
              className={`text-indigo-500 stroke-current transition-all duration-1000 ${
                isRunning ? 'stroke-dasharray-[calculate]' : ''
              }`}
              strokeWidth="8"
              fill="none"
              strokeDasharray={`${seconds * 3.73} 352`}
              strokeLinecap="round"
            />
          </svg>
          <div className="absolute inset-0 flex items-center justify-center">
            <div className="text-4xl font-bold">
              {isRunning || isComplete ? seconds : '15'}
            </div>
          </div>
        </div>
        
        {/* Кнопка */}
        {!isRunning && !isComplete && (
          <button
            onClick={startPractice}
            className="px-6 py-3 bg-indigo-500 text-white rounded-lg hover:bg-indigo-600 transition-colors"
          >
            🧘 Сделать паузу
          </button>
        )}
        
        {isRunning && (
          <div className="text-sm text-gray-500">
            Осталось {seconds} секунд...
          </div>
        )}
        
        {/* Поле для мысли */}
        {isComplete && (
          <div className="mt-4 text-left">
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Что я сейчас автоматически подумал?
            </label>
            <textarea
              value={thought}
              onChange={(e) => setThought(e.target.value)}
              className="w-full p-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
              rows={2}
              placeholder="Напишите свою мысль..."
            />
            <button
              onClick={handleSave}
              disabled={isLoading}
              className="mt-2 w-full py-2 bg-indigo-500 text-white rounded-lg hover:bg-indigo-600 transition-colors disabled:opacity-50"
            >
              {isLoading ? 'Сохранение...' : 'Сохранить'}
            </button>
          </div>
        )}
      </div>
    </Modal>
  );
};
