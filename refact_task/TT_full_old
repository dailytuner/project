## 6. Бизнес-логика

### 6.1. AnalyticsService

```python
# services/analytics_service.py

class AnalyticsService:
    """
    Оркестрация аналитического процесса.
    """
    
    def __init__(
        self,
        dissonance_miner: DissonanceMiner,
        pattern_analyzer: PatternAnalyzer,
        knowledge_updater: KnowledgeUpdater,
        snapshot_writer: SnapshotWriter,
        stats_calculator: StatsCalculator
    ):
        self.dissonance_miner = dissonance_miner
        self.pattern_analyzer = pattern_analyzer
        self.knowledge_updater = knowledge_updater
        self.snapshot_writer = snapshot_writer
        self.stats_calculator = stats_calculator
    
    async def run_weekly(self) -> Dict:
        """
        Еженедельный запуск (понедельник, 04:00).
        - Сбор диссонансов за неделю
        - Анализ паттернов
        - Формирование гипотез
        """
        start_time = datetime.now()
        logger.info("Starting WEEKLY dissonance mining...")
        
        try:
            async with async_session() as session:
                # 1. Собираем диссонансы за неделю
                since = datetime.now() - timedelta(days=7)
                groups = await self.dissonance_miner.mine_dissonances(session, since)
                logger.info(f"Found {len(groups)} dissonance groups")
                
                # 2. Анализируем паттерны
                patterns = await self.pattern_analyzer.analyze(groups)
                significant = [p for p in patterns if p.significance > 0.5]
                logger.info(f"Found {len(significant)} significant patterns")
                
                # 3. Сохраняем паттерны
                await self._save_patterns(session, significant)
                
                # 4. Записываем снапшот
                await self.snapshot_writer.write_weekly_snapshot(
                    session, groups, patterns
                )
                
                # 5. Логируем
                await self._log_execution(session, 'weekly', success=True)
            
            return {
                'status': 'success',
                'dissonance_groups': len(groups),
                'patterns_found': len(significant)
            }
            
        except Exception as e:
            logger.error(f"Weekly job failed: {e}", exc_info=True)
            await self._log_execution(session, 'weekly', success=False, error=str(e))
            return {'status': 'failed', 'error': str(e)}
    
    async def run_monthly(self) -> Dict:
        """
        Ежемесячный запуск (1-е число, 05:00).
        - Обновление базы знаний
        - Корректировка весов и confidence
        """
        start_time = datetime.now()
        logger.info("Starting MONTHLY knowledge update...")
        
        try:
            async with async_session() as session:
                # 1. Загружаем все непросмотренные паттерны
                patterns = await self._load_pending_patterns(session)
                logger.info(f"Found {len(patterns)} pending patterns")
                
                if not patterns:
                    return {'status': 'skipped', 'reason': 'no_patterns'}
                
                # 2. Обновляем базу знаний
                updates = await self.knowledge_updater.update(session, patterns)
                logger.info(f"Updated {len(updates)} knowledge base entries")
                
                # 3. Записываем снапшот
                await self.snapshot_writer.write_monthly_snapshot(
                    session, updates
                )
                
                # 4. Отмечаем паттерны как обработанные
                await self._mark_patterns_processed(session, patterns)
                
                # 5. Логируем
                await self._log_execution(session, 'monthly', success=True)
            
            return {
                'status': 'success',
                'patterns_processed': len(patterns),
                'knowledge_updated': len(updates)
            }
            
        except Exception as e:
            logger.error(f"Monthly job failed: {e}", exc_info=True)
            await self._log_execution(session, 'monthly', success=False, error=str(e))
            return {'status': 'failed', 'error': str(e)}
    
    async def run_quarterly(self) -> Dict:
        """
        Ежеквартальный запуск (1-е число квартала, 06:00).
        - Полный отчёт
        - Снапшот в Data Lake
        - Оповещение
        """
        start_time = datetime.now()
        logger.info("Starting QUARTERLY report generation...")
        
        try:
            async with async_session() as session:
                # 1. Собираем статистику
                stats = await self.stats_calculator.calculate_quarterly_stats(session)
                
                # 2. Генерируем полный снапшот
                lake_uri = await self.snapshot_writer.write_quarterly_snapshot(
                    session, stats
                )
                
                # 3. Генерируем отчёт
                report = await self._generate_report(session, stats, lake_uri)
                
                # 4. Отправляем уведомление
                await self.notifier.send_report(report)
                
                # 5. Логируем
                await self._log_execution(session, 'quarterly', success=True)
            
            return {
                'status': 'success',
                'lake_uri': lake_uri,
                'report_generated': True
            }
            
        except Exception as e:
            logger.error(f"Quarterly job failed: {e}", exc_info=True)
            await self._log_execution(session, 'quarterly', success=False, error=str(e))
            return {'status': 'failed', 'error': str(e)}
