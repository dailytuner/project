FROM python:3.11-slim

# ✅ 1. УСТАНОВКА СИСТЕМНЫХ ПАКЕТОВ (БЕЗ libswe-dev!)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc g++ \
    curl \
    tini \
    wget \
    ca-certificates \
    swig \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# ✅ 2. SwissEph файлы (НЕ libswe2.0!)
COPY ephe/ /usr/share/swisseph/
RUN ls -la /usr/share/swisseph/ && echo "✅ Ephemeris files OK"

WORKDIR /app

COPY requirements-backend.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --timeout 900 -r requirements-backend.txt

COPY backend/ ./backend/

#RUN adduser --disabled-password --gecos '' appuser && \
#    usermod -aG root appuser && \
#    chown -R appuser:appuser /app
#USER appuser

EXPOSE 8000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "backend.assistant_api:app", "--host", "0.0.0.0", "--port", "8000"]

