      <h1>История когерентности</h1>
      <p className="text-gray-500">Как изменялось сопоставление ваших профилей</p>

      {/* График когерентности */}
      <CoherenceChart trajectory={history.trajectory} />

      {/* Статистика */}
      <div className="grid grid-cols-3 gap-4 mt-6">
        <StatCard
          label="Текущая когерентность"
          value={`${Math.round(history.trajectory[history.trajectory.length - 1]?.coherence_score * 100)}%`}
          trend={history.trend}
        />
        <StatCard
          label="Изменение"
          value={history.trend === 'improving' ? '📈 Растёт' : '📉 Падает'}
          color={history.trend === 'improving' ? 'text-green-600' : 'text-red-600'}
        />
        <StatCard
          label="Диссонансов"
          value={`${history.dissonance_evolution[history.dissonance_evolution.length - 1]?.count || 0}`}
          subtitle="в последнем периоде"
        />
      </div>
    </div>
  );
};

// Компонент графика
const CoherenceChart: FC<{ trajectory: TrajectoryPoint[] }> = ({ trajectory }) => {
  const chartRef = useRef(null);

  useEffect(() => {
    if (!chartRef.current) return;

    const ctx = chartRef.current.getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: trajectory.map(p => p.date),
        datasets: [{
          label: 'Когерентность',
          data: trajectory.map(p => p.coherence_score * 100),
          borderColor: '#4CAF50',
          backgroundColor: 'rgba(76, 175, 80, 0.1)',
          fill: true,
          tension: 0.3,
        }],
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'top' },
          tooltip: {
            callbacks: {
              label: (context) => {
                const point = trajectory[context.dataIndex];
                return `Score: ${Math.round(point.coherence_score * 100)}% (${point.coherence_level})`;
              }
            }
          }
        },
        scales: {
          y: {
            min: 0,
            max: 100,
            ticks: {
              callback: (value) => `${value}%`
            }
          }
        }
      }
    });
  }, [trajectory]);

  return <canvas ref={chartRef} />;
};
```

