# adjacent/biorhythms.py
import math
from typing import Dict, Any, List
from datetime import date
from adjacent.base import AdjacentSystem


class BiorhythmsSystem(AdjacentSystem):
    """
    Биоритмы (классические, 3 цикла).
    
    Циклы:
    - Физический: 23 дня
    - Эмоциональный: 28 дней
    - Интеллектуальный: 33 дня
    
    Формула: sin(2π × days / period)
    """
    
    PERIODS = {
        "physical": 23,
        "emotional": 28,
        "intellectual": 33,
    }
    
    @property
    def system_name(self) -> str:
        return "biorhythms"
    
    def calculate(self, input_data: Dict[str, Any]) -> Dict[str, Any]:
        birth_date = input_data["birth_date"]
        target_date = input_data.get("target_date", date.today())
        
        days = (target_date - birth_date).days
        
        values = {}
        for name, period in self.PERIODS.items():
            values[name] = math.sin(2 * math.pi * days / period)
        
        critical = {name: abs(v) < 0.1 for name, v in values.items()}
        
        return {
            "system": "biorhythms",
            "days_since_birth": days,
            "values": values,
            "critical_days": critical,
        }
    
    def to_vector(self, result: Dict[str, Any]) -> List[float]:
        """3-мерный вектор (нормализованный в 0-1)."""
        values = result["values"]
        return [
            (values["physical"] + 1) / 2,
            (values["emotional"] + 1) / 2,
            (values["intellectual"] + 1) / 2,
        ]
