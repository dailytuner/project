router = APIRouter(prefix="/api/v1/lake", tags=["DataLake"])

def get_datalake_service() -> DataLakeService:
    """DI для DataLakeService."""
    lake_client = LakeClient(
        endpoint=settings.MINIO_ENDPOINT,
        access_key=settings.MINIO_ACCESS_KEY,
