## 5. Математическое ядро

### 5.1. MMPI Scorer

```python
class MMPIScorer:
    """
    Расчет T-scores для MMPI-2.
    Поддерживает полную версию (566 вопросов).
    """
    
    SCALE_KEYS = {
        'Hs': {'questions': [1, 2, 3, ...], 'k_correction': 0.5},
        'D': {'questions': [5, 6, 7, ...], 'k_correction': 0.0},
        'Hy': {'questions': [8, 9, 10, ...], 'k_correction': 0.0},
        'Pd': {'questions': [11, 12, 13, ...], 'k_correction': 0.4},
        'Mf': {'questions': [14, 15, 16, ...], 'k_correction': 0.0},
        'Pa': {'questions': [17, 18, 19, ...], 'k_correction': 0.0},
        'Pt': {'questions': [20, 21, 22, ...], 'k_correction': 1.0},
        'Sc': {'questions': [23, 24, 25, ...], 'k_correction': 1.0},
        'Ma': {'questions': [26, 27, 28, ...], 'k_correction': 0.2},
        'Si': {'questions': [29, 30, 31, ...], 'k_correction': 0.0},
    }
    
    def calculate_raw_scores(self, answers: Dict[int, bool]) -> Dict[str, float]:
        """
        Подсчет сырых баллов по каждой шкале.
        Суммируются ответы "True" для вопросов, входящих в шкалу.
        """
        raw_scores = {}
        for scale_name, scale_data in self.SCALE_KEYS.items():
            score = sum(1 for q in scale_data['questions'] if answers.get(q, False))
            raw_scores[scale_name] = score
        return raw_scores
    
    def calculate_t_scores(self, raw_scores: Dict[str, float], gender: str = 'female') -> Dict[str, float]:
        """
        Конвертация сырых баллов в T-показатели.
        Используются нормы MMPI-2 для женского и мужского вариантов.
        
        T = 50 + 10 * (raw_score - mean) / std
        """
        norms = self._load_norms(gender)
        t_scores = {}
        for scale, raw in raw_scores.items():
            mean = norms[scale]['mean']
            std = norms[scale]['std']
            t_scores[scale] = 50 + 10 * (raw - mean) / std
        return t_scores
    
    def validate_response(self, answers: Dict[int, bool]) -> Dict:
        """
        Проверка достоверности ответов по шкалам L, F, K.
        """
        l_score = self._calculate_l_scale(answers)
        f_score = self._calculate_f_scale(answers)
        k_score = self._calculate_k_scale(answers)
        
        is_valid = (
            l_score <= 8 and
            f_score <= 16 and
            k_score <= 20
        )
        
        return {
            'l_score': l_score,
            'f_score': f_score,
            'k_score': k_score,
            'is_valid': is_valid
        }
```

### 5.2. IAT Scorer

```python
class IATScorer:
    """
    Расчет IAT-эффекта (D-score) по алгоритму Greenwald et al. (2003).
    """
    
    def calculate_d_score(self, blocks: List[BlockData]) -> float:
        """
        1. Удаление стимулов с RT > 10000 мс или < 300 мс
        2. Замена RT > 3000 мс на 3000 мс
        3. Расчет средних RT для каждого блока
        4. Вычисление разницы между конгруэнтными и инконгруэнтными блоками
        5. Деление на pooled SD
        """
        filtered = self._filter_outliers(blocks)
        capped = self._cap_values(filtered)
        block_means = self._calculate_block_means(capped)
        d_score = self._calculate_d(block_means)
        return d_score
    
    def calculate_practice_effect(self, blocks: List[BlockData]) -> float:
        """
        Эффект тренировки: разница RT между первыми и последними блоками.
        """
        first_blocks = [b for b in blocks if b.block_type == 'practice']
        last_blocks = [b for b in blocks if b.block_type == 'test']
        
        first_mean = self._mean_rt(first_blocks) if first_blocks else 0
        last_mean = self._mean_rt(last_blocks) if last_blocks else 0
        
        return (last_mean - first_mean) / first_mean if first_mean else 0
```

### 5.3. IAT Stimulus Generator

```python
class IATStimulusGenerator:
    """
    Генерация стимулов с session_seed для борьбы с эффектом тренировки.
    """
    
    def generate(
        self, 
        test_type: str, 
        user_id: int, 
        month: int, 
        year: int
    ) -> Tuple[List[Stimulus], int]:
        """
        session_seed = hash(user_id, month, year)
        Гарантирует: в течение месяца стимулы одинаковые,
        каждый месяц — новый набор.
        """
        session_seed = hash(f"{user_id}_{month}_{year}")
        rng = random.Random(session_seed)
        
        base_stimuli = self._load_stimuli_pool(test_type)
        selected = rng.sample(base_stimuli, k=20)
        
        return selected, session_seed
