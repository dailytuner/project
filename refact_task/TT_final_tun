## 4. SERVICE LAYER

### 4.1. Tuner Service

```python
# src/services/tuner_service.py

from typing import Dict, List, Optional
from datetime import datetime
from uuid import UUID

from ..core.weight_optimizer import WeightOptimizer
from ..core.threshold_tuner import ThresholdTuner
from ..core.validation_runner import ValidationRunner
from ..core.simulation_mode import SimulationMode

class TunerService:
    """
    Главный сервис калибровки.
    """
    
    def __init__(
        self,
        weight_optimizer: WeightOptimizer,
        threshold_tuner: ThresholdTuner,
        validation_runner: ValidationRunner,
        simulation_mode: SimulationMode
    ):
        self.weight_optimizer = weight_optimizer
        self.threshold_tuner = threshold_tuner
        self.validation_runner = validation_runner
        self.simulation_mode = simulation_mode
    
    async def optimize_weights(
        self,
        category_id: str,
        method: str = 'differential_evolution'
    ) -> Dict:
        """
        Оптимизирует веса для категории.
        """
        # 1. Получаем исторические данные
        data = await self._get_historical_data(category_id)
        
        # 2. Оптимизируем
        result = await self.weight_optimizer.optimize(
            category_id=category_id,
            data=data,
            method=method
        )
        
        # 3. Сохраняем результат
        if result['status'] == 'success':
            await self._save_weight_optimization(
                category_id=category_id,
                result=result
            )
        
        return result
    
    async def tune_thresholds(self) -> Dict:
        """
        Настраивает пороги окон.
        """
        # 1. Получаем исторические данные
        data = await self._get_window_data()
        
        # 2. Получаем текущие пороги
        current = await self._get_current_thresholds()
        
        # 3. Оптимизируем
        result = await self.threshold_tuner.tune(
            data=data,
            current_thresholds=current
        )
        
        # 4. Сохраняем результат
        if result['status'] == 'success':
            await self._save_threshold_optimization(result)
        
        return result
    
    async def validate_configuration(
        self,
        config: Dict,
        n_folds: int = 5
    ) -> Dict:
        """
        Валидирует конфигурацию.
        """
        data = await self._get_historical_data()
        result = await self.validation_runner.run_validation(
            data=data,
            config=config,
            n_folds=n_folds
        )
        
        return result
    
    async def run_simulation(
        self,
        config: Dict,
        simulation_type: str = 'what_if'
    ) -> Dict:
        """
        Запускает симуляцию.
        """
        historical_data = await self._get_historical_data()
        
        result = await self.simulation_mode.simulate(
            config=config,
            historical_data=historical_data,
            simulation_type=simulation_type
        )
        
        return result
    
    async def apply_configuration(self, config: Dict) -> Dict:
        """
        Применяет новую конфигурацию в продакшен.
        """
        # 1. Проверяем, что конфигурация валидна
        validation = await self.validate_configuration(config)
        
        if validation['mean_score'] < 0.5:
            return {
                'status': 'rejected',
                'message': 'Configuration failed validation',
                'validation_score': validation['mean_score']
            }
        
        # 2. Обновляем конфигурацию в Psychometry Service
        await self._update_psychometry_config(config)
        
        # 3. Сохраняем как активную
        await self._save_active_configuration(config)
        
        return {
            'status': 'applied',
            'message': 'Configuration applied successfully',
            'validation_score': validation['mean_score']
        }
