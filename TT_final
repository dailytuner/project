}


def calculate_priorities(horizon_days: int) -> Dict[str, Any]:
    """Взвешивание систем по горизонту прогноза."""
    system_weights = {
        "western": 1.0, "vedic": 1.0, "arabic": 1.0,
        "chinese": 0.7, "maya": 0.6, "mesopotamian": 0.7, "transits": 1.0
    }
    c = PRIORITY_CONSTANTS
    time_multipliers = {
        "western": 1.0 / (1 + horizon_days / c["western_horizon"]),
        "vedic": 1.0 / (1 + c["vedic_horizon"] / horizon_days) if horizon_days > 0 else 0.5,
        "arabic": 1.0 / (1 + abs(horizon_days - c["arabic_optimal"]) / c["arabic_optimal"]),
        "chinese": 0.5 + 0.5 / (1 + horizon_days / c["chinese_cycle"]),
        "maya": 0.5 + 0.5 / (1 + horizon_days / c["maya_cycle"]),
        "mesopotamian": 0.5 + 0.5 / (1 + horizon_days / c["mesopotamian_horizon"]),
        "transits": 1.0 / (1 + horizon_days / c["transits_horizon"])
    }
    final_weights = {s: system_weights[s] * time_multipliers[s] for s in system_weights}
    total = sum(final_weights.values())
    final_weights = {s: w / total for s, w in final_weights.items()}
    sorted_systems = sorted(final_weights.items(), key=lambda x: -x[1])
    
    return {
        "weights": final_weights,
        "primary": sorted_systems[0][0],
        "secondary": sorted_systems[1][0] if len(sorted_systems) > 1 else None,
        "all": sorted_systems
    }
```

