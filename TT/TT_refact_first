from typing import List, Dict
from uuid import uuid4

class RecommendationGenerator:
    def __init__(self, db_session):
        self.db_session = db_session
        self._load_templates()
    
    def _load_templates(self):
        from ..models import RecommendationTemplate
        templates = self.db_session.query(RecommendationTemplate).filter(
            RecommendationTemplate.is_active == True
        ).all()
        self.templates = {}
        for t in templates:
            key = f"{t.category}_{t.level}"
            self.templates[key] = {
                'template': t.template,
                'priority': t.priority,
                'duration': t.duration
            }
    
    def generate(self, state, achievements, window) -> List[Dict]:
        recommendations = []
        
        # 1. По категориям
        for cat, idx in achievements.items():
            template = self.templates.get(f"{cat}_{idx['level']}")
            if template:
                recommendations.append({
                    'id': len(recommendations),
                    'action': template['template'],
                    'reason': f"Индекс {cat}: {idx['level'].lower()}",
                    'priority': template['priority'],
                    'duration': template['duration'],
                    'category': cat
                })
        
        # 2. По состоянию
        if state.get('energy_score', 0.5) < 0.4:
            recommendations.append({
                'id': len(recommendations),
                'action': 'Выделите 15 минут на тишину без гаджетов',
                'reason': 'Энергия снижена, нужна пауза',
                'priority': 1,
                'duration': '15 мин',
                'category': 'health'
            })
        
        if state.get('anxiety_score', 0.5) > 0.6:
            recommendations.append({
                'id': len(recommendations),
                'action': 'Сделайте глубокий вдох и выдох 5 раз',
                'reason': 'Тревожность повышена',
                'priority': 2,
                'duration': '2 мин',
                'category': 'health'
            })
        
        # 3. По окну
        if window.get('level') == 'OPEN':
            recommendations.append({
                'id': len(recommendations),
                'action': 'Запланируйте важное дело на сегодня',
