#### 3.2 Обновить метод `_select_best_result`:

```python
@staticmethod
def _select_best_result(
    results: List[dict],
    country_code: Optional[str],
    region: Optional[str] = None  # НОВЫЙ параметр
) -> Optional[dict]:
    """Выбор наилучшего результата с учетом региона"""
    if not results:
        return None
    
    filtered = results
    
    # Фильтр по стране
    if country_code:
        country_filtered = [
            r for r in results
            if r.get('address', {}).get('country_code', '').lower() == country_code.lower()
        ]
        if country_filtered:
            filtered = country_filtered
    
    # Фильтр по региону (если указан)
    if region and filtered:
        region_lower = region.lower()
        region_filtered = [
            r for r in filtered
            if region_lower in r.get('address', {}).get('state', '').lower()
            or region_lower in r.get('address', {}).get('region', '').lower()
            or region_lower in r.get('display_name', '').lower()
        ]
        if region_filtered:
            filtered = region_filtered
    
    # Возвращаем наиболее важный результат
    return max(filtered, key=lambda x: float(x.get('importance', 0)))
```

