# Добавить метод в UserService
async def ensure_geodata(
    self,
    user_id: int,
    session: AsyncSession
) -> bool:
    """Проверка и принудительное обновление геоданных"""
    profile = await session.get(UserProfile, user_id)
    if not profile:
        return False
    
    if not profile.birth_lat or not profile.birth_lng:
        # Пробуем геокодировать заново
        await self._geocode_and_update_profile(profile, session)
        await session.commit()
    
    return bool(profile.birth_lat and profile.birth_lng)
```

