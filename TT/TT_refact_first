# src/core/achievement_calc.py

from typing import Dict, Optional
from datetime import datetime

class AchievementCalculator:
    """
    Расчёт индексов достижения по 4 категориям.
    Сумма весов = 1.0. seasonal_boost как множитель базового значения.
    """
    
    CATEGORIES = {
        'family': {
            'scales': ['d', 'si'],
            'biorhythm': 'emotional',
            'seasonal_boost': {1: 0.1, 2: 0.1, 7: 0.05, 8: 0.05, 12: 0.1}
        },
        'work': {
            'scales': ['pt', 'ma'],
            'biorhythm': 'intellectual',
            'seasonal_boost': {3: 0.1, 4: 0.1, 9: 0.1, 10: 0.1}
        },
        'health': {
            'scales': ['pa', 'sc'],
            'biorhythm': 'physical',
            'seasonal_boost': {5: 0.1, 6: 0.1, 7: 0.1, 8: 0.1}
        },
        'self': {
            'scales': ['ma', 'pa'],
            'biorhythm': 'intellectual',
            'seasonal_boost': {1: 0.05, 2: 0.05, 9: 0.1, 10: 0.1}
        }
    }
    
    def __init__(self, db_session):
        self.db_session = db_session
        self._load_templates()
    
    def _load_templates(self):
        """Загружает шаблоны из БД."""
        from ..models import RecommendationTemplate
        templates = self.db_session.query(RecommendationTemplate).filter(
            RecommendationTemplate.is_active == True
        ).all()
        self.templates = {}
        for t in templates:
            key = f"{t.category}_{t.level}"
            self.templates[key] = {
                'template': t.template,
                'priority': t.priority,
                'duration': t.duration
            }
    
    def calculate(
        self,
        state: Dict,
        astro_context: Dict,
        t_scores: Optional[Dict] = None
    ) -> Dict[str, Dict]:
        """Рассчитывает индексы по всем категориям."""
        indices = {}
        for category_name, config in self.CATEGORIES.items():
            index = self._calculate_category(
                category_name=category_name,
                config=config,
                state=state,
                astro_context=astro_context,
                t_scores=t_scores
            )
            indices[category_name] = index
        return indices
    
    def _calculate_category(
        self,
        category_name: str,
        config: Dict,
        state: Dict,
        astro_context: Dict,
        t_scores: Optional[Dict]
    ) -> Dict:
        """Рассчитывает индекс для одной категории."""
        clarity = self._calculate_clarity(t_scores, config.get('scales', []))
        synchronicity = self._calculate_synchronicity(astro_context, config.get('biorhythm'))
        resource = self._calculate_resource(state, config)
        inertia = self._calculate_inertia(t_scores, config.get('scales', []))
        
        # Сезонный буст — передаём имя категории
        seasonal_boost = self._get_seasonal_boost(astro_context, category_name)
        
        # ИСПРАВЛЕННАЯ ФОРМУЛА
        # Сумма базовых весов = 1.0
        base = clarity * 0.35 + synchronicity * 0.35 + resource * 0.30
        
        # Буст как множитель (0-20% от базового значения)
        boost_factor = seasonal_boost * 0.20
        raw_value = base * (1 + boost_factor) - inertia * 0.10
        
        value = max(0.05, min(1, raw_value))
        
        # Уровень
        if value >= 0.75:
            level = 'HIGH'
        elif value >= 0.50:
            level = 'MEDIUM'
        elif value >= 0.25:
            level = 'LOW'
        else:
            level = 'CRITICAL'
        
        # Рекомендация из шаблона
        template_key = f"{category_name}_{level}"
        template = self.templates.get(template_key)
        recommendation = template['template'] if template else self._get_fallback(category_name, level)
        
        return {
            'value': round(value, 3),
            'level': level,
            'clarity': round(clarity, 3),
            'synchronicity': round(synchronicity, 3),
            'resource': round(resource, 3),
            'inertia': round(inertia, 3),
            'recommendation': recommendation,
            'seasonal_boost': round(seasonal_boost, 3)
        }
    
    def _get_seasonal_boost(self, astro_context, category_name: str) -> float:
        """Получает сезонный буст для категории."""
        if astro_context and 'seasonal_boosts' in astro_context:
            return astro_context['seasonal_boosts'].get(category_name, 0)
        
        # Fallback: из конфига категории
        month = datetime.now().month
        config = self.CATEGORIES.get(category_name, {})
        return config.get('seasonal_boost', {}).get(month, 0)
    
    def _get_fallback(self, category_name: str, level: str) -> str:
        """Fallback рекомендация."""
        fallbacks = {
            'family': {'HIGH': 'Проведите время с семьёй', 'MEDIUM': 'Поговорите с близкими', 'LOW': 'Отдохните', 'CRITICAL': 'Побудьте наедине'},
            'work': {'HIGH': 'Начните новый проект', 'MEDIUM': 'Работайте над текущими задачами', 'LOW': 'Отложите решения', 'CRITICAL': 'Рутина'},
            'health': {'HIGH': 'Займитесь спортом', 'MEDIUM': 'Разомнитесь', 'LOW': 'Отдохните', 'CRITICAL': 'Обязательный отдых'},
            'self': {'HIGH': 'Творите', 'MEDIUM': 'Развивайтесь', 'LOW': 'Отдохните', 'CRITICAL': 'Просто отдыхайте'}
        }
        return fallbacks.get(category_name, {}).get(level, 'Рекомендация')
