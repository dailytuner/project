# core/aligners/base.py

from abc import ABC, abstractmethod
from typing import List, Optional
from pydantic import BaseModel

class Alignment(BaseModel):
    """Результат одного сопоставления."""
    type: str  # 'house', 'dasha', 'retro', 'element', 'dynamic'
    factor: str  # 'saturn_house_1', 'dasha_saturn', etc.
