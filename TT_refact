### 4.3. Базовые алгоритмы

#### 4.3.1. Состояние (State Synthesizer)

```python
# src/core/state_synthesizer.py

from typing import Dict, Optional
from datetime import date

class StateSynthesizer:
    """
    Синтез состояния из быстрого опросника + астро-контекста.
    """
    
    def synthesize(
        self,
        quick_check: Dict,      # {energy, anxiety, emotional}
        astro_context: Dict,   # {biorhythms, transits, seasonal_boosts}
        baseline: Optional[Dict] = None  # из полного профиля
    ) -> Dict:
        """
        Возвращает состояние: 3 метрики + уровень + сводка.
        """
        # 1. Нормализуем быстрый опросник (1-5 → 0-1)
        energy = (quick_check['energy'] - 1) / 4
        anxiety = (quick_check['anxiety'] - 1) / 4
        emotional = (quick_check['emotional'] - 1) / 4
        
        # 2. Корректировка по биоритмам (если есть)
        if astro_context and 'biorhythms' in astro_context:
            bio = astro_context['biorhythms']
            energy = energy * 0.7 + ((bio.get('physical', 0) + 1) / 2) * 0.3
            emotional = emotional * 0.7 + ((bio.get('emotional', 0) + 1) / 2) * 0.3
        
        # 3. Уровень
        avg = (energy + (1 - anxiety) + emotional) / 3
        if avg >= 0.7:
            level = 'HIGH'
        elif avg >= 0.4:
            level = 'MEDIUM'
        else:
            level = 'LOW'
        
        # 4. Сводка
        summary = self._generate_summary(energy, anxiety, emotional, level)
        
        return {
            'energy_score': round(energy, 3),
            'anxiety_score': round(anxiety, 3),
            'emotional_score': round(emotional, 3),
            'state_level': level,
            'state_summary': summary
        }
    
    def _generate_summary(self, energy, anxiety, emotional, level):
        """Генерирует текстовую сводку."""
        parts = []
        
        if energy >= 0.6:
            parts.append("энергия на подъёме")
        elif energy <= 0.3:
            parts.append("энергия снижена")
        else:
            parts.append("энергия в норме")
        
        if anxiety >= 0.6:
            parts.append("тревожность повышена")
        elif anxiety <= 0.3:
            parts.append("тревожность снижена")
        else:
            parts.append("тревожность умеренная")
        
        if emotional >= 0.6:
            parts.append("эмоциональный фон повышен")
        elif emotional <= 0.3:
            parts.append("эмоциональный фон снижен")
        else:
            parts.append("эмоциональный фон в норме")
        
        return f"Ваше состояние: {', '.join(parts)}. Уровень: {level.lower()}."
```

#### 4.3.2. Индексы достижения

```python
# src/core/achievement_calc.py

from typing import Dict

class AchievementCalculator:
    """
    Расчёт индексов достижения по 4 категориям.
    """
    
    CATEGORIES = {
        'family': {
            'scales': ['d', 'si'],
            'biorhythm': 'emotional',
            'seasonal_boost': {'1': 0.1, '2': 0.1, '7': 0.05, '8': 0.05, '12': 0.1}
        },
        'work': {
            'scales': ['pt', 'ma'],
            'biorhythm': 'intellectual',
            'seasonal_boost': {'3': 0.1, '4': 0.1, '9': 0.1, '10': 0.1}
        },
        'health': {
            'scales': ['pa', 'sc'],
            'biorhythm': 'physical',
            'seasonal_boost': {'5': 0.1, '6': 0.1, '7': 0.1, '8': 0.1}
        },
        'self': {
            'scales': ['ma', 'pa'],
            'biorhythm': 'intellectual',
            'seasonal_boost': {'1': 0.05, '2': 0.05, '9': 0.1, '10': 0.1}
        }
    }
    
    def calculate(
        self,
        state: Dict,
        astro_context: Dict,
        t_scores: Optional[Dict] = None
    ) -> Dict[str, Dict]:
        """
        Рассчитывает индексы по всем категориям.
        """
        indices = {}
        
        for category, config in self.CATEGORIES.items():
            index = self._calculate_category(
                category, config, state, astro_context, t_scores
            )
            indices[category] = index
        
        return indices
    
    def _calculate_category(self, category, config, state, astro_context, t_scores):
        """Рассчитывает индекс для одной категории."""
        # 1. Ясность (из T-scores)
        clarity = self._calculate_clarity(t_scores, config.get('scales', []))
        
        # 2. Синхронность (из биоритмов)
        synchronicity = self._calculate_synchronicity(
            astro_context, config.get('biorhythm')
        )
        
        # 3. Ресурс (из состояния)
        resource = self._calculate_resource(state, config)
        
        # 4. Инерция (из T-scores)
        inertia = self._calculate_inertia(t_scores, config.get('scales', []))
        
        # 5. Сезонный буст
        seasonal_boost = self._get_seasonal_boost(
            config.get('seasonal_boost', {})
        )
        
        # 6. Индекс
        value = (
            clarity * 0.3 +
            synchronicity * 0.3 +
            resource * 0.3 -
            inertia * 0.1 +
            seasonal_boost * 0.2
        )
        value = max(0, min(1, value))
        
        # 7. Уровень
        if value >= 0.75:
            level = 'HIGH'
            recommendation = self._get_recommendation(category, 'high')
        elif value >= 0.50:
            level = 'MEDIUM'
            recommendation = self._get_recommendation(category, 'medium')
        elif value >= 0.25:
            level = 'LOW'
            recommendation = self._get_recommendation(category, 'low')
        else:
            level = 'CRITICAL'
            recommendation = self._get_recommendation(category, 'critical')
        
        return {
            'value': round(value, 3),
            'level': level,
            'clarity': round(clarity, 3),
            'synchronicity': round(synchronicity, 3),
            'resource': round(resource, 3),
            'inertia': round(inertia, 3),
            'recommendation': recommendation
        }
    
    def _calculate_clarity(self, t_scores, scales):
        """Ясность — чем ниже шкалы, тем выше ясность."""
        if not t_scores or not scales:
            return 0.5
        
        values = []
        for scale in scales:
            score = t_scores.get(scale, 50)
            # Нормализуем: 30-70 → 1-0
            normalized = 1 - ((score - 30) / 70)
            values.append(max(0, min(1, normalized)))
        
        return sum(values) / len(values)
    
    def _calculate_synchronicity(self, astro_context, biorhythm):
        """Синхронность с Фоном."""
        if not astro_context or not biorhythm:
            return 0.5
        
        bio = astro_context.get('biorhythms', {})
        value = bio.get(biorhythm, 0)
        return (value + 1) / 2  # -1..1 → 0..1
    
    def _calculate_resource(self, state, config):
        """Ресурс из состояния."""
        return (state.get('energy_score', 0.5) + (1 - state.get('anxiety_score', 0.5))) / 2
    
    def _calculate_inertia(self, t_scores, scales):
        """Инерция — чем выше шкалы, тем выше инерция."""
        if not t_scores or not scales:
            return 0.2
        
        values = []
        for scale in scales:
            score = t_scores.get(scale, 50)
            normalized = (score - 30) / 70
            values.append(max(0, min(1, normalized)))
        
        return sum(values) / len(values)
    
    def _get_seasonal_boost(self, boosts):
        """Сезонный буст на текущий месяц."""
        month = datetime.now().month
        return boosts.get(str(month), 0)
    
    def _get_recommendation(self, category, level):
        """Рекомендация по уровню."""
