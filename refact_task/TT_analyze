from ..core.report_generator import ReportGenerator

class AnalyticsService:
    """
    Главный сервис аналитики.
    """
    
    def __init__(
        self,
        feedback_processor: FeedbackProcessor,
        index_calibrator: IndexCalibrator,
        window_optimizer: WindowOptimizer,
        report_generator: ReportGenerator
    ):
        self.feedback_processor = feedback_processor
        self.index_calibrator = index_calibrator
        self.window_optimizer = window_optimizer
        self.report_generator = report_generator
    
    async def process_feedback(
        self,
        user_id: UUID,
        category_id: str,
        forecast_date: datetime,
        actual_outcome: float,
        rating: Optional[int] = None,
        comment: Optional[str] = None
    ) -> Dict:
        """
        Обрабатывает обратную связь.
        """
        return await self.feedback_processor.process_feedback(
            user_id, category_id, forecast_date,
            actual_outcome, rating, comment
        )
    
    async def run_calibration(self, category_id: str) -> Dict:
        """
        Запускает калибровку индексов для категории.
        """
        version = f"v{datetime.now().strftime('%Y%m%d')}"
        return await self.index_calibrator.calibrate(
            category_id=category_id,
            version=version
        )
    
    async def run_window_optimization(self) -> Dict:
        """
        Запускает оптимизацию окон.
        """
        version = f"v{datetime.now().strftime('%Y%m%d')}"
        return await self.window_optimizer.optimize(version=version)
    
    async def generate_report(self, report_type: str) -> Dict:
        """
        Генерирует отчёт.
        """
