class IATScorer:
    """
    D-score по Greenwald et al. (2003).
    """

    def calculate_d_score(self, blocks: list[BlockData]) -> float:
        filtered = self._filter_outliers(blocks)   # RT < 300 или > 10000 → удалить
        capped = self._cap_values(filtered)        # RT > 3000 → 3000
        means = self._calculate_block_means(capped)
        return self._calculate_d(means)
