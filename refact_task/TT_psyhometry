# src/services/synthesizer.py

from datetime import datetime
from typing import Optional, Dict, Any
from uuid import UUID
import numpy as np

from ..core.mmpi_core import MMPICore
from ..core.awareness_recognizer import AwarenessRecognizer
from ..clients.forecast_client import ForecastClient
from ..clients.astro_client import AstroClient

class ContextSynthesizer:
    """
    Синтезатор состояния — объединяет все данные в единый объект.
    """
    
    def __init__(
        self,
        forecast_client: ForecastClient,
        astro_client: AstroClient
    ):
        self.forecast_client = forecast_client
        self.astro_client = astro_client
    
    async def synthesize(
        self,
        user_id: UUID,
        mmpi_result: Optional[Dict] = None,
        iat_result: Optional[Dict] = None,
        date: Optional[datetime] = None
    ) -> Dict:
        """
        Синтезирует состояние пользователя.
        """
        if date is None:
            date = datetime.now()
        
        # 1. Получаем прогноз (9 осей) из Forecast Service
        forecast = await self.forecast_client.get_forecast(
            user_id=user_id,
            date=date.date()
        )
        axes = forecast.get('axes', {})
        
        # 2. Получаем биоритмы из Astro Service
        biorhythms = await self.astro_client.get_biorhythms(
            user_id=user_id,
            date=date
        )
        
        # 3. Извлекаем ключевые метрики
        metrics = self._extract_metrics(mmpi_result, axes, biorhythms)
        
        # 4. Рассчитываем осознанность
        awareness = self._calculate_awareness(mmpi_result, axes)
        
        # 5. Формируем состояние
        return {
            'metrics': metrics,
            'state_level': self._get_state_level(metrics),
            'state_summary': self._generate_summary(metrics, awareness),
            'awareness': awareness,
            'sources': {
                'forecast_id': forecast.get('id'),
                'mmpi_id': mmpi_result.get('id') if mmpi_result else None,
                'iat_id': iat_result.get('id') if iat_result else None,
            }
        }
    
    def _extract_metrics(
        self,
        mmpi_result: Optional[Dict],
        axes: Dict[str, float],
        biorhythms: Dict[str, float]
    ) -> Dict[str, float]:
        """
        Извлекает 3 метрики состояния.
        """
        # Из MMPI (приоритет)
        if mmpi_result:
            scores = mmpi_result.get('scores', {})
            d_score = self._normalize_score(scores.get('2', 50))
            anxiety = self._normalize_score(scores.get('7', 50))
            energy = self._normalize_score(scores.get('9', 50))
        else:
            # Fallback: из осей Magic Profile
            d_score = 1 - axes.get('emotions_intuition', 0.5)
            anxiety = 1 - axes.get('karma_cycles', 0.5)
            energy = axes.get('energy_will', 0.5)
        
        # Корректировка по биоритмам
        if biorhythms:
            emotional_bio = (biorhythms.get('emotional', 0) + 1) / 2
            physical_bio = (biorhythms.get('physical', 0) + 1) / 2
            
            # Смешивание
            d_score = d_score * 0.7 + (1 - emotional_bio) * 0.3
            energy = energy * 0.7 + physical_bio * 0.3
        
        return {
            'emotional_score': max(0, min(1, d_score)),
            'anxiety_score': max(0, min(1, anxiety)),
            'energy_score': max(0, min(1, energy))
        }
    
    def _normalize_score(self, t_score: float) -> float:
        """
        Нормализует T-score в диапазон 0-1.
        """
        # 50 — среднее, 70+ — высокое, 30- — низкое
        normalized = (t_score - 30) / 60
        return max(0, min(1, normalized))
    
    def _get_state_level(self, metrics: Dict[str, float]) -> str:
        """
        Определяет уровень состояния.
        """
        avg = (metrics['emotional_score'] + 
               metrics['anxiety_score'] + 
               metrics['energy_score']) / 3
        
        if avg >= 0.7:
            return 'HIGH'
        elif avg >= 0.4:
            return 'MEDIUM'
        else:
            return 'LOW'
    
    def _generate_summary(self, metrics: Dict, awareness: Dict) -> str:
        """
        Генерирует краткую сводку состояния.
        """
        emotional = metrics['emotional_score']
        anxiety = metrics['anxiety_score']
        energy = metrics['energy_score']
        awareness_level = awareness.get('level', 'MEDIUM')
        
        parts = []
        
        if emotional >= 0.6:
            parts.append("эмоциональный фон повышен")
        elif emotional <= 0.3:
            parts.append("эмоциональный фон снижен")
        else:
            parts.append("эмоциональный фон в норме")
        
        if anxiety >= 0.6:
            parts.append("тревожность повышена")
        elif anxiety <= 0.3:
            parts.append("тревожность снижена")
        else:
            parts.append("тревожность умеренная")
        
        if energy >= 0.6:
            parts.append("энергия на подъёме")
        elif energy <= 0.3:
            parts.append("энергия снижена")
        else:
            parts.append("энергия в норме")
        
        summary = f"Ваше состояние: {', '.join(parts)}. "
        summary += f"Уровень осознанности: {awareness_level.lower()}."
        
        return summary
