```python
def validate_profile(profile):
    errors = []
    warnings = []
    
    for intersection in profile["intersections"]:
        if intersection["type"] not in ["full", "partial", "tension", "weak"]:
            errors.append(f"Invalid intersection type: {intersection['type']}")
        
        if not (0 <= intersection["strength"] <= 1):
            errors.append(f"Strength out of range: {intersection['strength']}")
        
        if intersection["type"] == "tension" and not (0 <= intersection["tension_index"] <= 2):
            errors.append(f"Tension_index out of range: {intersection['tension_index']}")
        
        if len(intersection["sources"]) != len(set(intersection["sources"])):
            warnings.append("Duplicate sources in intersection")
    
    consistency = profile["global_consistency"]
    if consistency < 0.6:
        warnings.append(f"Low global consistency: {consistency:.2f}")
    
    return {
        "is_valid": len(errors) == 0,
        "errors": errors,
        "warnings": warnings
    }
