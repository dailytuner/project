    Возвращает астро-профиль для Alignment Engine.
    
    Используется Alignment Engine для сопоставления профилей.
    Использует alignment_cache для быстрого ответа.
    
    Заголовки:
    - X-Internal-API-Key: ${INTERNAL_API_KEY}
    - X-Service-Name: alignment-engine
    """
    # 1. Проверяем API Key
    verify_internal_api_key(request)
    
    # 2. Определяем дату
    target_date = date or date.today()
    
    # 3. Проверяем кэш
    cached = await alignment_cache.get(user_id, target_date)
    if cached:
        return cached
    
    # 4. Рассчитываем профиль
    profile = await astro_profile_service.build_profile(
        user_id=user_id,
        date=target_date,
        session=session
    )
    
    # 5. Сохраняем в кэш
    await alignment_cache.set(user_id, target_date, profile)
    
    # 6. Логируем
    await log_internal_api_call('astro-profile', user_id, 200)
    
    return profile
