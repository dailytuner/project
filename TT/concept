    return theses

def calculate_sigma(speed: float, orb: float) -> float:
    """
    Чем быстрее планета, тем уже окно.
    Возвращает sigma в днях.
    
    Args:
        speed: Скорость планеты (°/день)
        orb: Орбис аспекта (°)
    
    Returns:
        float: Sigma в днях
    
    TODO(v6.0): Перейти на динамический расчет sigma = orb / speed * 2
    """
    if speed > 12:      # Луна
        return 7
    elif speed > 2:     # Меркурий, Венера, Марс
        return 14
    elif speed > 0.3:   # Юпитер
        return 35
    else:               # Сатурн, Уран, Нептун, Плутон
        return 90
