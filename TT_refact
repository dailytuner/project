### 3.2. Ночной batch (запись в Redis)

```python
# astro-service/src/workers/batch.py

from apscheduler.schedulers.background import BackgroundScheduler
from datetime import date
import json

def precompute_daily_context():
    """
    Каждую ночь в 3:00:
    1. Для всех активных пользователей (за последние 7 дней)
    2. Рассчитывает биоритмы, транзиты, сезонные бусты
    3. Сохраняет в Redis с TTL 48 часов
    """
    logger.info("Starting daily context precomputation...")
    users = get_active_users()
    today = date.today()
    
    for user_id in users:
        biorhythms = calculate_biorhythms(user_id, today)
        transits = calculate_transits(user_id, today)
        boosts = get_seasonal_boosts(today)
        
        key = f"astro:{user_id}:{today.isoformat()}"
        value = {
            'biorhythms': biorhythms,
            'transits': transits,
            'seasonal_boosts': boosts
        }
        redis_client.setex(key, 48 * 3600, json.dumps(value))
    
    logger.info(f"Precomputed context for {len(users)} users")

# Планировщик
scheduler = BackgroundScheduler()
scheduler.add_job(
    precompute_daily_context,
    'cron',
    hour=3,
    minute=0,
    id='daily_context'
)
scheduler.start()
```

