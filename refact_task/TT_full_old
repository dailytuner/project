class TestFullFlow:
    """
    End-to-end тесты всего flow с Alignment Engine.
    """
    
    @pytest.mark.asyncio
    async def test_full_flow(self):
        """
        Полный сценарий использования с Alignment Engine.
        """
        async with httpx.AsyncClient() as client:
            # 1. Регистрация пользователя
            user_id = await self._register_user(client)
            
            # 2. Получение прогноза
            forecast = await self._get_forecast(client, user_id)
            assert 'axes' in forecast
            
            # 3. Прохождение MMPI
            mmpi_result = await self._pass_mmpi(client, user_id)
            assert mmpi_result['validity']['is_valid'] == True
            
            # 4. Проверка сопоставления профилей (НОВОЕ!)
            alignment = await self._get_alignment(client, user_id)
            assert 'coherence_score' in alignment
            assert alignment['coherence_score'] >= 0
            
            # 5. Проверка диссонансов
            dissonances = alignment.get('dissonances', [])
            assert isinstance(dissonances, list)
            
            # 6. Проверка объяснений
            recommendations = alignment.get('recommendations', '')
            assert len(recommendations) > 0
    
