# scripts/migrate_forecasts.py

async def migrate_forecasts(batch_size: int = 100):
    """
    Переносит прогнозы из forecasts (JSONB) в forecasts_v2.
    """
    async with async_session() as session:
        stmt = select(Forecast).where(Forecast.migrated_to_v2.is_(False)).limit(batch_size)
        result = await session.execute(stmt)
        old_forecasts = result.scalars().all()
        
        for old in old_forecasts:
            raw = RawForecast.from_json(old.data)
            
            new = ForecastV2(
                user_id=old.user_id,
                forecast_date=old.forecast_date,
                overall_confidence=raw.overall_confidence,
                dominant_theme=raw.dominant_theme,
                calculated_at=old.calculated_at
            )
            session.add(new)
            await session.flush()
            
            for axis in raw.axes:
                session.add(ForecastAxisV2(
                    forecast_id=new.id,
                    axis_name=axis.name,
                    static_value=axis.static_value,
                    delta=axis.delta,
                    daily_value=axis.daily_value,
                    trend=axis.trend,
                    advice=axis.advice
                ))
            
            old.migrated_to_v2 = True
        
        await session.commit()
