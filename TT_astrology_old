## 8. Blind Protocol

### 8.1. Логика Blind Protocol

```python
class BlindProtocol:
    """
    Блокирует психологически чувствительные слои прогноза
    на основе статуса тестирования из Psychometry Service.
    """
    
    PSYCH_SENSITIVE_LAYERS = {
        'somatic',      # советы по еде и телу
        'people',       # советы по общению
        'mood_trigger', # эмоциональные триггеры
    }
    
    SAFE_LAYERS = {
        'foundation',   # махадаша
        'year_theme',   # годовая тема
        'retro',        # ретроградность
        'financial',    # финансовый индекс
        'transit_oracle', # транзитные аспекты
        'gochara',      # транзиты по домам
    }
    
    async def apply(
        self,
        user_id: int,
        forecast: RawForecast,
        session: AsyncSession
    ) -> RawForecast:
        """
        Применяет Blind Protocol к прогнозу.
        """
        # 1. Запрашиваем статус из Psychometry Service
        status = await self._get_test_status(user_id, session)
        
        # 2. Если нет pending тестов — возвращаем полный прогноз
        if not status.has_pending:
            return forecast
        
        # 3. MMPI pending — только SAFE_LAYERS
        if status.has_pending_mmpi:
            return self._filter_layers(forecast, self.SAFE_LAYERS)
        
        # 4. IAT pending — SAFE_LAYERS + транзиты
        if status.has_pending_iat:
            return self._filter_layers(
                forecast, 
                self.SAFE_LAYERS | {'transit_oracle', 'gochara'}
            )
        
        return forecast
    
    def _filter_layers(
        self, 
        forecast: RawForecast, 
        allowed_layers: set
    ) -> RawForecast:
        """
        Фильтрует слои прогноза, оставляя только разрешённые.
        """
        forecast.triggers = [
            event for event in forecast.triggers 
            if event.source in allowed_layers
        ]
        
        forecast.daily_mood = [
            event for event in forecast.daily_mood 
            if event.source in allowed_layers
        ]
        
        forecast.overall_confidence = self._recalculate_confidence(forecast)
        
        return forecast
```

### 8.2. Влияние на alignment_cache

```python
class BlindProtocol:
    """
    Обновлённая версия с влиянием на alignment_cache.
    """
    
    async def apply_with_cache(
        self,
        user_id: int,
        forecast: RawForecast,
        alignment_cache: AlignmentCache,
        session: AsyncSession
    ) -> Tuple[RawForecast, bool]:
        """
        Применяет Blind Protocol и обновляет alignment_cache.
        Возвращает (прогноз, блокирован_ли_прогноз).
        """
        # 1. Проверяем статус
        status = await self._get_test_status(user_id, session)
        
        # 2. Обновляем alignment_cache
        if status.has_pending:
            await alignment_cache.invalidate(user_id)
            logger.info(f"Alignment cache invalidated for user {user_id}")
        
        # 3. Применяем фильтрацию
        forecast = await self.apply(user_id, forecast, session)
        
        # 4. Определяем, был ли прогноз заблокирован
        is_blocked = status.has_pending and (
            not forecast.triggers or 
            len(forecast.triggers) < 3
        )
        
        return forecast, is_blocked
