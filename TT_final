```python
# config/version.py
import hashlib
import os
from pathlib import Path
from functools import lru_cache


class VersionManager:
    """
    Управление версиями правил и API.
    
    API_VERSION — меняется при изменении структуры ответа.
    RULES_HASH — автоматический хэш содержимого правил.
    RULES_MINOR_VERSION — для текстовых изменений (не влияет на кеш).
    """
    
    def __init__(self):
        self.api_version = os.getenv("API_VERSION", "v7.0")
        self.minor_version = os.getenv("RULES_MINOR_VERSION", "1")
    
    def get_api_version(self) -> str:
        return self.api_version
    
    @lru_cache(maxsize=1)
    def get_rules_hash(self) -> str:
        """Хэш-сумма содержимого интерпретационных модулей."""
        interpretation_dir = Path(__file__).parent.parent / "interpretation"
        if not interpretation_dir.exists():
            return hashlib.md5(b"default").hexdigest()[:8]
        files = sorted(interpretation_dir.glob("*.py"))
        content = ""
        for file in files:
            if file.name.startswith("__"):
                continue
            try:
                content += file.read_text(encoding="utf-8")
            except Exception:
                continue
        return hashlib.md5(content.encode()).hexdigest()[:8]
    
    def get_cache_version(self) -> str:
        return f"{self.api_version}:{self.get_rules_hash()}"
    
    def get_minor_version(self) -> str:
        return self.minor_version


VERSION_MANAGER = VersionManager()
