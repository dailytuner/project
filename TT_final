### 6.4. ШАГ 3: Расчёт пересечений

```python
# integration/intersections.py
from typing import List, Dict, Any
from core.models import Thesis
from constants.i18n import SPHERES, Language


def classify_intersection(cluster: List[Thesis]) -> Dict[str, Any]:
    """Классифицирует пересечение внутри кластера."""
    n_systems = len(set(t.system for t in cluster))
    directions = [t.sign for t in cluster]
    confidences = [t.confidence for t in cluster]
    avg_confidence = sum(confidences) / len(confidences)
    
    # 1. Tension (конфликт направлений)
    if any(s == 1 for s in directions) and any(s == -1 for s in directions):
        return {
            "type": "tension",
            "strength": avg_confidence,
            "tension_index": calculate_tension_index(cluster),
            "sources": list(set(t.system for t in cluster)),
            "sign": 0,
            "spheres": get_sphere_names(cluster[0].sphere_vector)
        }
    
    # 2. Full (≥3 систем, avg_confidence ≥ 0.8)
    if n_systems >= 3 and avg_confidence >= 0.8:
        strength = 1 - (1 - confidences[0]) * (1 - confidences[1]) * (1 - confidences[2])
        return {
            "type": "full", "strength": strength, "tension_index": 0,
            "sources": list(set(t.system for t in cluster)),
            "sign": 1 if directions[0] == 1 else -1,
            "spheres": get_sphere_names(cluster[0].sphere_vector)
        }
    
    # 3. Partial (≥2 систем, avg_confidence ≥ 0.5)
    if n_systems >= 2 and avg_confidence >= 0.5:
        strength = sum(c * c for c in confidences) / sum(confidences)
        return {
            "type": "partial", "strength": strength, "tension_index": 0,
            "sources": list(set(t.system for t in cluster)),
            "sign": 1 if directions[0] == 1 else -1,
            "spheres": get_sphere_names(cluster[0].sphere_vector)
        }
    
    # 4. Weak
    return {
        "type": "weak", "strength": avg_confidence, "tension_index": 0,
        "sources": list(set(t.system for t in cluster)),
        "sign": 1 if directions[0] == 1 else -1,
        "spheres": get_sphere_names(cluster[0].sphere_vector)
    }


def calculate_tension_index(cluster: List[Thesis]) -> float:
    """
    Нормированный индекс напряжения (0-1).
    
    0.0 = полное согласие
    1.0 = максимальное противостояние
    """
    positives = [t for t in cluster if t.sign == 1]
    negatives = [t for t in cluster if t.sign == -1]
    
    if not positives or not negatives:
        return 0.0
    
    pos_avg = sum(t.confidence for t in positives) / len(positives)
    neg_avg = sum(t.confidence for t in negatives) / len(negatives)
    
    return 1 - abs(pos_avg - neg_avg) / (pos_avg + neg_avg + 1e-9)


def get_sphere_names(vector: List[float], lang: Language = Language.RU) -> List[str]:
    """Возвращает названия сфер, где вектор > 0.3."""
    return [SPHERES[lang][i] for i, v in enumerate(vector) if v > 0.3]
```

