# src/core/iat_core.py

import numpy as np
from typing import List, Dict

class IATCore:
    """
    Расчёт D-score по алгоритму Greenwald (2003).
    """
    
    @classmethod
    def calculate_d_score(cls, trials: List[Dict]) -> float:
        """
        Рассчитывает D-score для IAT.
        """
        # 1. Разделяем по блокам
        blocks = cls._split_blocks(trials)
        
        # 2. Очищаем практические блоки
        cleaned = cls._clean_practice_trials(blocks)
        
        # 3. Вычисляем средние и SD
        means, stds = cls._calculate_stats(cleaned)
        
        # 4. Вычисляем D-score
        combined_mean = (means['block_3'] + means['block_5']) / 2
        combined_std = (stds['block_3'] + stds['block_5']) / 2
        
        d1 = (means['block_5'] - means['block_3']) / combined_std
        d2 = (means['block_6'] - means['block_4']) / combined_std
        
        return (d1 + d2) / 2
    
    @classmethod
    def get_effect_size(cls, d_score: float) -> str:
        """Определяет размер эффекта."""
        if abs(d_score) >= 0.65:
            return 'large'
        elif abs(d_score) >= 0.35:
            return 'medium'
        else:
            return 'small'
    
    @classmethod
    def _split_blocks(cls, trials: List[Dict]) -> Dict[str, List[float]]:
        """Разделяет попытки по блокам IAT."""
        blocks = {}
        for trial in trials:
            block_id = trial.get('block_id')
            if block_id not in blocks:
                blocks[block_id] = []
            blocks[block_id].append(trial.get('rt_ms', 0))
        return blocks
    
    @classmethod
    def _clean_practice_trials(cls, blocks: Dict) -> Dict:
        """Удаляет первые две попытки в практических блоках."""
        cleaned = {}
        for block_id, rts in blocks.items():
            # Для практических блоков (1, 2, 4) — удаляем первые 2
            if block_id in [1, 2, 4]:
                cleaned[block_id] = rts[2:]
            else:
                cleaned[block_id] = rts
        return cleaned
    
    @classmethod
    def _calculate_stats(cls, blocks: Dict) -> tuple:
        """Вычисляет средние и стандартные отклонения."""
        means = {}
        stds = {}
        for block_id, rts in blocks.items():
            if rts:
                means[block_id] = np.mean(rts)
                stds[block_id] = np.std(rts)
            else:
                means[block_id] = 500
                stds[block_id] = 100
        return means, stds
