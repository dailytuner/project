## 4. Интеграция сервисов

### 4.1. Проверка Internal API

```python
# scripts/verify_integration.py

class IntegrationVerifier:
    """
    Проверяет все internal endpoint'ы между сервисами.
    """
    
    def __init__(self):
        self.base_urls = {
            'gateway': 'http://localhost:8000',
            'astro': 'http://localhost:8001',
            'psych': 'http://localhost:8002',
            'alignment': 'http://localhost:8003',  # НОВЫЙ!
        }
        self.api_key = os.getenv('INTERNAL_API_KEY')
    
    async def verify_all(self) -> Dict:
        """Запускает все проверки."""
        checks = [
            self.check_astro_health(),
            self.check_psych_health(),
            self.check_alignment_health(),  # НОВЫЙ!
            self.check_astro_context(),
            self.check_astro_profile(),     # НОВЫЙ!
            self.check_test_status(),
            self.check_blind_protocol(),
            self.check_forecast(),
            self.check_psych_status(),
            self.check_alignment(),         # НОВЫЙ!
        ]
        
        results = await asyncio.gather(*checks, return_exceptions=True)
        
        return {
            'status': 'success' if all(r.get('status') == 'ok' for r in results) else 'failed',
            'checks': results
        }
    
    async def check_alignment_health(self):  # НОВЫЙ!
        """Проверяет health endpoint Alignment Engine."""
        async with httpx.AsyncClient() as client:
            response = await client.get(f"{self.base_urls['alignment']}/health")
            return {
                'name': 'alignment_health',
                'status': 'ok' if response.status_code == 200 else 'failed',
                'response': response.json() if response.status_code == 200 else None
            }
    
    async def check_astro_profile(self):  # НОВЫЙ!
        """Проверяет /internal/v1/users/{id}/astro-profile."""
        async with httpx.AsyncClient() as client:
            response = await client.get(
                f"{self.base_urls['astro']}/internal/v1/users/1/astro-profile",
                params={"date": "2026-08-04"},
                headers={"X-Internal-API-Key": self.api_key}
            )
            return {
                'name': 'astro_profile',
                'status': 'ok' if response.status_code == 200 else 'failed',
                'has_axes': 'dasha' in response.json() if response.status_code == 200 else False
            }
    
    async def check_alignment(self):  # НОВЫЙ!
        """Проверяет /api/v1/psych/alignment."""
        async with httpx.AsyncClient() as client:
            response = await client.get(
                f"{self.base_urls['gateway']}/api/v1/psych/alignment",
                params={"user_id": 1, "date": "2026-08-04"}
            )
            return {
                'name': 'alignment',
                'status': 'ok' if response.status_code == 200 else 'failed',
                'has_coherence': 'coherence_score' in response.json() if response.status_code == 200 else False
            }
```

