def get_orb(planet_name: str, aspect_name: str) -> float:
    """Возвращает орб для конкретной планеты и аспекта."""
    planet_orbs = ASPECT_ORBS_BY_PLANET.get(planet_name, {})
    return planet_orbs.get(aspect_name, ASPECT_ORBS_DEFAULT.get(aspect_name, 8))


def calculate_dynamic_core(static_core: dict, current_date: datetime, horizon_days: int = 90) -> dict:
    """
    Рассчитывает динамическое ядро (транзиты).
    
    Args:
        static_core: Статическое ядро
        current_date: Дата запроса (UTC)
        horizon_days: Горизонт прогноза
    
    Returns:
        dict: DynamicCore
    """
    from utils.time_module import TimeModule
    
    if current_date.tzinfo is None:
        current_date = TimeModule.localize_utc(current_date)
    
    transit_jd = TimeModule.to_julian_day(
        current_date.replace(hour=12, minute=0, second=0)
    )
    
