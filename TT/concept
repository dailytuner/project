# integration/normalization.py
from typing import List
from core.models import Thesis

def normalize_cluster(cluster: List[Thesis], N_max: int = 5) -> List[Thesis]:
    """
    Оставляет не более N_max тезисов от одной системы внутри кластера.
    Отбирает по уверенности (confidence).
    
    Args:
        cluster: Кластер тезисов
        N_max: Максимальное количество тезисов от одной системы
    
    Returns:
        List[Thesis]: Нормализованный кластер
    
    Обоснование:
        5 — эмпирически выбранное значение.
        - В западной астрологии типично 5 планет в одном доме (максимум)
        - В ведической астрологии типично 5 тезисов (накшатра + 4 даши)
        - 5 тезисов — максимальное количество, которое пользователь 
          может осмысленно воспринять
    """
    # Группировка по системам
    by_system: dict = {}
    for thesis in cluster:
        system = thesis.system
        if system not in by_system:
            by_system[system] = []
        by_system[system].append(thesis)
    
    # Сортировка и обрезка
    normalized = []
    for system, system_theses in by_system.items():
        sorted_theses = sorted(system_theses, key=lambda t: t.confidence, reverse=True)
        normalized.extend(sorted_theses[:N_max])
    
    return normalized
