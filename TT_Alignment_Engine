# core/dissonance_analyzer.py

class DissonanceAnalyzer:
    """
    Анализирует диссонансы между профилями.
    """
    
    DISSONANCE_THRESHOLD = 0.4  # Ниже этого порога — диссонанс
    
    async def analyze(
        self,
        alignments: List[Alignment]
    ) -> List[Dissonance]:
        """
        Находит расхождения между ожидаемым и фактическим.
        """
        dissonances = []
        
        for alignment in alignments:
            if alignment.alignment_score < self.DISSONANCE_THRESHOLD:
                # Это диссонанс!
                dissonance = Dissonance(
                    type=alignment.type,
                    source=alignment.factor,
                    expected_state=alignment.expected,
                    actual_state=alignment.actual or 'unknown',
                    psych_scale=alignment.psych_scale,
                    severity=1.0 - alignment.alignment_score,
                    hypothesis=self._generate_hypothesis(alignment),
                    resolved=False
                )
                dissonances.append(dissonance)
        
        return dissonances
    
    def _generate_hypothesis(self, alignment: Alignment) -> str:
        """
        Генерирует гипотезу о причине диссонанса.
        """
        if alignment.type == 'house':
            return (
                f"{alignment.factor} ожидался как {alignment.expected}, "
                f"но показывает {alignment.actual}. "
                f"Возможно, фактор подавлен другими аспектами."
            )
        elif alignment.type == 'dasha':
            return (
                f"Даша {alignment.factor.replace('dasha_', '')} должна давать "
                f"{alignment.expected} эффект, но психология показывает {alignment.actual}."
            )
        else:
            return (
                f"Обнаружено расхождение в факторе {alignment.factor}. "
                f"Требуется дополнительный анализ."
            )
