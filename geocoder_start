#### 3.6 Добавить метод для пакетного геокодирования с транслитерацией:

```python
async def geocode_with_transliteration(
    self,
    city_name: str,
    country_code: Optional[str] = None,
    region: Optional[str] = None
) -> Optional[CityCoordinates]:
    """
    Пробует геокодировать с различными вариациями названия
    """
    variants = [city_name]
    
    # Добавляем транслитерированный вариант
    try:
        from transliterate import translit
        variants.append(translit(city_name, 'ru', reversed=True))
        if region:
            variants.append(translit(region, 'ru', reversed=True))
    except:
        pass
    
    # Пробуем все варианты
    for variant in variants:
        result = await self.geocode(variant, country_code, region)
        if result:
            return result
    
    return None
```

