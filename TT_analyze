### 5.3. KnowledgeUpdater

```python
# core/knowledge_updater.py

class KnowledgeUpdater:
    """
    Обновляет базу знаний на основе выявленных паттернов.
    """
    
    # Изменение confidence на основе паттерна
    CONFIDENCE_DELTA = {
        'strong': 0.15,
        'medium': 0.07,
        'weak': 0.03
    }
    
    # Изменение weight на основе паттерна
    WEIGHT_DELTA = {
        'strong': 0.2,
        'medium': 0.1,
        'weak': 0.05
    }
    
    async def update(
        self,
        session: AsyncSession,
        patterns: List[Pattern]
    ) -> List[KnowledgeUpdate]:
        """
        Обновляет базу знаний на основе паттернов.
        """
        updates = []
        
        for pattern in patterns:
            # 1. Находим запись в knowledge_base
            kb_entry = await self._find_kb_entry(session, pattern)
            
            if not kb_entry:
                # Если нет — создаём новую
                kb_entry = await self._create_kb_entry(session, pattern)
            
            # 2. Определяем силу паттерна
            strength = self._determine_strength(pattern)
            
            # 3. Обновляем confidence
            old_confidence = kb_entry.confidence
            new_confidence = self._update_confidence(old_confidence, pattern, strength)
            
            # 4. Обновляем weight
            old_weight = kb_entry.weight
            new_weight = self._update_weight(old_weight, pattern, strength)
            
            # 5. Обновляем счётчики
            kb_entry.observations_count += pattern.observation_count
            kb_entry.dissonance_count += pattern.observation_count
            
            # 6. Если паттерн подтверждает ожидание
            if self._is_confirming(pattern):
                kb_entry.confirmation_count += pattern.observation_count
            
            # 7. Обновляем статус
            new_status = self._determine_status(kb_entry)
            
            # 8. Сохраняем изменения
            await session.commit()
            
            # 9. Логируем обновление
            update = KnowledgeUpdate(
                knowledge_base_id=kb_entry.id,
                old_weight=old_weight,
                new_weight=new_weight,
                old_confidence=old_confidence,
                new_confidence=new_confidence,
                old_status=kb_entry.status,
                new_status=new_status,
                change_reason=self._generate_change_reason(pattern, strength),
                pattern_id=pattern.id
            )
            updates.append(update)
        
        return updates
    
    def _determine_strength(self, pattern: Pattern) -> str:
        """
        Определяет силу паттерна.
        """
        significance = pattern.significance
        
        if significance > 0.8 and pattern.observation_count > 50:
            return 'strong'
        elif significance > 0.5:
            return 'medium'
        else:
            return 'weak'
    
    def _update_confidence(
        self,
        old_confidence: float,
        pattern: Pattern,
        strength: str
    ) -> float:
        """
        Обновляет confidence на основе паттерна.
        """
        delta = self.CONFIDENCE_DELTA.get(strength, 0.05)
        
        if self._is_confirming(pattern):
            # Паттерн подтверждает ожидание → confidence растёт
            new_confidence = min(0.95, old_confidence + delta)
        else:
            # Паттерн опровергает ожидание → confidence падает
            new_confidence = max(0.1, old_confidence - delta)
        
        return round(new_confidence, 4)
    
    def _update_weight(self, old_weight: float, pattern: Pattern, strength: str) -> float:
        """
        Обновляет weight на основе паттерна.
        """
        delta = self.WEIGHT_DELTA.get(strength, 0.05)
        
        if self._is_confirming(pattern):
            # Паттерн подтверждает → weight растёт
            new_weight = min(2.0, old_weight + delta)
        else:
            # Паттерн опровергает → weight падает
            new_weight = max(0.3, old_weight - delta)
        
        return round(new_weight, 4)
    
    def _determine_status(self, kb_entry: KnowledgeBase) -> str:
        """
        Определяет статус записи в базе знаний.
        """
        if kb_entry.confidence > 0.8 and kb_entry.observations_count > 100:
            return 'active'
        elif kb_entry.confidence > 0.5 and kb_entry.observations_count > 50:
            return 'pending_review'
        elif kb_entry.confidence < 0.2 and kb_entry.observations_count > 30:
            return 'deprecated'
        else:
            return kb_entry.status
