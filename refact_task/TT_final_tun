# src/core/simulation_mode.py

from typing import Dict, List, Optional
from datetime import datetime, timedelta
import numpy as np

class SimulationMode:
    """
    Режим симуляции — прогон без изменения продакшена.
    """
    
    async def simulate(
        self,
        config: Dict,
        historical_data: List[Dict],
        simulation_type: str = 'what_if'
    ) -> Dict:
        """
        Запускает симуляцию.
        """
        if simulation_type == 'what_if':
            return await self._what_if_simulation(config, historical_data)
        elif simulation_type == 'comparative':
            return await self._comparative_simulation(config, historical_data)
        else:
            return {'error': f'Unknown simulation type: {simulation_type}'}
    
    async def _what_if_simulation(
        self,
        config: Dict,
        historical_data: List[Dict]
    ) -> Dict:
        """
        Симуляция "что если?".
        """
        # 1. Текущая производительность
        current_performance = await self._evaluate_performance(
            historical_data,
            config.get('current_config', {})
        )
        
        # 2. Новая производительность
        new_performance = await self._evaluate_performance(
            historical_data,
            config.get('new_config', {})
        )
        
        # 3. Разница
        delta = new_performance - current_performance
        
        return {
            'simulation_type': 'what_if',
            'current': current_performance,
            'proposed': new_performance,
            'delta': delta,
            'delta_percent': round(delta / current_performance * 100, 2) if current_performance else 0,
            'recommendation': self._get_recommendation(delta)
        }
    
    async def _comparative_simulation(
        self,
        config: Dict,
        historical_data: List[Dict]
    ) -> Dict:
        """
        Сравнительная симуляция нескольких конфигураций.
        """
        results = {}
        
        for name, conf in config.get('configs', {}).items():
            performance = await self._evaluate_performance(
                historical_data,
                conf
            )
            results[name] = performance
        
        # Сортировка по производительности
        sorted_results = sorted(
            results.items(),
            key=lambda x: x[1],
            reverse=True
        )
        
        return {
            'simulation_type': 'comparative',
            'results': dict(sorted_results),
            'best': sorted_results[0][0] if sorted_results else None,
            'worst': sorted_results[-1][0] if sorted_results else None
        }
    
    async def _evaluate_performance(
        self,
        data: List[Dict],
        config: Dict
    ) -> float:
        """
        Оценивает производительность конфигурации.
        """
        weights = config.get('weights', {
            'clarity': 0.3,
            'synchronicity': 0.3,
            'resource': 0.3,
            'inertia': 0.1
        })
        
        errors = []
        for item in data:
            predicted = (
                item['clarity'] * weights['clarity'] +
                item['synchronicity'] * weights['synchronicity'] +
                item['resource'] * weights['resource'] -
                item['inertia'] * weights['inertia']
            )
            predicted = max(0, min(1, predicted))
            errors.append((predicted - item['actual_outcome']) ** 2)
        
        return 1 - (sum(errors) / len(errors)) if errors else 0
    
    def _get_recommendation(self, delta: float) -> str:
        """
        Возвращает рекомендацию на основе дельты.
        """
        if delta > 0.05:
            return "Рекомендуется применить новую конфигурацию"
        elif delta > 0.02:
            return "Новая конфигурация немного лучше, можно применить"
        elif delta > -0.02:
            return "Изменения незначительны, можно не применять"
        else:
            return "Новая конфигурация хуже, не рекомендуется"
