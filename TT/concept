### 8.3. Реализация кеширования с JSON-кодировщиком

```python
# cache/manager.py
import redis
import json
from datetime import datetime, date
from typing import Optional, Any, Dict
from config.version import VERSION_MANAGER

# ============================================================
# ОБЯЗАТЕЛЬНО: JSON-кодировщик для поддержки datetime
# ============================================================
class DateTimeEncoder(json.JSONEncoder):
    """
    JSON-кодировщик с поддержкой datetime и date объектов.
    
    Без этого кодировщика Redis падает с ошибкой:
    TypeError: Object of type datetime is not JSON serializable
    """
    def default(self, obj: Any) -> Any:
        if isinstance(obj, (datetime, date)):
            return obj.isoformat()
        if hasattr(obj, '__dict__'):
            return obj.__dict__
        return super().default(obj)

class CacheManager:
    def __init__(self, redis_client: redis.Redis):
        self.redis = redis_client
    
    def get(self, key: str) -> Optional[Dict[str, Any]]:
        """Получить объект из кеша."""
        data = self.redis.get(key)
        if data:
            return json.loads(data)
        return None
    
    def set(self, key: str, value: Dict[str, Any], ttl: Optional[int] = None):
        """
        Сохранить объект в кеш.
        
        ВНИМАНИЕ: Всегда использует DateTimeEncoder для корректной сериализации.
        """
        # Добавляем метаданные кеша
        value["_cache_metadata"] = {
            "cached_at": datetime.now().isoformat(),
            "rules_version": VERSION_MANAGER.get_cache_version()
        }
        
        # Используем кастомный кодировщик для поддержки datetime
        self.redis.set(
            key, 
            json.dumps(value, cls=DateTimeEncoder), 
            ex=ttl
        )
    
    def delete_pattern(self, pattern: str):
        """Удалить все объекты по паттерну."""
        for key in self.redis.scan_iter(match=pattern):
            self.redis.delete(key)

class StaticCache:
    def __init__(self, cache_manager: CacheManager):
        self.cache = cache_manager
    
    def get_or_calculate(self, user_id: str, calculate_func, key_suffix: str = "") -> Dict[str, Any]:
        """Получить статический объект из кеша или рассчитать."""
        cache_version = VERSION_MANAGER.get_cache_version()
        key = f"static_{key_suffix}:{cache_version}:{user_id}" if key_suffix else f"static:{cache_version}:{user_id}"
        
        cached = self.cache.get(key)
        if cached:
            return cached
        
        result = calculate_func()
        self.cache.set(key, result, ttl=None)
        return result
    
    def invalidate(self, user_id: str):
        """Инвалидировать весь статический кеш пользователя."""
        cache_version = VERSION_MANAGER.get_cache_version()
        self.cache.delete_pattern(f"*:{cache_version}:{user_id}")

class DynamicCache:
    def __init__(self, cache_manager: CacheManager):
        self.cache = cache_manager
    
    def get_or_calculate(
        self, 
        user_id: str, 
        date: str, 
        calculate_func, 
        ttl: int, 
        key_prefix: str = ""
    ) -> Dict[str, Any]:
        """Получить динамический объект из кеша или рассчитать."""
        key = f"{key_prefix}:{user_id}:{date}" if key_prefix else f"dynamic:{user_id}:{date}"
        
        cached = self.cache.get(key)
        if cached:
            return cached
        
        result = calculate_func()
        self.cache.set(key, result, ttl=ttl)
        return result
```

