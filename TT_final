from core.models import BirthData
from utils.time_module import TimeModule
from constants.astrology_mapping import (
    calculate_dignity, get_sign, normalize_speed, get_house
)


def calculate_static_core(birth_data: BirthData) -> Dict[str, Any]:
    """
    Рассчитывает статическое астрономическое ядро.
    
    Args:
        birth_data: Данные рождения (с разрешёнными координатами)
    
    Returns:
        dict: StaticCore
    
    Raises:
        ValueError: Если координаты не разрешены
        RuntimeError: Если Swiss Ephemeris вернул ошибку
    """
    if birth_data.lat is None or birth_data.lng is None or birth_data.timezone is None:
        raise ValueError("BirthData must have resolved coordinates and timezone")
    
    utc_dt = birth_data.to_utc_datetime()
    jd = TimeModule.to_julian_day(utc_dt)
    
    # Solar Time
    solar_time = calculate_solar_time(jd, birth_data.lng, birth_data.lat, birth_data.timezone)
    
    # Планеты (ОДИН вызов calc_ut)
    all_coords = ephemeris.calc_ut(jd)
    if not all_coords:
        raise RuntimeError("No ephemeris data returned")
    
    planets = {}
    for name, pos in all_coords.items():
        planets[name] = {
            "longitude": pos.longitude,
            "latitude": pos.latitude,
            "speed": pos.speed_long,
            "speed_normalized": normalize_speed(name, pos.speed_long),
            "retrograde": pos.retrograde,
            "sign": get_sign(pos.longitude),
            "sign_longitude": pos.longitude % 30,
            "dignity": calculate_dignity(name, pos.longitude)
        }
    
    # Дома (Placidus)
    houses = calculate_houses_placidus(jd, birth_data.lat, birth_data.lng)
    
    # Привязка к домам
    for name, data in planets.items():
        data["house"] = get_house(data["longitude"], houses)
    
    # Аспекты
    aspects = calculate_aspects(planets)
    
    # Айанамша
    ayanamsa = ephemeris.get_ayanamsa(jd)
    
    # День/ночь
    is_daytime = check_daytime(planets["Sun"]["longitude"], houses)
    
    core_hash = hashlib.md5(str(birth_data.model_dump()).encode()).hexdigest()[:8]
    
    from config.version import VERSION_MANAGER
    
    return {
        "jd": jd,
        "utc_datetime": utc_dt.isoformat(),
        "solar_time": solar_time,
        "ayanamsa": ayanamsa,
        "ayanamsa_type": "lahiri",
