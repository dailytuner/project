### 12.2. Менеджер настроек

```python
# config/settings_manager.py
from typing import Any, Optional
import json
import os
from functools import lru_cache


class SettingsManager:
    """
    Гибридный менеджер настроек.
    
    Приоритет:
    1. Database (если есть) — динамические
    2. Environment — статические
    3. Defaults — жёстко закодированные
    """
    
    DEFAULTS = {
        "min_dynamic_confidence": 0.10,
        "cluster_threshold": 0.70,
        "n_max": 5,
        "enable_psychomatrix": True,
        "enable_biorhythms": True,
        "enable_nine_vector": True,
        "enable_western": True,
        "enable_vedic": True,
        "enable_arabic": True,
        "enable_chinese": True,
        "enable_maya": True,
        "enable_mesopotamian": True,
        "enable_transits": True,
    }
    
    def __init__(self, db_pool=None):
        self.db_pool = db_pool
        self._cache: dict = {}
    
    def get(self, key: str, default: Any = None) -> Any:
        """Получить настройку с приоритетом."""
        if key in self._cache:
            return self._cache[key]
        
        if self.db_pool:
            db_value = self._get_from_db(key)
            if db_value is not None:
                self._cache[key] = db_value
                return db_value
        
        env_key = key.upper()
        if env_key in os.environ:
            value = self._parse_env(os.environ[env_key])
            self._cache[key] = value
            return value
        
        if key in self.DEFAULTS:
            return self.DEFAULTS[key]
        
        return default
    
    def set(self, key: str, value: Any, updated_by: str = "system") -> None:
        """Установить настройку (только в БД)."""
        if not self.db_pool:
            raise RuntimeError("Database not configured")
        
        with self.db_pool.getconn() as conn:
            with conn.cursor() as cur:
                cur.execute("""
                    INSERT INTO settings (key, value, updated_by)
                    VALUES (%s, %s, %s)
                    ON CONFLICT (key) DO UPDATE
                    SET value = EXCLUDED.value,
                        updated_at = NOW(),
                        updated_by = EXCLUDED.updated_by
                """, (key, json.dumps({"value": value}), updated_by))
            conn.commit()
        
        self._cache.pop(key, None)
    
    def invalidate_cache(self):
        """Очистить локальный кэш (после изменения в БД)."""
        self._cache.clear()
    
    def _get_from_db(self, key: str) -> Optional[Any]:
        """Получить из БД."""
        try:
            with self.db_pool.getconn() as conn:
                with conn.cursor() as cur:
                    cur.execute("SELECT value FROM settings WHERE key = %s", (key,))
                    row = cur.fetchone()
                    if row:
                        return row[0].get("value")
        except Exception:
            return None
        return None
    
    @staticmethod
    def _parse_env(value: str) -> Any:
        """Парсит env-значение в правильный тип."""
        if value.lower() in ("true", "1", "yes"):
            return True
        if value.lower() in ("false", "0", "no"):
            return False
        try:
            return int(value)
        except ValueError:
            pass
        try:
            return float(value)
        except ValueError:
            pass
        return value


# Глобальный экземпляр
settings_manager: Optional[SettingsManager] = None


def init_settings(db_pool=None):
    """Инициализация менеджера настроек."""
    global settings_manager
    settings_manager = SettingsManager(db_pool)


def get_settings() -> SettingsManager:
    """Получить менеджер настроек."""
    if settings_manager is None:
        raise RuntimeError("SettingsManager not initialized")
    return settings_manager
