## 3. Структура базы данных

### 3.1. Таблицы в схеме psych

```sql
-- ============================================================
-- СХЕМА PSYCH (ТАБЛИЦЫ ДЛЯ ALIGNMENT ENGINE)
-- ============================================================

CREATE SCHEMA IF NOT EXISTS psych;

-- 1. Результаты сопоставления профилей
CREATE TABLE psych.profile_alignments (
    id SERIAL PRIMARY KEY,
    user_id INTEGER NOT NULL,
    alignment_date DATE NOT NULL,
    
    -- Общая когерентность
    coherence_score FLOAT NOT NULL CHECK (coherence_score BETWEEN 0 AND 1),
    coherence_level VARCHAR(20) CHECK (coherence_level IN ('high', 'medium', 'low')),
    
    -- Детали по типам сопоставления
    house_alignments JSONB,
    dasha_alignments JSONB,
    retro_alignments JSONB,
    element_alignments JSONB,
    dynamic_alignments JSONB,
    
    -- Диссонансы
    dissonance_analysis JSONB,
    dissonance_count INTEGER DEFAULT 0,
    needs_review BOOLEAN DEFAULT false,
    
    -- Шаблонные объяснения (БЕЗ LLM!)
    recommendations TEXT,
    
    -- Метаданные
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    UNIQUE(user_id, alignment_date),
    INDEX idx_alignments_user_date (user_id, alignment_date),
    INDEX idx_alignments_coherence (coherence_score),
    INDEX idx_alignments_needs_review (needs_review)
);

-- 2. Анализ диссонансов
CREATE TABLE psych.dissonance_analysis (
    id SERIAL PRIMARY KEY,
    alignment_id INTEGER REFERENCES psych.profile_alignments(id) ON DELETE CASCADE,
    user_id INTEGER NOT NULL,
    
    dissonance_type VARCHAR(30) CHECK (dissonance_type IN ('house', 'dasha', 'retro', 'element', 'dynamic')),
    source VARCHAR(50),
    expected_state VARCHAR(50),
    actual_state VARCHAR(50),
    psych_scale VARCHAR(20),
    severity FLOAT CHECK (severity BETWEEN 0 AND 1),
    
    hypothesis TEXT,
    resolved BOOLEAN DEFAULT false,
    resolution_notes TEXT,
    
    created_at TIMESTAMPTZ DEFAULT NOW(),
    resolved_at TIMESTAMPTZ,
    
    INDEX idx_dissonance_user (user_id),
    INDEX idx_dissonance_resolved (resolved),
    INDEX idx_dissonance_type (dissonance_type)
);

-- 3. База знаний для сопоставления
CREATE TABLE psych.alignment_knowledge_base (
    id SERIAL PRIMARY KEY,
    knowledge_type VARCHAR(30) CHECK (knowledge_type IN ('house', 'dasha', 'retro', 'element', 'dynamic')),
    factor_name VARCHAR(50) NOT NULL,
    
    expected_effect VARCHAR(20) CHECK (expected_effect IN ('increasing', 'decreasing', 'variable', 'neutral')),
    affected_scales TEXT[],
    
    weight FLOAT DEFAULT 1.0 CHECK (weight BETWEEN 0 AND 2),
    
    observations_count INTEGER DEFAULT 0,
    confirmation_count INTEGER DEFAULT 0,
    dissonance_count INTEGER DEFAULT 0,
    confidence FLOAT DEFAULT 0.5 CHECK (confidence BETWEEN 0 AND 1),
    
    status VARCHAR(20) DEFAULT 'active' CHECK (status IN ('active', 'deprecated', 'pending_review')),
    
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    UNIQUE(knowledge_type, factor_name),
    INDEX idx_kb_factor (factor_name),
    INDEX idx_kb_status (status)
);

-- 4. Расписание расчётов
CREATE TABLE psych.alignment_schedule (
    id SERIAL PRIMARY KEY,
    user_id INTEGER NOT NULL UNIQUE,
    last_calculated_at TIMESTAMPTZ,
    last_test_processed_at TIMESTAMPTZ,
    calculation_status VARCHAR(20) DEFAULT 'pending',
    error_message TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    INDEX idx_schedule_user (user_id),
    INDEX idx_schedule_status (calculation_status)
);

-- ============================================================
-- ТРИГГЕРЫ
-- ============================================================

CREATE OR REPLACE FUNCTION psych.update_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER update_alignments_updated_at
    BEFORE UPDATE ON psych.profile_alignments
    FOR EACH ROW EXECUTE FUNCTION psych.update_updated_at();

CREATE TRIGGER update_kb_updated_at
    BEFORE UPDATE ON psych.alignment_knowledge_base
    FOR EACH ROW EXECUTE FUNCTION psych.update_updated_at();

CREATE TRIGGER update_schedule_updated_at
    BEFORE UPDATE ON psych.alignment_schedule
    FOR EACH ROW EXECUTE FUNCTION psych.update_updated_at();
```

