def cluster_theses(theses: List[Thesis]) -> List[List[Thesis]]:
    """
    Кластеризует тезисы по косинусному расстоянию.
    Использует фиксированный порог 0.7.
    
    Args:
        theses: Список тезисов
    
    Returns:
        List[List[Thesis]]: Список кластеров
    
    Обоснование:
        Порог 0.7 — эмпирический баланс между объединением и разделением.
        При 0.6: слишком много ложных объединений.
        При 0.8: слишком много изолированных тезисов.
        0.7 дает оптимальное число кластеров (~8-12 для 47 тезисов).
    """
    threshold = 0.7
    clusters = []
    used: Set[int] = set()
    
    for i, t1 in enumerate(theses):
        if i in used:
            continue
        
        cluster = [t1]
        used.add(i)
        
        for j, t2 in enumerate(theses[i+1:], start=i+1):
            if j in used:
                continue
            
            similarity = cosine_similarity(t1.sphere_vector, t2.sphere_vector)
            if similarity >= threshold:
                cluster.append(t2)
                used.add(j)
        
        if cluster:
            clusters.append(cluster)
    
    return clusters

def cosine_similarity(v1: List[float], v2: List[float]) -> float:
    """
    Косинусное расстояние между двумя векторами (12 измерений).
    
    Args:
        v1: Первый вектор
        v2: Второй вектор
    
    Returns:
        float: Косинусное сходство (0-1)
    """
    # Использование numpy для ускорения (рекомендуется)
    try:
        import numpy as np
        v1_np = np.array(v1)
        v2_np = np.array(v2)
        norm1 = np.linalg.norm(v1_np)
        norm2 = np.linalg.norm(v2_np)
        if norm1 == 0 or norm2 == 0:
            return 0.0
        return float(np.dot(v1_np, v2_np) / (norm1 * norm2))
    except ImportError:
        # Fallback для чистого Python
        dot = sum(a * b for a, b in zip(v1, v2))
        n1 = math.sqrt(sum(a * a for a in v1))
        n2 = math.sqrt(sum(b * b for b in v2))
        if n1 == 0 or n2 == 0:
            return 0.0
        return dot / (n1 * n2)
```

