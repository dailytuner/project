```python
# services/astro_profile_service.py

class AstroProfileService:
    """
    Строит астро-профиль для Alignment Engine.
    """
    
    def __init__(
        self,
        ephemeris_service: EphemerisService,
        vimshottari_engine: VimshottariEngine,
        aspect_engine: AspectEngine,
        house_engine: HouseEngine,
        retro_engine: RetroEngine,
        element_engine: ElementEngine
    ):
        self.ephemeris = ephemeris_service
        self.vimshottari = vimshottari_engine
        self.aspect = aspect_engine
        self.house = house_engine
        self.retro = retro_engine
        self.element = element_engine
    
    async def build_profile(
        self,
        user_id: int,
        date: date,
        session: AsyncSession
    ) -> Dict:
        """
        Строит полный астро-профиль для Alignment Engine.
        """
        # 1. Загружаем натальную карту
        natal = await self._get_natal(user_id, session)
        
        # 2. Рассчитываем транзиты
        transits = await self.ephemeris.get_planets_for_date(date)
        
        # 3. Рассчитываем даши
        dasha_state = await self._get_dasha(user_id, date, session)
        
        # 4. Определяем дома транзитов
        transit_houses = {
            'saturn_house': self.house.get_house(transits['Saturn'].longitude, natal.ascendant),
            'jupiter_house': self.house.get_house(transits['Jupiter'].longitude, natal.ascendant),
            'rahu_house': self.house.get_house(transits['Rahu'].longitude, natal.ascendant),
            'moon_house': self.house.get_house(transits['Moon'].longitude, natal.ascendant),
        }
        
        # 5. Определяем знаки и фазы
        moon_sign = self._get_sign(transits['Moon'].longitude)
        moon_phase = self._get_moon_phase(transits['Moon'], transits['Sun'])
        
        # 6. Определяем ретроградность
        retro_planets = self.retro.get_retrograde_planets(transits)
        
        # 7. Определяем стихии
        elements = self.element.get_elements(transits)
        
        # 8. Рассчитываем confidence
        confidence = self._calculate_confidence(natal, transits)
        
        return {
            "user_id": user_id,
            "date": date.isoformat(),
            "dasha": {
                "maha": dasha_state.maha.planet,
                "antar": dasha_state.antar.planet,
                "pratyantar": dasha_state.pratyantar.planet,
            },
            "transits": {
                "saturn_house": transit_houses['saturn_house'],
                "jupiter_house": transit_houses['jupiter_house'],
                "rahu_house": transit_houses['rahu_house'],
                "moon_house": transit_houses['moon_house'],
                "moon_sign": moon_sign,
                "moon_phase": moon_phase,
            },
            "retro": {
                "mercury": 'Mercury' in retro_planets,
                "venus": 'Venus' in retro_planets,
                "mars": 'Mars' in retro_planets,
            },
            "elements": elements,
            "confidence": confidence,
            "calculated_at": datetime.now().isoformat()
        }
