### 12.3. Инициализация БД при старте

```python
# db/init.py
import psycopg2
from pathlib import Path
import logging
from typing import Optional

logger = logging.getLogger(__name__)

def init_database(database_url: str) -> None:
    """
    Инициализирует базу данных при старте приложения.
    
    Проверяет существование таблиц и создает их при необходимости.
    Использует упрощенный подход без Alembic.
    
    Args:
        database_url: URL подключения к PostgreSQL
    
    Raises:
        RuntimeError: Если не удалось инициализировать БД
    """
    try:
        conn = psycopg2.connect(database_url)
    except Exception as e:
        raise RuntimeError(f"Failed to connect to database: {e}")
    
    try:
        with conn.cursor() as cur:
            # Проверка существования таблиц
            cur.execute("""
                SELECT EXISTS (
                    SELECT FROM information_schema.tables 
                    WHERE table_name = 'users'
                )
            """)
            exists = cur.fetchone()[0]
            
            if exists:
                logger.info("Database tables already exist, skipping initialization")
                return
            
            # Читаем и выполняем init.sql
            sql_path = Path(__file__).parent / "init.sql"
            if not sql_path.exists():
                raise FileNotFoundError(f"init.sql not found at {sql_path}")
            
            sql = sql_path.read_text()
            cur.execute(sql)
            conn.commit()
            
            logger.info("Database initialized successfully from init.sql")
    
    except Exception as e:
        logger.error(f"Database initialization failed: {e}")
        raise RuntimeError(f"Database initialization failed: {e}")
    finally:
        conn.close()
