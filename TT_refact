### 4.1. Схема `psych` (5 таблиц + 1 конфиг)

```sql
-- ============================================================
-- 1. ПОЛНЫЙ ПРОФИЛЬ (раз в месяц)
-- ============================================================

CREATE TABLE psych.full_profiles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id INTEGER NOT NULL,
    taken_at TIMESTAMP NOT NULL DEFAULT NOW(),
    
    -- T-scores (на основе 50-100 вопросов)
    t_scores JSONB NOT NULL,
    -- { "d": 65.2, "pt": 55.0, "pa": 48.5, "ma": 43.0, "si": 52.0 }
    
    -- Baseline для калибровки
    baseline JSONB,
    
    -- Осознанность
    awareness_level VARCHAR(10) CHECK (awareness_level IN ('HIGH', 'MEDIUM', 'LOW')),
    awareness_tip TEXT,
    awareness_practice TEXT,
    
    -- Валидность
    is_valid BOOLEAN DEFAULT true,
    validity_details JSONB,
    
    -- Астро-контекст
    astro_context JSONB,
    
    -- Idempotency Key
    idempotency_key VARCHAR(64) UNIQUE,
    
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    INDEX idx_full_user (user_id, taken_at DESC)
);

-- ============================================================
-- 2. СОСТОЯНИЯ (ежедневно)
-- ============================================================

CREATE TABLE psych.states (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id INTEGER NOT NULL,
    state_date DATE NOT NULL,
    calculated_at TIMESTAMP NOT NULL DEFAULT NOW(),
    
    -- 3 метрики (0-1)
    energy_score FLOAT CHECK (energy_score BETWEEN 0 AND 1),
    anxiety_score FLOAT CHECK (anxiety_score BETWEEN 0 AND 1),
    emotional_score FLOAT CHECK (emotional_score BETWEEN 0 AND 1),
    
    -- Уровень
    state_level VARCHAR(10) CHECK (state_level IN ('HIGH', 'MEDIUM', 'LOW')),
    state_summary TEXT,
    
    -- Осознанность (из полного профиля или расчётная)
    awareness_level VARCHAR(10),
    awareness_tip TEXT,
