## 4. Новые страницы и компоненты

### 4.1. Страница сопоставления профилей

```typescript
// pages/Alignment/index.tsx

import { useAlignment } from '../../hooks/useAlignment';
import { AstroProfileCard } from './components/AstroProfileCard';
import { PsychProfileCard } from './components/PsychProfileCard';
import { AlignmentMap } from './components/AlignmentMap';
import { CoherenceScoreCard } from './components/CoherenceScoreCard';
import { DissonanceList } from './components/DissonanceList';

export const Alignment = () => {
  const { alignment, loading, error } = useAlignment();

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage error={error} />;
  if (!alignment) return <EmptyState />;

  return (
    <div className="alignment-page">
      <div className="header">
        <h1>Сопоставление профилей</h1>
        <p className="date">{alignment.date}</p>
      </div>

      {/* Общая когерентность */}
      <CoherenceScoreCard
        score={alignment.coherence_score}
        level={alignment.coherence_level}
      />

      {/* Два профиля */}
      <div className="profiles-grid">
        <AstroProfileCard profile={alignment.astro_profile} />
        <PsychProfileCard profile={alignment.psych_profile} />
      </div>

      {/* Карта сопоставлений */}
      <AlignmentMap alignments={alignment.alignments} />

      {/* Диссонансы */}
      {alignment.dissonances.length > 0 && (
        <DissonanceList dissonances={alignment.dissonances} />
      )}

      {/* Объяснения */}
      <div className="recommendations">
        <h3>Объяснение</h3>
        <p>{alignment.recommendations}</p>
      </div>
    </div>
  );
};
```

