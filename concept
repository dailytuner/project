            return {"days": dasha_period * 36.5 * 0.1, "type": "high"}
        else:
            return {"days": dasha_period * 36.5 * 0.05, "type": "medium"}
    
    elif thesis_type == "arabic_part":
        return {"days": 7, "type": "high"}
    
    else:
        return {"days": 30, "type": "medium"}
