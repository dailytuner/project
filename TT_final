## 17. АЛГОРИТМЫ И ПСЕВДОКОД

### 17.1. Полный конвейер (ASYNC)

```python
# main.py
import asyncio
from concurrent.futures import ThreadPoolExecutor
from fastapi import FastAPI, HTTPException
from typing import Optional

_executor = ThreadPoolExecutor(max_workers=4, thread_name_prefix="ephemeris")


async def calculate_profile_v7(
    birth_data_dict: dict,
    current_date: Optional[str] = None,
    mode: str = "daily",
    horizon_days: int = 90
) -> dict:
    """
    Главный асинхронный конвейер v7.0.
    
    Все CPU-bound вызовы (Swiss Ephemeris) — через run_in_executor.
    Геокодинг — асинхронный (сетевой I/O).
    """
    # 1. Валидация
    birth_data = BirthData(**birth_data_dict)
    
    # 2. Геокодинг
    if birth_data.location and (birth_data.lat is None or birth_data.lng is None):
        birth_data = await birth_data.resolve_location()
    
    loop = asyncio.get_running_loop()
    
    # 3. Статическое ядро
    static_core = await _get_or_calculate_static(
        user_id=birth_data.user_id,
        calculate_func=lambda: calculate_static_core(birth_data),
        loop=loop
    )
    
    # 4. Портрет — ранний выход
    if mode == "portrait":
        static_theses = await _get_or_calculate_static(
            user_id=birth_data.user_id,
            calculate_func=lambda: generate_static_theses(static_core),
            loop=loop
        )
        static_integration = await _get_or_calculate_static(
            user_id=birth_data.user_id,
            calculate_func=lambda: integrate_static(static_theses),
            loop=loop
        )
        return create_portrait_profile(static_integration, birth_data.user_id)
    
    # 5. Динамическое ядро
    date_obj = _parse_date(current_date)
    dynamic_core = await loop.run_in_executor(
        _executor,
        calculate_dynamic_core,
        static_core, date_obj, horizon_days
    )
    
    # 6-7. Статические тезисы и интеграция
    static_theses = await _get_or_calculate_static(
        birth_data.user_id,
        lambda: generate_static_theses(static_core),
        loop
    )
    static_integration = await _get_or_calculate_static(
        birth_data.user_id,
        lambda: integrate_static(static_theses),
        loop
    )
    
    # 8. Динамические тезисы
    dynamic_theses = await loop.run_in_executor(
        _executor,
        generate_dynamic_theses,
        dynamic_core, static_core, date_obj
    )
    
    # 9. Temporal confidence
    for thesis in dynamic_theses:
        thesis.confidence = await loop.run_in_executor(
            _executor,
            calculate_temporal_confidence,
            thesis, static_core, dynamic_core, date_obj
        )
    
    # 10. Динамическая интеграция
    dynamic_signals = await loop.run_in_executor(
        _executor,
        integrate_dynamic,
        dynamic_theses, static_integration, date_obj, horizon_days
    )
    
    # 11. Профиль
    profile = create_daily_profile(
        static_integration, dynamic_signals,
        birth_data.user_id, date_obj, horizon_days
    )
    
    # 12. Кеширование
    await _cache_daily_profile(birth_data.user_id, current_date, profile)
    
    return profile


async def _get_or_calculate_static(user_id: str, calculate_func, loop) -> dict:
    """Получить статику из кеша или рассчитать через executor."""
    cached = await static_cache.get_async(user_id)
    if cached:
        return cached
    
    result = await loop.run_in_executor(_executor, calculate_func)
    await static_cache.set_async(user_id, result)
    return result


def _parse_date(current_date: Optional[str]) -> datetime:
    if current_date is None:
        return get_current_utc()
    return datetime.strptime(current_date, "%Y-%m-%d")
