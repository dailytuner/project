# core/snapshot_writer.py

class SnapshotWriter:
    """
    Запись снапшотов в Data Lake.
    """
    
    def __init__(self, lake_client: LakeClient):
        self.lake_client = lake_client
    
    async def write_weekly_snapshot(
        self,
        session: AsyncSession,
        dissonance_groups: List[DissonanceGroup],
        patterns: List[Pattern]
    ):
        """
        Записывает еженедельный снапшот.
        """
        data = {
            'snapshot_date': date.today().isoformat(),
            'snapshot_type': 'weekly',
            'dissonance_groups': [
                {
                    'factor_name': g.factor_name,
                    'dissonance_count': g.dissonance_count,
                    'unique_users': g.unique_users,
                    'avg_severity': g.avg_severity
                }
                for g in dissonance_groups
            ],
            'patterns': [
                {
                    'factor_name': p.factor_name,
                    'expected_effect': p.expected_effect,
                    'actual_pattern': p.actual_pattern,
                    'significance': p.significance,
                    'hypothesis': p.hypothesis
                }
                for p in patterns
            ]
        }
        
        key = f"analytics/weekly/snapshot_{date.today().isoformat()}.parquet"
        await self.lake_client.upload(key, self._to_parquet(data))
        
        # Сохраняем в БД
        await self._save_snapshot(session, 'weekly', key)
    
    async def write_quarterly_snapshot(
        self,
        session: AsyncSession,
        stats: Dict
    ) -> str:
        """
        Записывает ежеквартальный снапшот.
        """
        # 1. Загружаем текущую базу знаний
        kb = await self._get_knowledge_base(session)
        
        # 2. Загружаем паттерны
        patterns = await self._get_patterns(session)
        
        data = {
            'snapshot_date': date.today().isoformat(),
            'snapshot_type': 'quarterly',
            'knowledge_base': kb,
            'patterns': patterns,
            'statistics': stats,
            'generated_at': datetime.now().isoformat()
        }
        
        key = f"analytics/quarterly/snapshot_{date.today().isoformat()}.parquet"
        await self.lake_client.upload(key, self._to_parquet(data))
        
        # Сохраняем в БД
        await self._save_snapshot(session, 'quarterly', key)
        
        return key
