def validate_core(planets, houses, aspects):
    errors = []
    warnings = []
    
    # 1. Солнце: знак должен соответствовать градусу
    sun_sign = planets["Sun"]["sign"]
    sun_deg = planets["Sun"]["sign_longitude"]
    expected_sign = get_sign_by_degree(sun_deg)
    if sun_sign != expected_sign:
        errors.append(f"Sun sign mismatch: {sun_sign} != {expected_sign}")
    
    # 2. Луна: скорость в диапазоне 12-15°/сутки
    moon_speed = planets["Moon"]["speed"]
    if not (12 <= moon_speed <= 15):
        warnings.append(f"Moon speed abnormal: {moon_speed}")
    
    # 3. Дома: куспиды по возрастанию
    house_cusps = [houses[i]["cusp"] for i in range(1, 13)]
    if not all(house_cusps[i] < house_cusps[i+1] for i in range(11)):
        errors.append("House cusps not in ascending order")
    
    return {
        "is_valid": len(errors) == 0,
        "errors": errors,
        "warnings": warnings
    }
