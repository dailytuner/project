def get_partition_path(base_path: str, timestamp: datetime) -> str:
    """
    Возвращает путь с партициями.
    """
    return f"{base_path}/year={timestamp.year}/month={timestamp.month:02d}/day={timestamp.day:02d}"

def get_user_file_path(base_path: str, user_id: UUID, timestamp: datetime) -> str:
    """
    Возвращает путь для конкретного пользователя.
    """
    partition = get_partition_path(base_path, timestamp)
    return f"{partition}/user_{user_id}_{timestamp.strftime('%Y%m%d%H%M%S')}.parquet"
