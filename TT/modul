def compare_matrices(matrix1: Dict[str, Any], matrix2: Dict[str, Any]) -> Dict[str, Any]:
    comp = {'overall_score': 0, 'strengths': [], 'challenges': [], 'recommendations': []}
    calc = PsyhoMatrixCalculator()
    r1 = calc._reduction_with_masters(matrix1['first_number'])
    r2 = calc._reduction_with_masters(matrix2['first_number'])
    
    if r2 in COMPATIBILITY_MAP.get(r1, []):
        comp['overall_score'] += 30
        comp['strengths'].append("Natural compatibility")
    
    levels = ['very_low', 'low', 'medium', 'high', 'very_high']
    e1, e2 = matrix1['energy_level'], matrix2['energy_level']
    if e1 in levels and e2 in levels:
        diff = abs(levels.index(e1) - levels.index(e2))
        if diff <= 1:
            comp['overall_score'] += 20
            comp['strengths'].append("Balanced energy")
        elif diff >= 3:
            comp['overall_score'] -= 10
            comp['challenges'].append("Energy imbalance")
    
    if matrix1['fourth_number'] == matrix2['fourth_number']:
        comp['overall_score'] += 20
        comp['strengths'].append("Shared purpose")
    
    common = set(matrix1['talent_codes']) & set(matrix2['talent_codes'])
    if common:
        comp['overall_score'] += len(common) * 5
        comp['strengths'].append(f"Shared talents: {len(common)} areas")
    
    comp['overall_score'] = max(0, min(100, comp['overall_score']))
    if comp['overall_score'] >= 70:
        comp['recommendations'].append("Strong potential")
    elif comp['overall_score'] >= 50:
        comp['recommendations'].append("Good foundation, requires work")
    else:
        comp['recommendations'].append("Need understanding")
    return comp


