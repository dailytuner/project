// pages/AlignmentHistory/index.tsx

import { useAlignmentHistory } from '../../hooks/useAlignment';
import { CoherenceChart } from './components/CoherenceChart';

export const AlignmentHistory = () => {
  const { history, loading, error } = useAlignmentHistory('90d');

