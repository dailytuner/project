]

NAKSHATRA_LORDS = [
    "Ketu", "Venus", "Sun", "Moon", "Mars", "Rahu", "Jupiter", "Saturn", "Mercury"
] * 3

DASHA_ORDER = ["Ketu", "Venus", "Sun", "Moon", "Mars", "Rahu", "Jupiter", "Saturn", "Mercury"]
DASHA_YEARS = {
    "Ketu": 7, "Venus": 20, "Sun": 6, "Moon": 10, "Mars": 7,
    "Rahu": 18, "Jupiter": 16, "Saturn": 19, "Mercury": 17
}


def apply_ayanamsa(planets: dict, ayanamsa: float) -> dict:
    """Переводит тропические долготы в сидерические."""
    result = {}
    for name, data in planets.items():
        new_data = data.copy()
        new_data["tropical_longitude"] = data["longitude"]
        new_data["longitude"] = (data["longitude"] - ayanamsa) % 360
        new_data["sign"] = get_sign(new_data["longitude"])
        new_data["sign_longitude"] = new_data["longitude"] % 30
        result[name] = new_data
    return result


def calculate_nakshatra(moon_longitude: float) -> dict:
    """Определяет накшатру Луны."""
    NAKSHATRA_SIZE = 360 / 27
    PADA_SIZE = NAKSHATRA_SIZE / 4
    
    index = int(moon_longitude / NAKSHATRA_SIZE) % 27
    pada = int((moon_longitude % NAKSHATRA_SIZE) / PADA_SIZE) + 1
    
    return {
        "name": NAKSHATRAS[index],
        "index": index,
        "pada": pada,
        "lord": NAKSHATRA_LORDS[index],
        "strength": 1.0 - abs((moon_longitude % NAKSHATRA_SIZE) - NAKSHATRA_SIZE / 2) / (NAKSHATRA_SIZE / 2)
    }


def calculate_dasha(moon_data: dict, birth_data: dict) -> dict:
    """Рассчитывает Вимшоттари-дашу (120-летний цикл)."""
    from datetime import datetime
    
    moon_long = moon_data["longitude"]
    nakshatra = calculate_nakshatra(moon_long)
    
    start_lord = nakshatra["lord"]
    start_index = DASHA_ORDER.index(start_lord)
    
    nakshatra_progress = (moon_long % (360 / 27)) / (360 / 27)
    start_dasha_years = DASHA_YEARS[start_lord]
    elapsed_years = start_dasha_years * nakshatra_progress
    
    birth_date = datetime(
        birth_data["year"], birth_data["month"], birth_data["day"],
        birth_data["hour"], birth_data["minute"]
    )
    
    now = datetime.utcnow()
    years_since_birth = (now - birth_date).days / 365.25
    
    periods = []
    current_year = -elapsed_years
    dasha_index = start_index
    
    for _ in range(9):
        planet = DASHA_ORDER[dasha_index]
        duration = DASHA_YEARS[planet]
        period_start = current_year
        period_end = current_year + duration
        
        if period_start <= years_since_birth < period_end:
            progress = (years_since_birth - period_start) / duration
            periods.append({
                "planet": planet,
                "type": "mahadasha",
                "progress": progress,
                "start_year": period_start,
                "end_year": period_end,
                "is_current": True
            })
        
        current_year = period_end
        dasha_index = (dasha_index + 1) % 9
    
    return {"periods": periods}


def generate_vedic_theses(core: dict) -> List[Thesis]:
    """Генерирует тезисы ведической астрологии (макс ~15)."""
    theses = []
    sidereal_planets = apply_ayanamsa(core["planets"], core["ayanamsa"])
    
    nakshatra = calculate_nakshatra(sidereal_planets["Moon"]["longitude"])
    vector = get_nakshatra_vector(nakshatra["name"])
    sign = get_nakshatra_direction(nakshatra)
    
    thesis = Thesis(
        id=f"V_NAK_{nakshatra['name']}",
        system="vedic",
        sphere_vector=vector,
        sign=sign,
        claim=f"Накшатра {nakshatra['name']} (пада {nakshatra['pada']})",
        base_confidence=0.7 + (0.05 * nakshatra["strength"]),
        confidence=0.0,
        level=1,
        anchors=[f"Moon_{nakshatra['name']}"],
        time_horizon=TimeHorizon(decay="constant"),
        days_to_peak=0, peak_date=None,
        metadata={"nakshatra": nakshatra["name"], "pada": nakshatra["pada"]}
    )
    theses.append(thesis)
    
    dasha = calculate_dasha(sidereal_planets["Moon"], core["birth_data"])
    for period in dasha["periods"]:
        vector = get_dasha_vector(period["planet"])
        sign = get_dasha_direction(period)
