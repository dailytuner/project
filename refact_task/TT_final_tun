### 3.3. Validation Runner

```python
# src/core/validation_runner.py

from typing import Dict, List, Optional
from datetime import datetime, timedelta
import numpy as np
from sklearn.model_selection import KFold

class ValidationRunner:
    """
    Валидация изменений на исторических данных.
    """
    
    async def run_validation(
        self,
        data: List[Dict],
        config: Dict,
        n_folds: int = 5
    ) -> Dict:
        """
        Запускает кросс-валидацию.
        """
        # 1. Разбиваем на фолды
        kf = KFold(n_splits=n_folds, shuffle=True, random_state=42)
        
        # 2. Для каждого фолда
        scores = []
        predictions = []
        actuals = []
        
        for train_idx, test_idx in kf.split(data):
            train_data = [data[i] for i in train_idx]
            test_data = [data[i] for i in test_idx]
            
            # Обучаем на train, тестируем на test
            fold_score = self._evaluate_fold(train_data, test_data, config)
            scores.append(fold_score)
            
            # Сохраняем предсказания для ROC-анализа
            for item in test_data:
                pred = self._predict(item, config)
                predictions.append(pred)
                actuals.append(item['actual_outcome'])
        
        # 3. Итоговые метрики
        return {
            'mean_score': round(np.mean(scores), 3),
            'std_score': round(np.std(scores), 3),
            'min_score': round(min(scores), 3),
            'max_score': round(max(scores), 3),
            'n_folds': n_folds,
            'n_observations': len(data),
            'predictions': predictions,
            'actuals': actuals
        }
    
    def _evaluate_fold(
        self,
        train_data: List[Dict],
        test_data: List[Dict],
        config: Dict
    ) -> float:
        """
        Оценивает модель на одном фолде.
        """
        # 1. Обучаем на train_data
        weights = self._optimize_weights(train_data, config)
        
        # 2. Тестируем на test_data
        errors = []
        for item in test_data:
            predicted = (
                item['clarity'] * weights['clarity'] +
                item['synchronicity'] * weights['synchronicity'] +
                item['resource'] * weights['resource'] -
                item['inertia'] * weights['inertia']
            )
            predicted = max(0, min(1, predicted))
            errors.append((predicted - item['actual_outcome']) ** 2)
        
        return 1 - (sum(errors) / len(errors)) if errors else 0
    
    def _optimize_weights(self, data: List[Dict], config: Dict) -> Dict:
        """
        Оптимизирует веса для одного фолда.
        """
        # Упрощённая оптимизация для кросс-валидации
        return {
            'clarity': 0.3,
            'synchronicity': 0.3,
            'resource': 0.3,
            'inertia': 0.1
        }
    
    def _predict(self, item: Dict, config: Dict) -> float:
        """
        Делает предсказание по конфигурации.
        """
        weights = config.get('weights', {
            'clarity': 0.3,
            'synchronicity': 0.3,
            'resource': 0.3,
            'inertia': 0.1
        })
        
        predicted = (
            item['clarity'] * weights['clarity'] +
            item['synchronicity'] * weights['synchronicity'] +
            item['resource'] * weights['resource'] -
            item['inertia'] * weights['inertia']
        )
        return max(0, min(1, predicted))
