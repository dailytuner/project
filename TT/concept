### 7.5. Временная модуляция

```python
# confidence/temporal.py
import math

def calculate_temporal_modulation(thesis: Thesis, current_date: datetime) -> float:
    """
    Временная модуляция для динамических тезисов.
    Использует гауссово затухание с асимметрией.
    
    Args:
        thesis: Динамический тезис
        current_date: Текущая дата
    
    Returns:
        float: Коэффициент модуляции (0.0-1.0)
    
    Обоснование:
        - Гауссово затухание: естественное поведение сигнала
        - Асимметрия: до пика медленнее, после — быстрее
        - Отсечение по 2σ: далекие сигналы не учитываются
    """
    # Статические тезисы не модулируются
    if thesis.time_horizon.decay == "constant":
        return 1.0
    
    # Для динамических — проверяем наличие days_to_peak
    if thesis.days_to_peak is None:
        return 1.0
    
    days_to_peak = thesis.days_to_peak
    sigma = thesis.time_horizon.sigma_days or 30
    
    if sigma == 0:
        return 1.0
    
    # Строгое отсечение: >= 2σ
    if abs(days_to_peak) >= 2 * sigma:
        return 0.0
    
    # Базовая гауссиана для близких сигналов
    modulation = math.exp(-(days_to_peak ** 2) / (2 * sigma ** 2))
    
    # Асимметрия: до пика медленнее, после — быстрее
    asymmetry = get_asymmetry(thesis)
    if days_to_peak < 0:
        modulation = modulation ** asymmetry["pre"]
    else:
        modulation = modulation ** asymmetry["post"]
    
    return max(0.05, min(1.0, modulation))

def get_asymmetry(thesis: Thesis) -> Dict[str, float]:
    """
    Возвращает коэффициенты асимметрии для разных типов событий.
    
    Обоснование:
        - Быстрые планеты (Меркурий, Венера): быстрое нарастание и затухание
        - Медленные планеты (Сатурн, Юпитер): медленное нарастание
        - Внешние планеты (Уран, Нептун, Плутон): очень медленное нарастание
    """
    ASYMMETRY_TABLE = {
        "transit_fast": {"pre": 0.8, "post": 1.3},    # Меркурий, Венера, Марс
        "transit_slow": {"pre": 0.7, "post": 1.5},     # Сатурн, Юпитер
        "transit_outer": {"pre": 0.6, "post": 2.0},    # Уран, Нептун, Плутон
        "default": {"pre": 1.0, "post": 1.0}
    }
    
    if thesis.system == "transits":
        speed = thesis.metadata.get("speed", 1.0)
        if speed > 2:
            return ASYMMETRY_TABLE["transit_fast"]
        elif speed > 0.3:
            return ASYMMETRY_TABLE["transit_slow"]
        else:
            return ASYMMETRY_TABLE["transit_outer"]
    
    return ASYMMETRY_TABLE["default"]
