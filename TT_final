# confidence/k_factors.py
from core.models import Thesis


def calculate_k_retrograde(thesis: Thesis, core: dict) -> float:
    """Поправка на ретроградность."""
    if thesis.system in ["western", "arabic"]:
        planet_name = thesis.anchors[0].split("_")[0]
        if planet_name in core["planets"]:
            return 0.7 if core["planets"][planet_name]["retrograde"] else 1.0
    return 1.0


def calculate_k_dignity(thesis: Thesis, core: dict) -> float:
    """Поправка на эссенциальные достоинства."""
    if thesis.system == "western":
        planet_name = thesis.anchors[0].split("_")[0]
        if planet_name in core["planets"]:
            dignity = core["planets"][planet_name]["dignity"]
            if dignity.get("ruler") or dignity.get("exaltation"):
                return 1.2
            elif dignity.get("fall") or dignity.get("detriment"):
                return 0.8
    return 1.0


def calculate_k_speed(thesis: Thesis, core: dict) -> float:
    """Поправка на скорость планеты."""
    if thesis.system in ["western", "arabic"]:
        planet_name = thesis.anchors[0].split("_")[0]
        if planet_name in core["planets"]:
            speed_norm = core["planets"][planet_name]["speed_normalized"]
            return max(0.7, min(1.3, 1.0 + 0.2 * (speed_norm - 0.5)))
    return 1.0


def calculate_k_window(thesis: Thesis) -> float:
    """Поправка на точность временного окна."""
    window_type = thesis.metadata.get("window", {}).get("type", "medium")
    return {"high": 1.1, "medium": 1.0, "low": 0.9}.get(window_type, 1.0)


def calculate_k_level(thesis: Thesis) -> float:
    """Поправка на иерархический уровень."""
    return {1: 1.2, 2: 1.0, 3: 0.9, 4: 0.8}.get(thesis.level, 1.0)
