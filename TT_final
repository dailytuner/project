### 4.6. Solar Time (ИСПРАВЛЕНО)

```python
# core/solar_time.py
from datetime import datetime, timedelta
from typing import Dict, Any
from core.ephemeris_wrapper import ephemeris
from utils.time_module import TimeModule


def calculate_solar_time(jd: float, lng: float, lat: float, timezone: str) -> Dict[str, Any]:
    """
    Рассчитывает местное истинное солнечное время для всех систем.
    
    Args:
        jd: Юлианский день
        lng: Долгота
        lat: Широта
        timezone: IANA timezone
    """
    utc_dt = TimeModule.from_julian_day(jd)
    
    # LMT (Local Mean Time)
    lmt = utc_dt + timedelta(hours=lng / 15)
    
    # EOT (Equation of Time)
    eot = ephemeris.get_equation_of_time(jd)
    last = lmt + timedelta(minutes=eot)
    
    # Sunrise/Sunset для Vedic и Maya
    sunrise_hours = ephemeris.get_sunrise(jd, lat, lng)
    sunset_hours = ephemeris.get_sunset(jd, lat, lng)
    
    systems = {}
    
    # Western, Arabic, Mesopotamian, Transits — LAST
    for system in ["western", "arabic", "mesopotamian", "transits"]:
        systems[system] = _make_system_entry(last, offset_hours=0)
    
    # Vedic — восход как начало дня
    systems["vedic"] = _make_system_entry(last, offset_hours=-sunrise_hours)
    
    # Chinese — 子时 (23:00-01:00) как начало дня
    systems["chinese"] = _make_system_entry(last, offset_hours=-1)
    
    # Maya — закат предыдущего дня
    prev_sunset = ephemeris.get_sunset(jd - 1, lat, lng)
    systems["maya"] = _make_system_entry(last, offset_hours=-prev_sunset)
    
    return {
        "lmt": lmt.isoformat(),
        "eot": eot,
        "last": last.isoformat(),
        "sunrise_hours": sunrise_hours,
        "sunset_hours": sunset_hours,
        "systems": systems
    }


def _make_system_entry(base_dt: datetime, offset_hours: float) -> Dict[str, Any]:
    """Создаёт запись системы с учётом offset."""
    final_time = base_dt + timedelta(hours=offset_hours)
    
    if final_time.hour < 0:
        final_date = final_time - timedelta(days=1)
    elif final_time.hour >= 24:
        final_date = final_time + timedelta(days=1)
    else:
        final_date = final_time
    
    return {
        "datetime": final_date.isoformat(),
        "jd": TimeModule.to_julian_day(final_date),
        "offset_hours": offset_hours
    }
