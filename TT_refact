# src/core/window_calc.py

from typing import Dict

class WindowCalculator:
    """
    Расчёт окна возможностей.
    """
    
    def calculate(
        self,
        state: Dict,
        achievements: Dict[str, Dict],
        astro_context: Dict
    ) -> Dict:
        """
        Рассчитывает окно возможностей.
        """
        # 1. Фоновое сопротивление
        bg_resistance = self._calc_background_resistance(astro_context)
        
        # 2. Субъектный ресурс
        subject_resource = self._calc_subject_resource(state)
        
        # 3. Синергия
        synergy = self._calc_synergy(state, achievements, astro_context)
        
        # 4. Инерция
        inertia = state.get('anxiety_score', 0.5)
        
        # 5. Окно
        value = (1 - bg_resistance) * subject_resource * synergy * (1 - inertia)
        value = max(0, min(1, value))
        
        # 6. Уровень
        if value >= 0.7:
            level = 'OPEN'
            practice = 'Действуй! Сейчас хорошее время для новых начинаний'
            play = 'Отличное время для творчества и риска'
        elif value >= 0.4:
            level = 'PARTIAL'
            practice = 'Готовься, но не торопись'
            play = 'Попробуй что-то новое с осторожностью'
        else:
            level = 'CLOSED'
            practice = 'Наблюдай и восстанавливайся'
            play = 'Отдохни, не принимай важных решений'
        
        # 7. Отклонения по категориям
        deviations = {}
        for cat, idx in achievements.items():
            avg = sum([
                achievements.get('family', {}).get('value', 0.5),
                achievements.get('work', {}).get('value', 0.5),
                achievements.get('health', {}).get('value', 0.5),
                achievements.get('self', {}).get('value', 0.5)
            ]) / 4
            deviations[cat] = round(idx.get('value', 0.5) - avg, 3)
        
        return {
            'value': round(value, 3),
            'level': level,
            'deviations': deviations,
            'practice_recommendation': practice,
            'play_recommendation': play
        }
    
    def _calc_background_resistance(self, astro_context):
        """Фоновое сопротивление."""
        if not astro_context:
            return 0.3
        
        bio = astro_context.get('biorhythms', {})
        # Чем ниже биоритмы, тем выше сопротивление
        phys = (bio.get('physical', 0) + 1) / 2
        emot = (bio.get('emotional', 0) + 1) / 2
        intel = (bio.get('intellectual', 0) + 1) / 2
        
        return 1 - ((phys + emot + intel) / 3)
    
    def _calc_subject_resource(self, state):
        """Субъектный ресурс."""
        energy = state.get('energy_score', 0.5)
        anxiety = state.get('anxiety_score', 0.5)
        return (energy + (1 - anxiety)) / 2
    
    def _calc_synergy(self, state, achievements, astro_context):
        """Синергия."""
        # Упрощённо: средний индекс
        avg_achievement = sum([
            a.get('value', 0.5) for a in achievements.values()
        ]) / len(achievements) if achievements else 0.5
        
        return (state.get('emotional_score', 0.5) + avg_achievement) / 2
