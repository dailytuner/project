### 8.5. Девятивекторный сводный профиль

```python
# adjacent/nine_vector.py
from typing import Dict, Any, List
from adjacent.psychomatrix import PsychomatrixSystem
from adjacent.biorhythms import BiorhythmsSystem


class NineVectorProfile:
    """
    Девятивекторный сводный профиль.
    
    Сводит 3 системы в 9 осей:
    - 3 оси от психоматрицы (характер, энергия, познание)
    - 3 оси от биоритмов (физика, эмоции, интеллект)
    - 3 оси от астрологии (стабильность, динамика, активность)
    
    ВАЖНО: Это НЕ заменяет астрологический профиль.
    Это ДОПОЛНИТЕЛЬНАЯ визуализация для пользователя.
    """
    
    def __init__(self):
        self.psychomatrix = PsychomatrixSystem()
        self.biorhythms = BiorhythmsSystem()
    
    def calculate(
        self,
        birth_date,
        target_date,
        astro_profile: Dict[str, Any]
    ) -> Dict[str, Any]:
        """Сводит все системы в 9-мерный вектор."""
        
        pm_result = self.psychomatrix.calculate({"birth_date": birth_date})
        br_result = self.biorhythms.calculate({
            "birth_date": birth_date,
            "target_date": target_date,
        })
        
        pm_vector = self.psychomatrix.to_vector(pm_result)
        br_vector = self.biorhythms.to_vector(br_result)
        astro_vector = self._astro_to_vector(astro_profile)
        
        nine_vector = [
            pm_vector[0], pm_vector[1], pm_vector[2],
            br_vector[0], br_vector[1], br_vector[2],
            astro_vector[0], astro_vector[1], astro_vector[2],
        ]
        
        return {
            "nine_vector": nine_vector,
            "components": {
                "psychomatrix": pm_result,
                "biorhythms": br_result,
                "astrology": astro_profile,
            },
            "interpretation": self._interpret(nine_vector),
        }
    
    def _astro_to_vector(self, astro_profile: Dict[str, Any]) -> List[float]:
        """Извлекает 3 оси из астрологического профиля."""
        return [
            astro_profile.get("global_consistency", 0.5),
            astro_profile.get("primary_sphere_strength", 0.5),
            min(1.0, astro_profile.get("dynamic_signals_count", 0) / 5),
        ]
    
    def _interpret(self, vector: List[float]) -> Dict[str, str]:
        """Интерпретирует 9-мерный вектор."""
        axes = [
            "Характер", "Энергия", "Познание",
            "Физика", "Эмоции", "Интеллект",
            "Стабильность", "Динамика", "Активность",
        ]
        
        result = {}
        for axis, value in zip(axes, vector):
            if value < 0.3:
                level = "низкий"
            elif value < 0.6:
                level = "средний"
            else:
                level = "высокий"
            result[axis] = level
        
        return result
