### 6.1. PsychometryService

```python
class PsychometryService:
    """
    Оркестрация сохранения тестов.
    БЕЗ ALIGNMENT-ЛОГИКИ.
    """
    
    def __init__(
        self,
        mmpi_scorer: MMPIScorer,
        iat_scorer: IATScorer,
        astro_client: AstroContextClient,
        lake_client: LakeClient,
        scheduler: SchedulerService,
        outbox_publisher: OutboxPublisher
    ):
        self.mmpi_scorer = mmpi_scorer
        self.iat_scorer = iat_scorer
        self.astro_client = astro_client
        self.lake_client = lake_client
        self.scheduler = scheduler
        self.outbox_publisher = outbox_publisher
    
    async def save_mmpi(
        self, 
        user_id: int, 
        answers: Dict[int, bool],
        test_version: str = 'MMPI-2'
    ) -> MMPIResult:
        """
        Сохраняет результаты MMPI.
        
        Шаги:
        1. Валидация ответов (L/F/K)
        2. Расчет T-scores
        3. Получение астро-контекста (fallback)
        4. Сохранение в PostgreSQL
        5. Загрузка raw данных в Data Lake
        6. Обновление графика тестирования
        7. Запись в outbox
        """
        # 1. Расчет T-scores
        raw_scores = self.mmpi_scorer.calculate_raw_scores(answers)
        t_scores = self.mmpi_scorer.calculate_t_scores(raw_scores)
        validity = self.mmpi_scorer.validate_response(answers)
        
        # 2. Idempotency Key
        idempotency_key = self._generate_idempotency_key(user_id, answers)
        
        # 3. Астро-контекст (fallback при недоступности)
        astro_context = await self.astro_client.get_context(user_id, datetime.now())
        
        # 4. Сохранение в PostgreSQL
        result = await self._save_mmpi_to_db(
            user_id=user_id,
            t_scores=t_scores,
            validity=validity,
            astro_context=astro_context,
            idempotency_key=idempotency_key,
            test_version=test_version
        )
        
        # 5. Загрузка в Data Lake
        lake_uri = await self.lake_client.upload(
            key=f"psych/mmpi/year={datetime.now().year}/month={datetime.now().month:02d}/user_{user_id}_{datetime.now().strftime('%Y%m%d')}.parquet",
            data=self._serialize_mmpi_answers(answers, result.id)
        )
        await self._update_lake_uri(result.id, lake_uri)
        
        # 6. Обновление графика
        await self.scheduler.update_schedule(user_id, 'mmpi')
        
        # 7. Запись в outbox
        await self.outbox_publisher.publish(
            event_type='test.completed',
            payload={
                'user_id': user_id,
                'test_type': 'mmpi',
                'result_id': result.id,
                'taken_at': result.taken_at.isoformat(),
                't_scores': t_scores,
                'astro_context': astro_context
            },
            idempotency_key=idempotency_key
        )
        
        return result
    
    async def save_iat(
        self,
        user_id: int,
        blocks: List[BlockData],
        test_type: str
    ) -> IATResult:
        """
        Сохраняет результаты IAT.
        
        Шаги:
        1. Расчет D-score
        2. Расчет эффекта тренировки
        3. Получение астро-контекста (fallback)
        4. Сохранение в PostgreSQL
        5. Загрузка raw данных в Data Lake
        6. Обновление графика тестирования
        7. Запись в outbox
        """
        # 1. Расчет D-score
        d_score = self.iat_scorer.calculate_d_score(blocks)
        practice_effect = self.iat_scorer.calculate_practice_effect(blocks)
        
        # 2. Генерация session_seed
        generator = IATStimulusGenerator()
        session_seed = hash(f"{user_id}_{datetime.now().month}_{datetime.now().year}")
        
        # 3. Астро-контекст
        astro_context = await self.astro_client.get_context(user_id, datetime.now())
        
        # 4. Сохранение
        result = await self._save_iat_to_db(
            user_id=user_id,
            d_score=d_score,
            practice_effect=practice_effect,
            session_seed=session_seed,
            test_type=test_type,
            astro_context=astro_context
        )
        
        # 5. Загрузка в Data Lake
        lake_uri = await self.lake_client.upload(
            key=f"psych/iat/year={datetime.now().year}/month={datetime.now().month:02d}/user_{user_id}_{datetime.now().strftime('%Y%m%d')}.parquet",
            data=self._serialize_iat_data(blocks, result.id)
        )
        await self._update_iat_lake_uri(result.id, lake_uri)
        
        # 6. Обновление графика
        await self.scheduler.update_schedule(user_id, 'iat')
        
        # 7. Запись в outbox
        await self.outbox_publisher.publish(
            event_type='test.completed',
            payload={
                'user_id': user_id,
                'test_type': 'iat',
                'result_id': result.id,
                'taken_at': result.taken_at.isoformat(),
