## 2. Общая архитектура финальной системы

### 2.1. Контейнеризация (Docker Compose)

```yaml
# docker-compose.yml (финальный)

version: '3.8'

services:
  # ============================================================
  # INFRASTRUCTURE
  # ============================================================
  
  postgres:
    image: postgres:15
    container_name: postgres
    environment:
      POSTGRES_DB: personal_assistant
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./backups:/backups
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    networks:
      - app-network

  minio:
    image: minio/minio:latest
    container_name: minio
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    volumes:
      - minio_data:/data
    ports:
      - "9000:9000"
      - "9001:9001"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 20s
      retries: 3
    restart: unless-stopped
    networks:
      - app-network

  # ============================================================
  # SERVICES
  # ============================================================
  
  astro-service:
    build: ./astro-service
    container_name: astro-service
    environment:
      DATABASE_URL: postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/personal_assistant
      PSYCHOMETRY_URL: http://psychometry-service:8000
      INTERNAL_API_KEY: ${INTERNAL_API_KEY}
      USE_V2_FORECASTS: ${USE_V2_FORECASTS:-true}
      ALIGNMENT_CACHE_TTL: 604800
      HOUSE_SYSTEM: W
    ports:
      - "8001:8000"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped
    networks:
      - app-network

  psychometry-service:
    build: ./psychometry-service
    container_name: psychometry-service
    environment:
      DATABASE_URL: postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/personal_assistant
      ASTRO_SERVICE_URL: http://astro-service:8000
      INTERNAL_API_KEY: ${INTERNAL_API_KEY}
      ASTRO_FALLBACK_MODE: ${ASTRO_FALLBACK_MODE:-false}
      LAKE_ENDPOINT: minio:9000
      LAKE_ACCESS_KEY: ${MINIO_ROOT_USER}
      LAKE_SECRET_KEY: ${MINIO_ROOT_PASSWORD}
      MMPI_INTERVAL_DAYS: 90
      IAT_INTERVAL_DAYS: 30
      ALIGNMENT_BATCH_SIZE: 50
      ALIGNMENT_SLEEP_SECONDS: 5
    ports:
      - "8002:8000"
    depends_on:
      postgres:
        condition: service_healthy
      minio:
        condition: service_healthy
      astro-service:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped
    networks:
      - app-network

  alignment-engine:  # НОВЫЙ СЕРВИС!
    build: ./alignment-engine
    container_name: alignment-engine
    environment:
      DATABASE_URL: postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/personal_assistant
      ASTRO_SERVICE_URL: http://astro-service:8000
      ASTRO_API_KEY: ${INTERNAL_API_KEY}
      PSYCHOMETRY_SERVICE_URL: http://psychometry-service:8000
      TEMPLATES_PATH: ./interpretations/alignments/
      DISSONANCE_THRESHOLD: 0.4
    ports:
      - "8003:8000"
    depends_on:
      postgres:
        condition: service_healthy
      astro-service:
        condition: service_healthy
      psychometry-service:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped
    networks:
      - app-network

  psychometry-outbox-worker:
    build: ./psychometry-service
    container_name: psychometry-outbox-worker
    command: python -m src.workers.outbox_worker
    environment:
      DATABASE_URL: postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/personal_assistant
      ASTRO_SERVICE_URL: http://astro-service:8000
      INTERNAL_API_KEY: ${INTERNAL_API_KEY}
    depends_on:
      postgres:
        condition: service_healthy
      astro-service:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - app-network

  psychometry-alignment-job:  # Cron для Alignment
    build: ./psychometry-service
    container_name: psychometry-alignment-job
    command: python -m src.jobs.daily_alignment
    environment:
      DATABASE_URL: postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/personal_assistant
      ASTRO_SERVICE_URL: http://astro-service:8000
      INTERNAL_API_KEY: ${INTERNAL_API_KEY}
      ALIGNMENT_BATCH_SIZE: 50
      ALIGNMENT_SLEEP_SECONDS: 5
    depends_on:
      postgres:
        condition: service_healthy
      astro-service:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - app-network

  analytics-worker:
    build: ./analytics-worker
    container_name: analytics-worker
    environment:
      DATABASE_URL: postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/personal_assistant
      LAKE_ENDPOINT: minio:9000
      LAKE_ACCESS_KEY: ${MINIO_ROOT_USER}
      LAKE_SECRET_KEY: ${MINIO_ROOT_PASSWORD}
      MIN_OBSERVATIONS: 10
      MIN_UNIQUE_USERS: 3
      SIGNIFICANCE_THRESHOLD: 0.5
    depends_on:
      postgres:
        condition: service_healthy
      minio:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - app-network

  # ============================================================
  # API GATEWAY
  # ============================================================
  
  api-gateway:
    build: ./api-gateway
    container_name: api-gateway
    environment:
      ASTRO_SERVICE_URL: http://astro-service:8000
      PSYCHOMETRY_SERVICE_URL: http://psychometry-service:8000
      ALIGNMENT_ENGINE_URL: http://alignment-engine:8000  # НОВЫЙ!
    ports:
      - "8000:8000"
    depends_on:
      astro-service:
        condition: service_healthy
      psychometry-service:
        condition: service_healthy
      alignment-engine:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - app-network

  # ============================================================
  # MONITORING
  # ============================================================
  
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
      - prometheus_data:/prometheus
    ports:
      - "9090:9090"
    restart: unless-stopped
    networks:
      - app-network

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_PASSWORD}
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/dashboards:/etc/grafana/provisioning/dashboards
      - ./grafana/datasources:/etc/grafana/provisioning/datasources
    ports:
      - "3000:3000"
    depends_on:
      - prometheus
    restart: unless-stopped
    networks:
      - app-network

  loki:
    image: grafana/loki:latest
    container_name: loki
    ports:
      - "3100:3100"
    command: -config.file=/etc/loki/local-config.yaml
    restart: unless-stopped
    networks:
      - app-network

  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    volumes:
      - /var/log/containers:/var/log/containers
      - ./promtail.yml:/etc/promtail/promtail.yml
    command: -config.file=/etc/promtail/promtail.yml
    depends_on:
      - loki
    restart: unless-stopped
    networks:
      - app-network

networks:
  app-network:
    driver: bridge

volumes:
  postgres_data:
  minio_data:
  prometheus_data:
  grafana_data:
```

