            "speed": pos.speed_long,
            "retrograde": pos.retrograde
        }
        for name, pos in all_coords.items()
    }
    
    transit_aspects = []
    for tp_name, tp_data in transit_planets.items():
        for np_name, np_data in static_core["planets"].items():
            angle = (tp_data["longitude"] - np_data["longitude"]) % 360
            
            for aspect_name, aspect_angle in ASPECT_ANGLES.items():
                orb = get_orb(np_name, aspect_name)
                diff = abs(angle - aspect_angle)
                if diff > 180:
                    diff = 360 - diff
                
                if diff <= orb:
                    peak_date = calculate_peak_date(
                        transit_longitude=tp_data["longitude"],
                        natal_longitude=np_data["longitude"],
                        aspect_angle=aspect_angle,
                        current_date=current_date,
                        speed=tp_data["speed"],
                        horizon_days=horizon_days
                    )
                    
                    if peak_date is None:
                        continue
                    
                    transit_aspects.append({
                        "transit_planet": tp_name,
                        "natal_planet": np_name,
                        "aspect_type": aspect_name,
                        "aspect_angle": aspect_angle,
                        "angle": angle,
                        "orb": diff,
                        "strength": 1 - (diff / orb),
                        "peak_date": peak_date.isoformat(),
                        "days_to_peak": (peak_date - current_date).days,
                        "speed": abs(tp_data["speed"])
                    })
    
    return {
        "date": current_date.isoformat(),
        "jd": transit_jd,
        "planets": transit_planets,
        "aspects": transit_aspects,
        "horizon_days": horizon_days,
        "metadata": {"calculated_at": TimeModule.utc_now().isoformat()}
    }
