    event_type VARCHAR(50) NOT NULL,
    payload JSONB NOT NULL,
    idempotency_key VARCHAR(64) UNIQUE,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    processed_at TIMESTAMPTZ,
    retry_count INTEGER DEFAULT 0,
    last_error TEXT,
    UNIQUE(event_type, payload)
);

-- ============================================================
-- 5. ИНДЕКСЫ (ВЫНЕСЕНЫ ОТДЕЛЬНО ОТ CREATE TABLE)
-- ============================================================

CREATE INDEX idx_mmpi_user_date ON psych.mmpi_results(user_id, taken_at);
CREATE INDEX idx_mmpi_idempotency ON psych.mmpi_results(idempotency_key);
CREATE INDEX idx_iat_user_date ON psych.iat_results(user_id, taken_at);
CREATE INDEX idx_iat_idempotency ON psych.iat_results(idempotency_key);
CREATE INDEX idx_outbox_pending ON psych.outbox(processed_at) WHERE processed_at IS NULL;

-- ============================================================
-- 6. ФУНКЦИЯ И ТРИГГЕРЫ ДЛЯ AUTOMATIC UPDATED_AT
-- ============================================================

CREATE OR REPLACE FUNCTION psych.update_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER update_mmpi_updated_at
    BEFORE UPDATE ON psych.mmpi_results
    FOR EACH ROW EXECUTE FUNCTION psych.update_updated_at();

CREATE TRIGGER update_iat_updated_at
    BEFORE UPDATE ON psych.iat_results
    FOR EACH ROW EXECUTE FUNCTION psych.update_updated_at();

CREATE TRIGGER update_schedule_updated_at
    BEFORE UPDATE ON psych.test_schedule
    FOR EACH ROW EXECUTE FUNCTION psych.update_updated_at();
