## 5. Математическое ядро

### 5.1. DissonanceMiner

```python
# core/dissonance_miner.py

class DissonanceMiner:
    """
    Сбор и группировка диссонансов из Psychometry Service.
    """
    
    async def mine_dissonances(
        self,
        session: AsyncSession,
        since: Optional[datetime] = None
    ) -> List[DissonanceGroup]:
        """
        Собирает диссонансы и группирует их по факторам.
        """
        # 1. Загружаем диссонансы
        dissonances = await self._load_dissonances(session, since)
        
        if not dissonances:
            return []
        
        # 2. Группируем по factor_name + expected_effect
        groups = {}
        for d in dissonances:
            key = (d.source, d.dissonance_type, d.expected_state)
            if key not in groups:
                groups[key] = {
                    'factor_name': d.source,
                    'knowledge_type': d.dissonance_type,
                    'expected_effect': d.expected_state,
                    'dissonances': [],
                    'count': 0,
                    'severity_sum': 0.0,
                    'users': set()
                }
            
            groups[key]['dissonances'].append(d)
            groups[key]['count'] += 1
            groups[key]['severity_sum'] += d.severity
            groups[key]['users'].add(d.user_id)
        
        # 3. Формируем DissonanceGroup
        result = []
        for key, data in groups.items():
            result.append(DissonanceGroup(
                factor_name=data['factor_name'],
                knowledge_type=data['knowledge_type'],
                expected_effect=data['expected_effect'],
                dissonance_count=data['count'],
                unique_users=len(data['users']),
                avg_severity=data['severity_sum'] / data['count'] if data['count'] > 0 else 0,
                sample=dissonances[:10]  # Для анализа
            ))
        
        return result
    
    async def _load_dissonances(
        self,
        session: AsyncSession,
        since: Optional[datetime]
    ) -> List[Dissonance]:
        """
        Загружает диссонансы из БД.
        """
        stmt = select(Dissonance)
        if since:
            stmt = stmt.where(Dissonance.created_at > since)
        stmt = stmt.where(Dissonance.resolved.is_(False))
        stmt = stmt.order_by(Dissonance.created_at.desc())
        
        result = await session.execute(stmt)
        return result.scalars().all()
```

### 5.2. PatternAnalyzer

```python
# core/pattern_analyzer.py

class PatternAnalyzer:
    """
    Анализирует паттерны диссонансов и формирует гипотезы.
    """
    
    # Пороги для определения значимости
    MIN_OBSERVATIONS = 10
    MIN_UNIQUE_USERS = 3
    SEVERITY_THRESHOLD = 0.6
    
    async def analyze(
        self,
        dissonance_groups: List[DissonanceGroup]
    ) -> List[Pattern]:
        """
        Анализирует группы диссонансов и находит паттерны.
        """
        patterns = []
        
        for group in dissonance_groups:
            # 1. Проверяем, достаточно ли данных
            if group.dissonance_count < self.MIN_OBSERVATIONS:
                continue
            
            if group.unique_users < self.MIN_UNIQUE_USERS:
                continue
            
            # 2. Вычисляем показатели
            pattern = await self._extract_pattern(group)
            
            # 3. Определяем значимость
            pattern.significance = self._calculate_significance(pattern)
            
            # 4. Формируем гипотезу
            pattern.hypothesis = self._generate_hypothesis(pattern)
            
            patterns.append(pattern)
        
        return patterns
    
    def _extract_pattern(self, group: DissonanceGroup) -> Pattern:
        """
        Извлекает паттерн из группы диссонансов.
        """
        # Определяем, какой паттерн наблюдается
        # Пример: "factor_name: saturn_house_1, expected: high, actual: low"
        
        # Собираем все actual_state из диссонансов
        actual_states = [d.actual_state for d in group.sample]
        most_common_actual = max(set(actual_states), key=actual_states.count)
        
        # Определяем консистентность паттерна
        consistency = actual_states.count(most_common_actual) / len(actual_states) if actual_states else 0
        
        return Pattern(
            factor_name=group.factor_name,
            knowledge_type=group.knowledge_type,
            expected_effect=group.expected_effect,
            actual_pattern=most_common_actual,
            observation_count=group.dissonance_count,
            unique_users=group.unique_users,
            avg_severity=group.avg_severity,
            consistency=consistency,
            significance=0.0,  # будет рассчитано позже
            hypothesis="",     # будет сгенерировано позже
            status='pending_review'
        )
    
    def _calculate_significance(self, pattern: Pattern) -> float:
        """
        Рассчитывает значимость паттерна.
        """
        # Комбинированный score на основе:
        # 1. Количество наблюдений (чем больше, тем значимее)
        # 2. Консистентность (чем выше, тем значимее)
        # 3. Уникальные пользователи (чем больше, тем значимее)
        
        observation_score = min(1.0, pattern.observation_count / 100)
        consistency_score = pattern.consistency
        user_score = min(1.0, pattern.unique_users / 20)
        
        return (observation_score * 0.4 + consistency_score * 0.4 + user_score * 0.2)
    
    def _generate_hypothesis(self, pattern: Pattern) -> str:
        """
        Генерирует гипотезу на основе паттерна.
        """
        if pattern.knowledge_type == 'house':
            return (
                f"Фактор {pattern.factor_name} ожидался как {pattern.expected_effect}, "
                f"но в {int(pattern.consistency * 100)}% случаев показывает {pattern.actual_pattern}. "
                f"Возможно, правило требует корректировки."
            )
        elif pattern.knowledge_type == 'dasha':
            return (
                f"Даша {pattern.factor_name.replace('dasha_', '')} не даёт ожидаемого "
                f"{pattern.expected_effect} эффекта. Вместо этого наблюдается {pattern.actual_pattern}."
            )
        else:
            return f"Обнаружен паттерн для {pattern.factor_name}: {pattern.actual_pattern} вместо {pattern.expected_effect}"
