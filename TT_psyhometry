## 5. Математическое ядро

### 5.1. MMPI Scorer (с K-коррекцией)

```python
import json
import hashlib

class MMPIScorer:
    """
    Расчет T-scores для MMPI-2 с K-коррекцией.
    """

    SCALE_KEYS = {
        'Hs': {'questions': [1, 2, 3, ...], 'k_correction': 0.5},
        'D':  {'questions': [5, 6, 7, ...], 'k_correction': 0.0},
        'Hy': {'questions': [8, 9, 10, ...], 'k_correction': 0.0},
        'Pd': {'questions': [11, 12, 13, ...], 'k_correction': 0.4},
        'Mf': {'questions': [14, 15, 16, ...], 'k_correction': 0.0},
        'Pa': {'questions': [17, 18, 19, ...], 'k_correction': 0.0},
        'Pt': {'questions': [20, 21, 22, ...], 'k_correction': 1.0},
        'Sc': {'questions': [23, 24, 25, ...], 'k_correction': 1.0},
        'Ma': {'questions': [26, 27, 28, ...], 'k_correction': 0.2},
        'Si': {'questions': [29, 30, 31, ...], 'k_correction': 0.0},
    }

    # K-шкала: номера вопросов (заполнить реальными из MMPI-2)
    K_QUESTIONS = [30, 45, 60, 75, 90, 105, 120, 135, 150,
                   165, 180, 195, 210, 225, 240, 255, 270, 285, 300]

    def calculate_raw_scores(self, answers: dict[int, bool]) -> dict[str, float]:
        raw = {}
        for name, data in self.SCALE_KEYS.items():
            raw[name] = sum(1 for q in data['questions'] if answers.get(q, False))

        k_raw = sum(1 for q in self.K_QUESTIONS if answers.get(q, False))

        for name, data in self.SCALE_KEYS.items():
            k_corr = data.get('k_correction', 0.0)
            if k_corr > 0:
                raw[name] += k_raw * k_corr

        return raw

    def calculate_t_scores(self, raw_scores: dict[str, float], gender: str = 'female') -> dict[str, float]:
        norms = self._load_norms(gender)
        return {
            scale: 50 + 10 * (raw - norms[scale]['mean']) / norms[scale]['std']
            for scale, raw in raw_scores.items()
        }

    def validate_response(self, answers: dict[int, bool]) -> dict:
        l_raw = self._calculate_l_scale(answers)
        f_raw = self._calculate_f_scale(answers)
        k_raw = sum(1 for q in self.K_QUESTIONS if answers.get(q, False))

        return {
            'l_score': l_raw,
            'f_score': f_raw,
            'k_score': k_raw,
            'is_valid': (l_raw <= 8 and f_raw <= 16 and k_raw <= 20)
        }
```

