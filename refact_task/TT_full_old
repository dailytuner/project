## 9. Data Lake интеграция

### 9.1. LakeClient

```python
class LakeClient:
    """
    Клиент для работы с Data Lake (S3/MinIO).
    """
    
    def __init__(
        self,
        bucket: str,
        endpoint: str,
        access_key: str,
        secret_key: str,
        region: str = 'eu-central-1'
    ):
        self.bucket = bucket
        self.client = self._init_client(endpoint, access_key, secret_key, region)
    
    async def upload(self, key: str, data: bytes) -> str:
        """
        Загружает данные в озеро.
        Возвращает URI: s3://bucket/key
        """
        await self.client.put_object(
            Bucket=self.bucket,
            Key=key,
            Body=data,
            ContentType='application/octet-stream'
        )
        return f"s3://{self.bucket}/{key}"
    
    async def download(self, uri: str) -> bytes:
        """
        Скачивает данные из озера.
        """
        key = uri.replace(f"s3://{self.bucket}/", "")
        response = await self.client.get_object(
            Bucket=self.bucket,
            Key=key
        )
        return await response['Body'].read()
```

