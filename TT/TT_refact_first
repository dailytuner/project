### 3.2. Схема `psych` (новая)

```sql
-- ============================================================
-- 1. ПОЛНЫЙ ПРОФИЛЬ (раз в месяц)
-- ============================================================

CREATE TABLE psych.full_profiles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id INTEGER NOT NULL,
    taken_at TIMESTAMP NOT NULL DEFAULT NOW(),
    
    -- T-scores (на основе 50-100 вопросов)
    t_scores JSONB NOT NULL,
    -- { "d": 65.2, "pt": 55.0, "pa": 48.5, "ma": 43.0, "si": 52.0 }
    
    -- Baseline для калибровки
    baseline JSONB,
    
    -- Осознанность
    awareness_level VARCHAR(10) CHECK (awareness_level IN ('HIGH', 'MEDIUM', 'LOW')),
    awareness_tip TEXT,
    awareness_practice TEXT,
    
    -- Валидность
    is_valid BOOLEAN DEFAULT true,
    validity_details JSONB,
    
    -- Астро-контекст
    astro_context JSONB,
    
    -- Idempotency Key
    idempotency_key VARCHAR(64) UNIQUE,
    
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    INDEX idx_full_user (user_id, taken_at DESC)
);

-- ============================================================
-- 2. СОСТОЯНИЯ (ежедневно)
-- ============================================================

CREATE TABLE psych.states (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id INTEGER NOT NULL,
    state_date DATE NOT NULL,
    calculated_at TIMESTAMP NOT NULL DEFAULT NOW(),
    
    -- 3 метрики (0-1)
    energy_score FLOAT CHECK (energy_score BETWEEN 0 AND 1),
    anxiety_score FLOAT CHECK (anxiety_score BETWEEN 0 AND 1),
    emotional_score FLOAT CHECK (emotional_score BETWEEN 0 AND 1),
    
    -- Уровень
    state_level VARCHAR(10) CHECK (state_level IN ('HIGH', 'MEDIUM', 'LOW')),
    state_summary TEXT,
    
    -- Осознанность (из полного профиля или расчётная)
    awareness_level VARCHAR(10),
    awareness_tip TEXT,
    awareness_practice TEXT,
    
    -- Быстрый опросник
    quick_check JSONB,
    -- { "energy": 4, "anxiety": 2, "emotional": 3, "comment": "..." }
    
    -- Источники
    full_profile_id UUID REFERENCES psych.full_profiles(id),
    
    -- Астро-контекст (из Redis)
    astro_context JSONB,
    
    -- Idempotency Key
    idempotency_key VARCHAR(64) UNIQUE,
    
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMP NOT NULL DEFAULT NOW(),
    INDEX idx_states_user (user_id, state_date DESC)
);

-- ============================================================
-- 3. РЕКОМЕНДАЦИИ (наборы)
-- ============================================================

CREATE TABLE psych.recommendations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id INTEGER NOT NULL,
    state_id UUID REFERENCES psych.states(id),
    generated_at TIMESTAMP NOT NULL DEFAULT NOW(),
    
    -- Рекомендации с числовыми индексами
    recommendations JSONB NOT NULL,
    -- [{"id": 0, "action": "...", "reason": "...", "priority": 1, "duration": "15 мин"}]
    
    applied BOOLEAN DEFAULT false,
    applied_at TIMESTAMP,
    
    INDEX idx_recommendations_user (user_id)
);

-- ============================================================
-- 4. ОБРАТНАЯ СВЯЗЬ
-- ============================================================

CREATE TABLE psych.feedback (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id INTEGER NOT NULL,
    recommendation_set_id UUID REFERENCES psych.recommendations(id),
    recommendation_index INTEGER,  -- индекс в массиве (0..N)
    category VARCHAR(20),
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    
    rating INTEGER CHECK (rating BETWEEN 1 AND 5),
    outcome FLOAT CHECK (outcome BETWEEN 0 AND 1),
    comment TEXT,
    
    INDEX idx_feedback_user (user_id, created_at DESC),
    INDEX idx_feedback_recommendation (recommendation_set_id)
);

-- ============================================================
-- 5. ПРАКТИКИ (интерактивная пауза)
-- ============================================================

CREATE TABLE psych.practices (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id INTEGER NOT NULL,
    state_id UUID REFERENCES psych.states(id),
    thought TEXT,
    target_duration INTEGER DEFAULT 15,
    actual_duration INTEGER,
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    INDEX idx_practices_user (user_id, created_at DESC)
);

-- ============================================================
-- 6. КОНФИГУРАЦИЯ — ШАБЛОНЫ РЕКОМЕНДАЦИЙ
-- ============================================================

CREATE TABLE psych.recommendation_templates (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    category VARCHAR(20) NOT NULL,
    level VARCHAR(10) NOT NULL,
    template TEXT NOT NULL,
    priority INTEGER DEFAULT 3,
    duration VARCHAR(20),
    is_active BOOLEAN DEFAULT true,
    created_at TIMESTAMP NOT NULL DEFAULT NOW(),
    INDEX idx_templates (category, level, is_active)
);

