# Проверка подключения к БД из контейнера
docker exec pa-psychometry python -c "
import os
import asyncpg
import asyncio

async def test():
    try:
        conn = await asyncpg.connect(
            host='postgres',
            database='personalassistant',
            user='postgres',
            password=os.getenv('POSTGRES_PASSWORD', 'postgres')
        )
        result = await conn.fetch('SELECT 1 as test')
        print('✅ Database connection OK')
        await conn.close()
        return True
    except Exception as e:
        print(f'❌ Database connection failed: {e}')
        return False

asyncio.run(test())
"

# Проверка подключения к MinIO из контейнера
docker exec pa-psychometry python -c "
import os
from aioboto3 import Session
import asyncio

async def test():
    try:
        session = Session()
        async with session.client(
            's3',
            endpoint_url='http://minio:9000',
            aws_access_key_id=os.getenv('LAKE_ACCESS_KEY', 'minioadmin'),
            aws_secret_access_key=os.getenv('LAKE_SECRET_KEY', 'minioadmin'),
            use_ssl=False
        ) as s3:
            await s3.head_bucket(Bucket='personal-assistant-lake')
            print('✅ MinIO connection OK')
    except Exception as e:
        print(f'❌ MinIO connection failed: {e}')

asyncio.run(test())
"



