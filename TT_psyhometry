### 5.3. IAT Stimulus Generator (hashlib)

```python
import hashlib
import random

class IATStimulusGenerator:
    def generate(self, test_type: str, user_id: int, month: int, year: int):
        seed_str = f"{user_id}_{month}_{year}"
        session_seed = int(hashlib.md5(seed_str.encode()).hexdigest()[:8], 16)

        rng = random.Random(session_seed)
        pool = self._load_stimuli_pool(test_type)
        selected = rng.sample(pool, k=min(20, len(pool)))

        return selected, session_seed
