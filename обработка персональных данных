## 3️⃣ Изменения в `web/static/js/app.js`

**В самом конце файла**, перед строкой `window.showToast = showToast;` (или перед экспортами), добавьте:

```javascript
// ========== СОГЛАСИЕ НА ПЕРСОНАЛЬНЫЕ ДАННЫЕ ==========

/**
 * Инициализация чекбокса согласия
 */
function initConsentCheckbox() {
    const checkbox = document.getElementById('consent-checkbox');
    const loginBtn = document.getElementById('yandex-login-btn');

    // Если элементов нет — выходим
    if (!checkbox || !loginBtn) {
        console.warn('Consent checkbox or login button not found');
        return;
    }

    // Восстанавливаем состояние из localStorage (на время сессии)
    const consentGiven = localStorage.getItem('consent_given') === 'true';
    if (consentGiven) {
        checkbox.checked = true;
        loginBtn.disabled = false;
    }

    // Обработчик изменения чекбокса
    checkbox.addEventListener('change', function() {
        const isChecked = this.checked;
        loginBtn.disabled = !isChecked;

        if (isChecked) {
            localStorage.setItem('consent_given', 'true');
            showToast('Согласие на обработку данных принято', 'success');
        } else {
            localStorage.removeItem('consent_given');
            showToast('Согласие отозвано', 'warning');
        }
    });

    // Блокируем клик по кнопке, если согласие не дано
    loginBtn.addEventListener('click', function(e) {
        if (this.disabled) {
            e.preventDefault();
            e.stopPropagation();
            showToast('Пожалуйста, дайте согласие на обработку персональных данных', 'warning');
            checkbox.focus();
            // Визуально подсвечиваем блок
            const block = document.querySelector('.consent-block');
            if (block) {
                block.style.borderLeftColor = '#ff6b6b';
                setTimeout(() => {
                    block.style.borderLeftColor = '#667eea';
                }, 1500);
            }
            return false;
        }
        return true;
    }, true); // Используем capture фазу для перехвата

    console.log('Consent checkbox initialized');
}

// Добавляем инициализацию в DOMContentLoaded
document.addEventListener('DOMContentLoaded', function() {
    // Даем небольшой таймаут, чтобы все элементы точно загрузились
    setTimeout(initConsentCheckbox, 100);
});
```

**И добавьте в экспорты** (в конце файла):
```javascript
window.initConsentCheckbox = initConsentCheckbox;
```

