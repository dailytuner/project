## 12. АЛГОРИТМЫ И ПСЕВДОКОД

### 12.1. Полный конвейер (С НОВЫМ АЛГОРИТМОМ)

```python
def calculate_magic_profile(birth_data, current_date=None, horizon_days=90):
    """
    Главный метод с новым алгоритмом: кластеризация → нормализация
    """
    if current_date is None:
        current_date = datetime.now()
    
    # 1. Проверка кеша
    cache_key = f"{birth_data['user_id']}_{current_date.strftime('%Y-%m-%d')}"
    cached = get_cached_profile(cache_key)
    if cached:
        return cached
    
    # 2. Расчет Core (натальный)
    natal_core = calculate_core(birth_data)
    
    # 3. Расчет Core (транзитный)
    transit_core = calculate_transit_core(current_date)
    
    # 4. Генерация тезисов от всех систем (БЕЗ нормализации)
    all_theses = []
    all_theses.extend(generate_western_theses(natal_core))
    all_theses.extend(generate_vedic_theses(natal_core, birth_data))
    all_theses.extend(generate_arabic_theses(natal_core))
    all_theses.extend(generate_chinese_theses(natal_core))
    all_theses.extend(generate_maya_theses(natal_core))
    all_theses.extend(generate_mesopotamian_theses(natal_core))
    all_theses.extend(calculate_transits(natal_core, current_date))
    
    # 5. Расчет Confidence_final (детерминированный)
    for thesis in all_theses:
        thesis["confidence_final"] = calculate_confidence_final(thesis, natal_core)
    
    # 6. Фильтрация (порог 0.4)
    filtered = filter_theses(all_theses, natal_core)
    
    # 7. НОВЫЙ АЛГОРИТМ: кластеризация → нормализация
    # ШАГ 1: Кластеризация ВСЕХ тезисов (без нормализации)
    raw_clusters = cluster_theses(filtered["main"])
    
    # ШАГ 2: Нормализация внутри каждого кластера
    balanced_clusters = []
    for cluster in raw_clusters:
        normalized_cluster = normalize_cluster(cluster, N_max=5)
        balanced_clusters.append(normalized_cluster)
    
    # ШАГ 3: Расчет пересечений внутри кластеров
    intersections = []
    for cluster in balanced_clusters:
        intersection = classify_intersection(cluster)
        intersections.append(intersection)
    
    # 8. Проверка на пустой профиль
    if not intersections:
        empty_profile = generate_empty_profile(filtered["main"])
        return empty_profile
    
    # 9. Приоритизация по горизонту
    priority = prioritize_by_horizon(intersections, horizon_days)
    
    # 10. Формирование профиля
    profile = {
        "user_id": birth_data.get("user_id"),
        "calculation_date": datetime.now(),
        "intersections": intersections,
        "empty_profile": False,
        "global_consistency": calculate_consistency(intersections),
        "priority": priority,
        "metadata": {
            "rules_version": RULES_VERSION,
            "horizon_days": horizon_days,
            "raw_theses_count": len(all_theses),
            "filtered_theses_count": len(filtered["main"]),
            "clusters_count": len(raw_clusters),
            "balanced_clusters_count": len(balanced_clusters),
            "weak_opponents": filtered["weak_opponents"],
            "transits_included": True,
            "algorithm_version": "v4.0_cluster_then_normalize"
        },
        "validation": validate_profile(intersections)
    }
    
    # 11. Кеширование (24 часа)
    cache_profile(cache_key, profile)
    
    return profile
```

### 12.2. Косинусное расстояние

```python
def cosine_similarity(v1, v2):
    dot_product = sum(a * b for a, b in zip(v1, v2))
    norm1 = math.sqrt(sum(a * a for a in v1))
    norm2 = math.sqrt(sum(b * b for b in v2))
    
    if norm1 == 0 or norm2 == 0:
        return 0
    
    return dot_product / (norm1 * norm2)
```

### 12.3. Уравнение времени (EoT)

```python
def calculate_equation_of_time(jd):
    n = 360 / 365.2422
    M = (n * (jd - 2451545.0)) % 360
    
    C = 1.9148 * math.sin(math.radians(M)) + \
        0.02 * math.sin(math.radians(2 * M)) + \
        0.0003 * math.sin(math.radians(3 * M))
    
    lambda_sun = M + C + 180 + 102.9372
    epsilon = 23.4393 - 0.0000004 * (jd - 2451545.0)
    
    y = math.tan(math.radians(epsilon / 2))**2
    eot = -math.degrees(
        y * math.sin(2 * math.radians(lambda_sun)) -
        2 * 0.01671 * math.sin(math.radians(M)) +
        4 * 0.01671 * y * math.sin(math.radians(M)) * math.cos(2 * math.radians(lambda_sun)) -
        0.5 * y**2 * math.sin(4 * math.radians(lambda_sun)) -
        1.25 * 0.01671**2 * math.sin(2 * math.radians(M))
    )
    
    return eot  # в минутах
```

