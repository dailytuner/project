async def create_and_save_natal_chart(
    user_id: int,
    birth_datetime: datetime,
    timezone: Optional[str] = None,
    house_system: str = 'P'
) -> NatalChart:
    """Создание натальной карты из данных профиля"""
    
    async with async_session() as session:
        # 1. Получаем профиль
        profile = await session.get(UserProfile, user_id)
        if not profile:
            raise ValueError(f"Profile not found for user {user_id}")
        
        # 2. Проверяем наличие геоданных
        if not profile.birth_lat or not profile.birth_lng:
            raise ValueError(f"No geodata for user {user_id}. Run geocoding first.")
        
        # 3. Используем координаты из профиля
        calculator = await get_natal_calculator()
        natal_data = await calculator.calculate_natal_chart(
            lat=float(profile.birth_lat),
