class ActivityScoreCalculator:
    """
    Калькулятор баллов для активностей.
    НЕ ML — просто взвешенная сумма признаков.
    """
    
    def __init__(self):
        # Веса вынесены в конфиг с комментариями
        self.config = self._load_config()
    
    def calculate_activity_scores(
        self,
        axes: Dict[str, AxisScore]
    ) -> Dict[str, ActivityScore]:
        """Расчет баллов для 7 типов активностей"""
        
        scores = {}
        for activity_type in ActivityType:
            score = self._calculate_single_activity(activity_type, axes)
            scores[activity_type.value] = score
        
        return scores
    
    def _calculate_single_activity(
        self,
        activity_type: ActivityType,
        axes: Dict[str, AxisScore]
    ) -> float:
        """Прозрачная формула для одной активности"""
        
        config = self.config[activity_type.value]
        
        total = 0.0
        for axis_name, weight in config.weights.items():
            total += axes[axis_name].value * weight
        
        return self._sigmoid(total)
