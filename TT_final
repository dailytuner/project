# interpretation/generator.py
import structlog
from typing import List, Dict, Any
from core.models import Thesis, TimeHorizon
from config.settings_manager import get_settings

logger = structlog.get_logger()


def generate_static_theses(static_core: Dict[str, Any]) -> List[Thesis]:
    """
    Генерирует все статические тезисы с graceful degradation.
    
    Если одна система падает — логируем ошибку и продолжаем.
    Если все системы падают — выбрасываем исключение.
    
    Учитывает флаги enable_* из SettingsManager.
    """
    settings = get_settings()
    
    all_systems = [
        ("western", generate_western_theses),
        ("vedic", generate_vedic_theses),
        ("arabic", generate_arabic_theses),
        ("chinese", generate_chinese_theses),
        ("maya", generate_maya_theses),
        ("mesopotamian", generate_mesopotamian_theses),
    ]
    
    # Фильтрация по настройкам
    enabled_systems = []
    for name, func in all_systems:
        if settings.get(f"enable_{name}", True):
            enabled_systems.append((name, func))
        else:
            logger.info("system_disabled", system=name)
    
    if not enabled_systems:
        raise ValueError("All systems disabled in settings")
    
    all_theses = []
    failed_systems = []
    
    for system_name, generator_func in enabled_systems:
        try:
            theses = generator_func(static_core)
            if theses:
                all_theses.extend(theses)
                logger.info("system_generated", system=system_name, count=len(theses))
            else:
                logger.warning("system_empty", system=system_name)
        except Exception as e:
            logger.error("system_failed", system=system_name,
                        error=str(e), error_type=type(e).__name__)
            failed_systems.append(system_name)
    
    if not all_theses:
        raise ValueError(
            f"All enabled interpretation systems failed. "
            f"Failed: {failed_systems}. Check ephemeris data and system integrity."
        )
    
    if failed_systems:
        logger.warning("partial_failure", failed_systems=failed_systems)
    
    # Расчёт Confidence
    from confidence.astronomical import calculate_astronomical_confidence
    for thesis in all_theses:
        thesis.confidence = calculate_astronomical_confidence(thesis, static_core)
        thesis.time_horizon = TimeHorizon(decay="constant")
        thesis.days_to_peak = 0
        thesis.peak_date = None
    
    return all_theses
