```python
# core/coherence_calculator.py

class CoherenceCalculator:
    """
    Рассчитывает общую когерентность из всех сопоставлений.
    """
    
    # Веса для разных типов сопоставлений
    TYPE_WEIGHTS = {
        'house': 0.35,
        'dasha': 0.30,
        'retro': 0.15,
        'element': 0.10,
        'dynamic': 0.10,
    }
    
    async def calculate(
        self,
        house_alignments: List[Alignment],
        dasha_alignments: List[Alignment],
        retro_alignments: List[Alignment],
        element_alignments: List[Alignment],
        dynamic_alignments: Optional[List[Alignment]] = None
    ) -> 'CoherenceResult':
        """
        Агрегирует все scores в coherence_score.
        """
        all_alignments = {
            'house': house_alignments,
            'dasha': dasha_alignments,
            'retro': retro_alignments,
            'element': element_alignments,
            'dynamic': dynamic_alignments or [],
        }
        
        # 1. Считаем взвешенное среднее
        weighted_sum = 0
        total_weight = 0
        
        for type_name, alignments in all_alignments.items():
            if not alignments:
                continue
            
            weight = self.TYPE_WEIGHTS.get(type_name, 0.1)
            avg_score = sum(a.alignment_score for a in alignments) / len(alignments)
            
            weighted_sum += avg_score * weight
            total_weight += weight
        
        coherence_score = weighted_sum / total_weight if total_weight > 0 else 0.5
        
        # 2. Определяем уровень
        if coherence_score >= 0.7:
            coherence_level = 'high'
        elif coherence_score >= 0.4:
            coherence_level = 'medium'
        else:
            coherence_level = 'low'
        
        return CoherenceResult(
            coherence_score=round(coherence_score, 4),
            coherence_level=coherence_level,
            total_alignment_count=sum(len(a) for a in all_alignments.values())
        )
