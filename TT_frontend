## 6. Состояние и управление данными

### 6.1. Store для Alignment

```typescript
// store/alignmentStore.ts

import { create } from 'zustand';
import { AlignmentResponse, AlignmentHistoryResponse } from '../types/alignment';
import { PsychometryAPI } from '../api/psychometry';

interface AlignmentState {
  // Данные
  currentAlignment: AlignmentResponse | null;
  history: AlignmentHistoryResponse | null;

  // Состояние загрузки
  isLoading: boolean;
  isLoadingHistory: boolean;

  // Ошибки
  error: string | null;
  historyError: string | null;

  // Действия
  fetchAlignment: (userId: number, date?: string) => Promise<void>;
  fetchHistory: (userId: number, period: '7d' | '30d' | '90d' | '1y') => Promise<void>;
  clearErrors: () => void;
}

const api = new PsychometryAPI();

export const useAlignmentStore = create<AlignmentState>((set, get) => ({
  // Начальное состояние
  currentAlignment: null,
  history: null,
  isLoading: false,
  isLoadingHistory: false,
  error: null,
  historyError: null,

  // Действия
  fetchAlignment: async (userId: number, date?: string) => {
    set({ isLoading: true, error: null });
    try {
      const response = await api.getAlignment(userId, date);
      set({ currentAlignment: response, isLoading: false });
    } catch (error) {
      set({
        error: error instanceof Error ? error.message : 'Не удалось загрузить сопоставление',
        isLoading: false,
      });
    }
  },

  fetchHistory: async (userId: number, period: '7d' | '30d' | '90d' | '1y' = '90d') => {
    set({ isLoadingHistory: true, historyError: null });
    try {
      const response = await api.getAlignmentHistory(userId, period);
      set({ history: response, isLoadingHistory: false });
    } catch (error) {
      set({
        historyError: error instanceof Error ? error.message : 'Не удалось загрузить историю',
        isLoadingHistory: false,
      });
    }
  },

  clearErrors: () => {
    set({ error: null, historyError: null });
  },
}));
```

### 6.2. Кастомный хук

```typescript
// hooks/useAlignment.ts

import { useEffect } from 'react';
import { useAlignmentStore } from '../store/alignmentStore';
import { useUserStore } from '../store/userStore';

export const useAlignment = (date?: string) => {
  const {
    currentAlignment,
    isLoading,
    error,
    fetchAlignment,
    clearErrors,
  } = useAlignmentStore();

  const { userId } = useUserStore();

  useEffect(() => {
    if (userId) {
      fetchAlignment(userId, date);
    }
    return () => clearErrors();
  }, [userId, date]);

  return {
    alignment: currentAlignment,
    loading: isLoading,
    error,
    refetch: () => fetchAlignment(userId!, date),
  };
};

export const useAlignmentHistory = (period: '7d' | '30d' | '90d' | '1y' = '90d') => {
  const {
    history,
    isLoadingHistory,
    historyError,
    fetchHistory,
    clearErrors,
  } = useAlignmentStore();

  const { userId } = useUserStore();

  useEffect(() => {
    if (userId) {
      fetchHistory(userId, period);
    }
    return () => clearErrors();
  }, [userId, period]);

  return {
    history,
    loading: isLoadingHistory,
    error: historyError,
    refetch: () => fetchHistory(userId!, period),
  };
};
```

