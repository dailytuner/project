### 11.4. Health Checks

```python
@router.get("/health")
async def health_check():
    """Проверка состояния сервиса."""
    status = {
        "status": "healthy",
        "timestamp": datetime.now().isoformat(),
        "components": {}
    }
    
    # 1. Проверка БД
    try:
        await db_session.execute("SELECT 1")
        status["components"]["database"] = "healthy"
    except Exception as e:
        status["components"]["database"] = f"unhealthy: {e}"
        status["status"] = "unhealthy"
    
    # 2. Проверка Data Lake
    try:
        await lake_client.head_bucket()
        status["components"]["lake"] = "healthy"
    except Exception as e:
        status["components"]["lake"] = f"unhealthy: {e}"
        status["status"] = "unhealthy"
    
    # 3. Проверка Astro Service (если не fallback)
    if not settings.ASTRO_FALLBACK_MODE:
        try:
            await astro_client.health_check()
            status["components"]["astro"] = "healthy"
        except Exception as e:
            status["components"]["astro"] = f"unhealthy: {e}"
            status["status"] = "degraded"
    
    return status
```

