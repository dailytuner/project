def calculate_profile_v5(
    birth_data_dict: dict,
    current_date: Optional[str] = None,
    mode: str = "daily",
    horizon_days: int = 90
) -> dict:
    """
    Главный метод v5.1.
    
    Args:
        birth_data_dict: Данные рождения (словарь)
        current_date: Дата запроса (YYYY-MM-DD), default: сегодня
        mode: "portrait" или "daily"
        horizon_days: Горизонт прогноза в днях
    
    Returns:
        dict: Profile
    
    Raises:
        ValueError: Если статические тезисы пустые (системная ошибка)
        RuntimeError: Если Swiss Ephemeris вернул ошибку
    """
    from utils.time_module import get_current_utc
    from datetime import datetime
    
    # 1. Валидация через Pydantic
    try:
        birth_data = BirthData(**birth_data_dict)
    except Exception as e:
        raise ValueError(f"Invalid birth data: {e}")
    
    # 2. Определение даты
    if current_date is None:
        current_date = get_current_utc().strftime("%Y-%m-%d")
    date_obj = datetime.strptime(current_date, "%Y-%m-%d")
    
    user_id = birth_data.user_id
    
    # 3. Статическое ядро
    static_core = static_cache.get_or_calculate(
        user_id,
        lambda: calculate_static_core(birth_data),
        key_suffix="core"
    )
    
    # 4. Если портрет
    if mode == "portrait":
        static_theses = static_cache.get_or_calculate(
            user_id,
            lambda: generate_static_theses(static_core),
            key_suffix="theses"
        )
        static_integration = static_cache.get_or_calculate(
            user_id,
            lambda: integrate_static(static_theses),
            key_suffix="clusters"
        )
        return create_portrait_profile(static_integration, user_id)
    
    # 5. Динамическое ядро
    dynamic_core = dynamic_cache.get_or_calculate(
        user_id,
        current_date,
        lambda: calculate_dynamic_core(static_core, date_obj, horizon_days),
        ttl=7 * 24 * 3600,
        key_prefix="dynamic_core"
    )
    
    # 6. Статические тезисы
    static_theses = static_cache.get_or_calculate(
        user_id,
        lambda: generate_static_theses(static_core),
        key_suffix="theses"
    )
    
    # 7. Статическая интеграция
    static_integration = static_cache.get_or_calculate(
        user_id,
        lambda: integrate_static(static_theses),
        key_suffix="clusters"
    )
    
    # 8. Динамические тезисы
    dynamic_theses = generate_dynamic_theses(dynamic_core, static_core, date_obj)
    
    for thesis in dynamic_theses:
        thesis.confidence = calculate_temporal_confidence(
            thesis, static_core, dynamic_core, date_obj
        )
    
    # 9. Динамическая интеграция
    dynamic_signals = integrate_dynamic(
        dynamic_theses,
        static_integration,
        date_obj,
        horizon_days
    )
    
    # 10. Профиль
    profile = create_daily_profile(
        static_integration=static_integration,
        dynamic_signals=dynamic_signals,
        user_id=user_id,
        current_date=date_obj,
        horizon_days=horizon_days
    )
    
    # 11. Кеширование профиля
    dynamic_cache.set(
        f"daily:{user_id}:{current_date}",
        profile,
        ttl=24 * 3600
    )
    
    return profile
