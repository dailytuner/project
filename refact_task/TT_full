### 4.1. MMPI Core

```python
# src/core/mmpi_core.py

from typing import Dict, List, Optional
import numpy as np

class MMPICore:
    """
    Расчёт T-scores и K-коррекция для MMPI.
    """
    
    # K-коррекция: шкалы, которые корректируются
    K_CORRECTION = {
        '1': 0.5,   # Hypochondriasis
        '4': 0.4,   # Psychopathic deviate
        '7': 0.2,   # Psychasthenia
        '8': 0.2,   # Schizophrenia
        '9': 0.2,   # Hypomania
    }
    
    @classmethod
    def calculate_t_scores(
        cls,
        answers: Dict[str, bool],
        gender: str = 'female'
    ) -> Dict[str, float]:
        """
        Рассчитывает T-scores по сырым ответам.
        """
        # 1. Суммируем баллы по шкалам
        raw_scores = cls._sum_raw_scores(answers)
        
        # 2. Добавляем K-коррекцию
        corrected_scores = cls._apply_k_correction(raw_scores)
        
        # 3. Преобразуем в T-scores
        t_scores = {}
        for scale, raw_score in corrected_scores.items():
            t_scores[scale] = cls._raw_to_t(raw_score, scale, gender)
        
        return t_scores
    
    @classmethod
    def extract_key_metrics(cls, t_scores: Dict[str, float]) -> Dict[str, float]:
        """
        Извлекает ключевые метрики из T-scores.
        """
        return {
            'd_score': t_scores.get('2', 50),   # депрессия
            'pt_score': t_scores.get('7', 50),  # тревожность
            'pa_score': t_scores.get('6', 50),  # паранойя
            'ma_score': t_scores.get('9', 50),  # энергия
            'si_score': t_scores.get('0', 50),  # интроверсия
        }
    
    @classmethod
    def validate(cls, t_scores: Dict[str, float]) -> Dict:
        """
        Проверяет валидность ответов по шкалам L, F, K.
        """
        l = t_scores.get('L', 50)
        f = t_scores.get('F', 50)
        k = t_scores.get('K', 50)
        
        is_valid = (
            l <= 65 and  # не слишком высокая ложь
            f <= 70 and  # не слишком много необычных ответов
            k <= 65      # не слишком защитная позиция
        )
        
        return {
            'is_valid': is_valid,
            'l_score': l,
            'f_score': f,
            'k_score': k,
            'details': {
                'l': 'ok' if l <= 65 else 'high',
                'f': 'ok' if f <= 70 else 'high',
                'k': 'ok' if k <= 65 else 'high',
            }
        }
    
    @classmethod
    def _sum_raw_scores(cls, answers: Dict[str, bool]) -> Dict[str, float]:
        """Суммирует сырые баллы по ключам MMPI."""
        # Реализация MMPI-ключа (вопросы → шкалы)
        # В реальном проекте — загрузка из конфига или БД
        keys = {
            '1': ['q1', 'q2', 'q3', ...],  # Hypochondriasis
            '2': ['q5', 'q6', 'q7', ...],  # Depression
            # ...
        }
        raw = {}
        for scale, questions in keys.items():
            raw[scale] = sum(1 for q in questions if answers.get(q, False))
        return raw
    
    @classmethod
    def _apply_k_correction(cls, raw_scores: Dict[str, float]) -> Dict[str, float]:
        """Применяет K-коррекцию."""
        k = raw_scores.get('K', 0)
        corrected = raw_scores.copy()
        for scale, coefficient in cls.K_CORRECTION.items():
            if scale in corrected:
                corrected[scale] += coefficient * k
        return corrected
    
    @classmethod
    def _raw_to_t(cls, raw_score: float, scale: str, gender: str) -> float:
        """Преобразует сырой балл в T-score."""
        # Реализация через таблицы MMPI
        # В реальном проекте — загрузка из CSV
        # Упрощённо: T = 50 + 10 * (raw - mean) / std
        means = {
            'male': {'1': 8.5, '2': 19.2, '3': 22.4, ...},
            'female': {'1': 9.2, '2': 20.5, '3': 23.1, ...}
        }
        stds = {
            'male': {'1': 5.2, '2': 5.8, '3': 6.1, ...},
            'female': {'1': 5.4, '2': 6.0, '3': 6.3, ...}
        }
        
        mean = means.get(gender, {}).get(scale, 50)
        std = stds.get(gender, {}).get(scale, 10)
        
        if std == 0:
            return 50
        
        t = 50 + 10 * (raw_score - mean) / std
        return max(20, min(80, t))  # Ограничиваем
