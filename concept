def calculate_window(thesis_type, planet_speed=None, dasha_period=None):
    if thesis_type == "transit":
        if planet_speed > 0.5:
            return {"days": 3, "type": "high"}
        elif planet_speed > 0.1:
            return {"days": 14, "type": "medium"}
        else:
            return {"days": 90, "type": "low"}
    
    elif thesis_type == "dasha":
