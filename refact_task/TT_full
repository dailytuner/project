```python
# src/core/coherence_score.py

from typing import Dict, List, Optional
from uuid import UUID

class CoherenceScore:
    """
    Итоговая метрика когерентности профилей.
    """
    
    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}
        self.house_weight = self.config.get('house_weight', 0.35)
        self.dasha_weight = self.config.get('dasha_weight', 0.30)
        self.retro_weight = self.config.get('retro_weight', 0.20)
        self.resonance_weight = self.config.get('resonance_weight', 0.15)
        
        self.high_threshold = self.config.get('high_threshold', 0.7)
        self.medium_threshold = self.config.get('medium_threshold', 0.4)
    
    def calculate(
        self,
        house_alignments: List[Dict],
        dasha_alignments: List[Dict],
        retro_alignments: List[Dict],
        resonance: Dict
    ) -> Dict:
        """
        Рассчитывает итоговую когерентность.
        """
        # 1. Средние скоры по каждому типу
        house_score = self._average_score(house_alignments)
        dasha_score = self._average_score(dasha_alignments)
        retro_score = self._average_score(retro_alignments)
        resonance_value = resonance.get('value', 0.5)
        
        # 2. Взвешенная сумма
        coherence = (
            house_score * self.house_weight +
            dasha_score * self.dasha_weight +
            retro_score * self.retro_weight +
            resonance_value * self.resonance_weight
        )
        
        coherence = round(min(max(coherence, 0), 1), 3)
        
        # 3. Уровень
        if coherence >= self.high_threshold:
            level = 'HIGH'
            description = 'Ваш астрологический и психологический профили согласованы'
        elif coherence >= self.medium_threshold:
            level = 'MEDIUM'
            description = 'Ваши профили частично согласованы, есть зоны роста'
        else:
            level = 'LOW'
            description = 'Ваши профили расходятся — время для наблюдения'
        
        # 4. Диссонансы
        dissonances = self._find_dissonances(
            house_alignments,
            dasha_alignments,
            retro_alignments
        )
        
        return {
            'score': coherence,
            'level': level,
            'description': description,
            'components': {
                'house': round(house_score, 3),
                'dasha': round(dasha_score, 3),
                'retro': round(retro_score, 3),
                'resonance': round(resonance_value, 3)
            },
            'dissonances': dissonances
        }
    
    def _average_score(self, alignments: List[Dict]) -> float:
        """Вычисляет средний alignment_score."""
        if not alignments:
            return 0.5
        scores = [a.get('alignment_score', 0.5) for a in alignments]
        return sum(scores) / len(scores)
    
    def _find_dissonances(
        self,
        house_alignments: List[Dict],
        dasha_alignments: List[Dict],
        retro_alignments: List[Dict]
    ) -> List[Dict]:
        """
        Находит диссонансы (расхождения) в сопоставлениях.
        """
        dissonances = []
        
        # Диссонансы в домах
        for ha in house_alignments:
            if ha.get('alignment_score', 0.5) < 0.3:
                dissonances.append({
                    'type': 'house',
                    'source': f"{ha.get('type')}_house_{ha.get('house')}",
                    'description': ha.get('interpretation', ''),
                    'severity': 1 - ha.get('alignment_score', 0.5)
                })
        
        # Диссонансы в дашах
        for da in dasha_alignments:
            if da.get('alignment_score', 0.5) < 0.3:
                dissonances.append({
                    'type': 'dasha',
                    'source': f"dasha_{da.get('planet')}",
                    'description': da.get('interpretation', ''),
                    'severity': 1 - da.get('alignment_score', 0.5)
                })
        
        return dissonances
