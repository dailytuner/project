# services/alignment_service.py

class AlignmentService:
    """
    Оркестрирует весь процесс сопоставления профилей.
    """
    
    def __init__(
        self,
        astro_builder: AstroProfileBuilder,
        psych_builder: PsychProfileBuilder,
        house_aligner: HouseAligner,
        dasha_aligner: DashaAligner,
        retro_aligner: RetroAligner,
        element_aligner: ElementAligner,
        dynamic_aligner: DynamicAligner,
        coherence_calculator: CoherenceCalculator,
        dissonance_analyzer: DissonanceAnalyzer,
        template_renderer: TemplateRenderer
    ):
        self.astro_builder = astro_builder
        self.psych_builder = psych_builder
        self.house_aligner = house_aligner
        self.dasha_aligner = dasha_aligner
        self.retro_aligner = retro_aligner
        self.element_aligner = element_aligner
        self.dynamic_aligner = dynamic_aligner
        self.coherence_calculator = coherence_calculator
        self.dissonance_analyzer = dissonance_analyzer
        self.template_renderer = template_renderer
    
    async def calculate_alignment(
        self,
        user_id: int,
        date: date,
        previous_astro: Optional[AstroProfile] = None,
        previous_psych: Optional[PsychProfile] = None
    ) -> AlignmentResult:
        """
        Полный цикл сопоставления профилей.
        """
        # 1. Строим профили
        astro = await self.astro_builder.build_profile(user_id, date)
        psych = await self.psych_builder.build_profile(user_id, date)
        
        # 2. Загружаем базу знаний
        knowledge_base = await self._load_knowledge_base()
        
        # 3. Сопоставляем по всем типам
        house_alignments = await self.house_aligner.align(astro, psych, knowledge_base)
        dasha_alignments = await self.dasha_aligner.align(astro, psych, knowledge_base)
        retro_alignments = await self.retro_aligner.align(astro, psych, knowledge_base)
        element_alignments = await self.element_aligner.align(astro, psych, knowledge_base)
        
        dynamic_alignments = None
        if previous_astro and previous_psych:
            dynamic_alignments = await self.dynamic_aligner.align(
                previous_astro, astro,
                previous_psych, psych,
                knowledge_base
            )
        
        # 4. Рассчитываем coherence
        coherence = await self.coherence_calculator.calculate(
            house_alignments,
            dasha_alignments,
            retro_alignments,
            element_alignments,
            dynamic_alignments
        )
        
        # 5. Анализируем диссонансы
        all_alignments = (
            house_alignments + dasha_alignments + retro_alignments + element_alignments
        )
        dissonances = await self.dissonance_analyzer.analyze(all_alignments)
        
        # 6. Генерируем объяснения
        recommendations = self.template_renderer.render_all(
            coherence.coherence_level,
            house_alignments,
            dasha_alignments,
            retro_alignments,
            element_alignments,
            dissonances
        )
        
        # 7. Формируем результат
        return AlignmentResult(
            user_id=user_id,
            date=date,
            coherence_score=coherence.coherence_score,
            coherence_level=coherence.coherence_level,
            house_alignments=house_alignments,
            dasha_alignments=dasha_alignments,
            retro_alignments=retro_alignments,
            element_alignments=element_alignments,
            dynamic_alignments=dynamic_alignments,
            dissonances=dissonances,
            recommendations=recommendations
        )
    
    async def _load_knowledge_base(self) -> List[KnowledgeBaseEntry]:
        """Загружает базу знаний из БД."""
        async with async_session() as session:
            stmt = select(KnowledgeBaseEntry).where(
                KnowledgeBaseEntry.status == 'active'
            )
            result = await session.execute(stmt)
            return result.scalars().all()
