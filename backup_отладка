## 🛠️ ИСПРАВЛЕННЫЙ backup-db.sh:

```bash
#!/bin/sh
set -e

DATE=$(date +%Y%m%d)
BACKUP_DIR=/backups
PGHOST=postgres
PGUSER=postgres
PGPASSWORD=$(cat /run/secrets/postgrespassword 2>/dev/null || echo "")
export PGPASSWORD

echo "🔄 Starting backup at $(date)"

# Проверка подключения
if ! pg_isready -h $PGHOST -U $PGUSER; then
    echo "❌ Cannot connect to PostgreSQL"
    exit 1
fi

# Полный бэкап
pg_dumpall -h $PGHOST -U $PGUSER --clean --if-exists | gzip > ${BACKUP_DIR}/full-backup-${DATE}.sql.gz

# Бэкап только personalassistant
pg_dump -h $PGHOST -U $PGUSER personalassistant | gzip > ${BACKUP_DIR}/personalassistant-${DATE}.sql.gz

# Проверка размера
SIZE=$(ls -lh ${BACKUP_DIR}/personalassistant-${DATE}.sql.gz | awk '{print $5}')
echo "✅ Backup completed: ${SIZE}"

# Удалить старше 7 дней
find ${BACKUP_DIR} -name "*.sql.gz" -mtime +7 -delete

# Уведомление в лог
echo "✅ Backup ${DATE} completed at $(date)"
```

## 📝 ИСПРАВЛЕННЫЙ docker-compose.yml (фрагмент):

```yaml
cron-backup:
  image: postgres:15-alpine
  container_name: pa-backup
  command: >
    sh -c "
      echo '0 3 * * * /backup.sh' > /etc/crontabs/root &&
      crond -f
    "
  volumes:
    - ./scripts/backup-db.sh:/backup.sh:ro
    - ./backups:/backups
    - ./docker-secrets:/run/secrets:ro  # ← ДОБАВИТЬ для доступа
  environment:
    - PGPASSWORD_FILE=/run/secrets/postgrespassword
  secrets:
    - postgrespassword
  networks:
    - pa-net  # ← ДОБАВИТЬ
  depends_on:
    postgres:
      condition: service_healthy
  restart: unless-stopped
  deploy:
    resources:
      limits:
        cpus: '0.2'
        memory: 128M
```

## 🧪 ТЕСТОВЫЙ СКРИПТ ДЛЯ ОТЛАДКИ:

```bash
#!/bin/bash
# test-backup.sh

echo "🧪 Testing backup setup..."

# 1. Проверяем доступ к секрету
echo "1. Checking secret access..."
docker exec pa-backup cat /run/secrets/postgrespassword > /dev/null 2>&1
if [ $? -eq 0 ]; then
    echo "✅ Secret accessible"
else
    echo "❌ Secret NOT accessible"
    exit 1
fi

# 2. Проверяем подключение к БД
echo "2. Testing DB connection..."
docker exec pa-backup pg_isready -h postgres -U postgres
if [ $? -eq 0 ]; then
    echo "✅ DB connection OK"
else
    echo "❌ DB connection FAILED"
    exit 1
fi

# 3. Ручной запуск бэкапа
echo "3. Running manual backup..."
docker exec pa-backup /backup.sh

# 4. Проверяем создание файла
echo "4. Checking backup files..."
docker exec pa-backup ls -lh /backups/*.sql.gz | tail -3

echo "✅ All tests passed!"
```

