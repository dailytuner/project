### 9.2. Протокол "Пустого профиля" (Фоновый режим)

```python
def generate_empty_profile(theses):
    """
    Режим при отсутствии пересечений
    """
    # Шаг 1: Проверка слабого пересечения (≥2 систем в одной сфере)
    clusters = cluster_theses(theses)  # БЕЗ нормализации
    weak_overlaps = []
    
    for cluster in clusters:
        if len(cluster) >= 2:
            weak_overlaps.append({
                "spheres": get_sphere_names(cluster[0]["sphere_vector"]),
                "sources": [t["system"] for t in cluster],
                "strength": sum(t["confidence_final"]["value"] for t in cluster) / len(cluster)
            })
    
    if weak_overlaps:
        return {
            "type": "weak_overlap",
            "intersections": weak_overlaps,
            "message": "Слабое пересечение, требуются уточнения"
        }
    
    # Шаг 2: Один самый сильный тезис
    best_thesis = max(theses, key=lambda t: t["confidence_final"]["value"])
    
    return {
        "type": "single_signal",
        "thesis": best_thesis,
        "message": f"Единичный сигнал: {best_thesis['claim']} (уверенность {best_thesis['confidence_final']['value']:.2f})"
    }
