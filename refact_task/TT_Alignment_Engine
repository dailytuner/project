        level = 'высокий' if psych_value > 60 else 'средний' if psych_value > 40 else 'низкий'
        
        if expected == 'increasing' and psych_value > 60:
            return f"{planet.capitalize()} в {house}-м доме соответствует вашей высокой {trait}"
        elif expected == 'decreasing' and psych_value < 40:
