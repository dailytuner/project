from typing import Dict, List
import re

class AwarenessRecognizer:
    """
    Распознавание уровня осознанности на основе ответов MMPI.
    """
    
    # Маркеры осознанности (Правда-факты)
    AWARENESS_MARKERS = [
        r'я (чувствую|ощущаю) (в|внутри)',
        r'(сейчас|прямо сейчас)',
        r'я заметил(а)?',
        r'это (происходит|случилось)',
        r'моё тело',
        r'я дышу',
    ]
    
    @classmethod
    def recognize(cls, answers: Dict[str, bool], t_scores: Dict[str, float]) -> Dict:
        """
        Определяет уровень осознанности.
        """
        # 1. Извлекаем текстовые ответы (если есть)
        text_responses = cls._extract_text_responses(answers)
        
        # 2. Считаем маркеры осознанности
        awareness_count = 0
        for text in text_responses:
            for marker in cls.AWARENESS_MARKERS:
                if re.search(marker, text, re.IGNORECASE):
                    awareness_count += 1
                    break
        
        # 3. Корректируем на основе MMPI
        # Шкала 0 (интроверсия) — чем выше, тем больше осознанности
        # Шкала 3 (истерия) — чем выше, тем меньше осознанности
        si = t_scores.get('0', 50)
        hy = t_scores.get('3', 50)
        
        awareness_score = (si - hy + 100) / 200  # 0-1
        
        # 4. Финальный уровень
        if awareness_count >= 3 or awareness_score > 0.7:
            level = 'HIGH'
            tip = "Вы хорошо различаете свои чувства и потребности"
            practice = "Продолжайте наблюдать за телом в течение дня"
        elif awareness_count >= 1 or awareness_score > 0.4:
            level = 'MEDIUM'
            tip = "Вам помогает практика наблюдения за телом"
            practice = "5 минут дыхания утром и вечером"
        else:
            level = 'LOW'
            tip = "Начните с простого: 5 минут дыхания утром"
            practice = "Упражнение 'Здесь и сейчас': называйте, что видите"
        
        return {
            'level': level,
            'tip': tip,
            'practice': practice,
            'score': awareness_score,
            'markers_found': awareness_count
        }
    
    @classmethod
    def _extract_text_responses(cls, answers: Dict[str, bool]) -> List[str]:
        """Извлекает текстовые ответы (комментарии)."""
        # В стандартном MMPI комментариев нет, но могут быть в вашей реализации
        return answers.get('comments', [])
