            params={"user_id": user_id, "date": target_date.isoformat()},
            headers={"X-Internal-API-Key": self.api_key}
        )
        response.raise_for_status()
        return response.json()
    
    def get_seasonal_boosts(self, target_date: date) -> Dict:
