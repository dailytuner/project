### 3.2. Index Calibrator

```python
# src/core/index_calibrator.py

from typing import Dict, List, Optional
from datetime import datetime
from uuid import UUID
import numpy as np
from scipy.optimize import minimize

class IndexCalibrator:
    """
    Калибровка весов индексов достижения на основе обратной связи.
    """
    
    # Компоненты индекса
    COMPONENTS = ['clarity', 'synchronicity', 'resource', 'inertia']
    
    async def calibrate(
        self,
        category_id: str,
        version: str = 'v1.0'
    ) -> Dict:
        """
        Калибрует веса для указанной категории.
        """
        # 1. Получаем исторические данные
        data = await self._get_historical_data(category_id)
        
        if len(data) < 30:
            return {
                'status': 'insufficient_data',
                'n_observations': len(data)
            }
        
        # 2. Оптимизируем веса
        optimal_weights = self._optimize_weights(data)
        
        # 3. Вычисляем метрики качества
        validation_score = self._validate(optimal_weights, data)
        
        # 4. Сохраняем калибровку
        calibration_id = await self._save_calibration(
            category_id=category_id,
            version=version,
            weights=optimal_weights,
            validation_score=validation_score,
            n_observations=len(data)
        )
        
        return {
            'calibration_id': calibration_id,
            'weights': optimal_weights,
            'validation_score': validation_score,
            'n_observations': len(data)
        }
    
    def _optimize_weights(self, data: List[Dict]) -> Dict:
        """
        Оптимизирует веса для максимальной точности.
        """
        # Целевая функция: минимизация ошибки
        def objective(weights):
            total_error = 0
            for record in data:
                predicted = (
                    record['clarity'] * weights[0] +
                    record['synchronicity'] * weights[1] +
                    record['resource'] * weights[2] -
                    record['inertia'] * weights[3]
                )
                predicted = max(0, min(1, predicted))
                actual = record['actual_outcome']
                total_error += (predicted - actual) ** 2
            return total_error / len(data)
        
        # Начальные значения (текущие веса)
        initial_weights = [0.3, 0.3, 0.3, 0.1]
        
        # Ограничения: сумма = 1, все >= 0
        constraints = [
            {'type': 'eq', 'fun': lambda w: sum(w) - 1},
            {'type': 'ineq', 'fun': lambda w: w}  # все >= 0
        ]
        
        # Оптимизация
        result = minimize(
            objective,
            initial_weights,
            method='SLSQP',
            constraints=constraints
        )
        
        if result.success:
            return {
                'clarity': round(float(result.x[0]), 3),
                'synchronicity': round(float(result.x[1]), 3),
                'resource': round(float(result.x[2]), 3),
                'inertia': round(float(result.x[3]), 3)
            }
        else:
            # Fallback: текущие веса
            return {
                'clarity': 0.3,
                'synchronicity': 0.3,
                'resource': 0.3,
                'inertia': 0.1
            }
    
    def _validate(
        self,
        weights: Dict,
        data: List[Dict]
    ) -> float:
        """
        Валидирует веса на исторических данных.
        """
        predictions = []
        actuals = []
        
        for record in data:
            predicted = (
                record['clarity'] * weights['clarity'] +
                record['synchronicity'] * weights['synchronicity'] +
                record['resource'] * weights['resource'] -
                record['inertia'] * weights['inertia']
            )
            predicted = max(0, min(1, predicted))
            predictions.append(predicted)
            actuals.append(record['actual_outcome'])
        
        # R^2 (коэффициент детерминации)
        predictions = np.array(predictions)
        actuals = np.array(actuals)
        
        ss_res = np.sum((predictions - actuals) ** 2)
        ss_tot = np.sum((actuals - np.mean(actuals)) ** 2)
        
        r2 = 1 - (ss_res / ss_tot) if ss_tot > 0 else 0
        return max(0, min(1, r2))
