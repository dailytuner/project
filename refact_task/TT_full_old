# infrastructure/scheduler.py

class Scheduler:
    """
    Планировщик заданий для Analytics Worker.
    """
    
    def __init__(self, analytics_service: AnalyticsService):
        self.analytics_service = analytics_service
        self.scheduler = AsyncIOScheduler()
    
    def setup(self):
        """Настраивает расписание."""
        # Еженедельно: понедельник, 04:00
        self.scheduler.add_job(
            self.analytics_service.run_weekly,
            'cron',
            day_of_week=0,
            hour=4,
            minute=0,
            id='weekly_job',
            replace_existing=True
        )
        
        # Ежемесячно: 1-е число, 05:00
        self.scheduler.add_job(
            self.analytics_service.run_monthly,
            'cron',
            day=1,
            hour=5,
            minute=0,
            id='monthly_job',
            replace_existing=True
        )
        
        # Ежеквартально: 1-е число квартала, 06:00
        self.scheduler.add_job(
            self.analytics_service.run_quarterly,
            'cron',
            day=1,
            hour=6,
            minute=0,
            month='1,4,7,10',
            id='quarterly_job',
            replace_existing=True
        )
    
    async def start(self):
        """Запускает планировщик."""
        self.setup()
        self.scheduler.start()
        logger.info("Analytics Worker scheduler started")
        
        while True:
            await asyncio.sleep(60)
