            time_horizon=TimeHorizon(decay="constant"),
            days_to_peak=0,
            peak_date=None,
            metadata={
                "part_name": name,
                "longitude": longitude,
                "sign": sign,
                "house": house
            }
        )
        theses.append(thesis)
    
    return theses
