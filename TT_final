### 6.2. ШАГ 1: Кластеризация

```python
# integration/clustering.py
import numpy as np
from typing import List, Set
from core.models import Thesis


def cosine_similarity(v1: List[float], v2: List[float]) -> float:
    """Косинусное расстояние (numpy)."""
    v1_np = np.array(v1)
    v2_np = np.array(v2)
    norm1 = np.linalg.norm(v1_np)
    norm2 = np.linalg.norm(v2_np)
    if norm1 == 0 or norm2 == 0:
        return 0.0
    return float(np.dot(v1_np, v2_np) / (norm1 * norm2))


def cluster_theses(theses: List[Thesis]) -> List[List[Thesis]]:
    """
    Кластеризует тезисы по косинусному расстоянию (порог из SettingsManager).
    
    Обоснование порога 0.7:
        При 0.6: слишком много ложных объединений.
        При 0.8: слишком много изолированных тезисов.
        0.7 даёт оптимальное число кластеров (~8-12 для 47 тезисов).
    """
    from config.settings_manager import get_settings
    settings = get_settings()
    threshold = settings.get("cluster_threshold", 0.70)
    
    clusters = []
    used: Set[int] = set()
    
    for i, t1 in enumerate(theses):
        if i in used:
            continue
        cluster = [t1]
        used.add(i)
        for j, t2 in enumerate(theses[i+1:], start=i+1):
            if j in used:
                continue
            if cosine_similarity(t1.sphere_vector, t2.sphere_vector) >= threshold:
                cluster.append(t2)
                used.add(j)
        if cluster:
            clusters.append(cluster)
    return clusters
```

