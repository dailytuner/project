async def _update_test_status(
    self,
    user_id: int,
    test_type: str,
    session: AsyncSession
):
    """
    Обновляет test_status_cache после прохождения теста.
    """
    cache = await session.get(TestStatusCache, user_id)
    if not cache:
        cache = TestStatusCache(user_id=user_id)
        session.add(cache)
    
    if test_type == 'mmpi':
        cache.has_pending_mmpi = False
        cache.next_mmpi_due = date.today() + timedelta(days=90)
    elif test_type == 'iat':
        cache.has_pending_iat = False
        cache.next_iat_due = date.today() + timedelta(days=30)
    
    cache.updated_at = datetime.now()
    await session.commit()
    
    # Инвалидируем alignment_cache
    await alignment_cache.invalidate(user_id)
