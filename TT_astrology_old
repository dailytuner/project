# scripts/backfill_alignment_cache.py

async def backfill_alignment_cache():
    """
    Заполняет alignment_cache для существующих пользователей.
    Запускается после рефакторинга.
    """
    async with async_session() as session:
        # 1. Находим всех пользователей с прогнозами
        stmt = select(ForecastV2.user_id).distinct()
        result = await session.execute(stmt)
        users = result.scalars().all()
        
        for user_id in users:
            # 2. Для каждого пользователя рассчитываем профиль
            profile = await astro_profile_service.build_profile(
                user_id=user_id,
                date=date.today(),
                session=session
            )
            
            # 3. Сохраняем в кэш
            await alignment_cache.set(user_id, date.today(), profile)
            
            # 4. Пауза (не перегружать)
            await asyncio.sleep(0.1)
        
        logger.info(f"Backfilled {len(users)} users")
